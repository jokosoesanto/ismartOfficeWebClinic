@model Clinic.Application.DTOs.Operations.AppointmentDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Appointment Details</h2>
            <p class="text-muted mb-0">View appointment information.</p>
        </div>
        <a href="/Appointment" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Appointment Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Status</label>
                            <div>
                                @if(Model.Status == Clinic.Domain.Enums.AppointmentStatus.Schedule)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill">@Model.Status</span>
                                }
                                else if(Model.Status == Clinic.Domain.Enums.AppointmentStatus.OnTime)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">@Model.Status</span>
                                }
                                else if(Model.Status == Clinic.Domain.Enums.AppointmentStatus.Late)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill">@Model.Status</span>
                                }
                                else if(Model.Status == Clinic.Domain.Enums.AppointmentStatus.Failed || Model.Status == Clinic.Domain.Enums.AppointmentStatus.Reschedule)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill">@Model.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">@Model.Status</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6"></div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Date</label>
                            <div class="fw-semibold">@Model.Date.ToString("dd MMMM yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Time</label>
                            <div class="fw-semibold text-primary">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Patient</label>
                            <div class="fw-semibold">@Model.PatientName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Doctor</label>
                            <div class="fw-semibold">@Model.DoctorName</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Location</label>
                            <div class="fw-semibold">@Model.LocationName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Chair</label>
                            <div class="fw-semibold">@Model.ChairName</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small mb-1">Notes / Remarks</label>
                            <div class="bg-light p-3 rounded border">
                                @if (string.IsNullOrWhiteSpace(Model.Notes))
                                {
                                    <span class="text-muted fst-italic">No notes provided.</span>
                                }
                                else
                                {
                                    @Model.Notes
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
