@model IEnumerable<Clinic.Application.DTOs.Operations.AppointmentDto>
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Appointment Management</h2>
            <p class="text-muted mb-0">Manage clinic appointments.</p>
        </div>
        <a href="/Appointment/Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Create Appointment
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle enterprise-grid" id="appointmentsTable"
                       data-order="[[1, &quot;desc&quot;], [2, &quot;asc&quot;]]"
                       data-page-length="10"
                       data-search-placeholder="Search appointments...">
                    <thead class="table-light">
                        <tr>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Location / Chair</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    @if(appt.Status == Clinic.Domain.Enums.AppointmentStatus.Schedule)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 rounded-pill">@appt.Status</span>
                                    }
                                    else if(appt.Status == Clinic.Domain.Enums.AppointmentStatus.OnTime)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">@appt.Status</span>
                                    }
                                    else if(appt.Status == Clinic.Domain.Enums.AppointmentStatus.Late)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 rounded-pill">@appt.Status</span>
                                    }
                                    else if(appt.Status == Clinic.Domain.Enums.AppointmentStatus.Failed || appt.Status == Clinic.Domain.Enums.AppointmentStatus.Reschedule)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill">@appt.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1 rounded-pill">@appt.Status</span>
                                    }
                                </td>
                                <td><span class="fw-semibold">@appt.Date.ToString("dd MMM yyyy")</span></td>
                                <td>
                                    <div class="fw-semibold text-primary">@appt.StartTime.ToString(@"hh\:mm") - @appt.EndTime.ToString(@"hh\:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@appt.PatientName</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@appt.DoctorName</div>
                                </td>
                                <td>
                                    <div>@appt.LocationName</div>
                                    <div class="small text-muted"><i class="bi bi-display me-1"></i>@appt.ChairName</div>
                                </td>
                                <td class="text-end">
                                    <a href="/Appointment/Details/@appt.Id" class="btn btn-sm btn-outline-secondary shadow-sm" title="View Details">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger shadow-sm ms-1" onclick="cancelAppointment('@appt.Id', '@appt.PatientName', '@appt.Date.ToString("dd MMM yyyy")')" title="Cancel Appointment">
                                        <i class="bi bi-x-circle"></i> Cancel
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<form id="cancelForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script>
    function cancelAppointment(id, patientName, date) {
        if(confirm('Are you sure you want to cancel the appointment for ' + patientName + ' on ' + date + '?')) {
            var form = document.getElementById('cancelForm');
            form.action = '/Appointment/Delete/' + id;
            form.submit();
        }
    }
</script>
