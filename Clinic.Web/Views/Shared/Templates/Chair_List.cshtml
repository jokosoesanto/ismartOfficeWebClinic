@model IEnumerable<Clinic.Application.DTOs.MasterData.ChairDto>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@meta?.Title</h2>
        <div class="d-flex align-items-center gap-2">
            <a asp-permission="Chair.Create" href="/Chair/Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Chair</a>
            <a href="?" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</a>
        </div>
    </div>

    <div class="row g-4 h-100">
        <!-- Data Grid -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Registered @meta?.Title</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle enterprise-grid" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Location</th>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="fw-semibold">@item.Code</span></td>
                                        <td>@item.LocationName</td>
                                        <td>@item.Name</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-permission="Chair.Edit" href="/Chair/Edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                                <form asp-controller="Chair" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this chair?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" @(!User.HasClaim("Permission", "Chair.Delete") ? "disabled" : "")><i class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
