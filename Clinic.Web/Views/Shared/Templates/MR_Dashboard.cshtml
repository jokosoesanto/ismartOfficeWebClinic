@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Medical Record Dashboard Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Medical Record Dashboard</h2>
        <div>
            <a href="/Appointment" class="btn btn-outline-primary shadow-sm"><i class="bi bi-calendar me-1"></i> Appointments</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-people me-2"></i>Patient Records</h5>
            
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 bg-light" placeholder="Search by name, MRN...">
                <button class="btn btn-primary"><i class="bi bi-funnel"></i></button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>MRN</th>
                            <th>Patient Name</th>
                            <th>DOB / Age</th>
                            <th>Last Visit</th>
                            <th>Last Doctor</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold text-primary">MR-2601001</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">JS</div>
                                    <span class="fw-bold">John Smith</span>
                                </div>
                            </td>
                            <td>12 May 1990 (36y)</td>
                            <td>31 Jul 2026</td>
                            <td>Dr. Emily Chen</td>
                            <td class="text-center"><span class="badge bg-success">Active</span></td>
                            <td class="text-end">
                                <a href="/MedicalRecord/Chart/1" class="btn btn-sm btn-primary"><i class="bi bi-folder2-open me-1"></i> View Chart</a>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-primary">MR-2601015</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-info text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">JS</div>
                                    <span class="fw-bold">Jane Smith</span>
                                </div>
                            </td>
                            <td>22 Aug 1992 (33y)</td>
                            <td>25 Jul 2026</td>
                            <td>Dr. Alan</td>
                            <td class="text-center"><span class="badge bg-secondary">Archived</span></td>
                            <td class="text-end">
                                <a href="/MedicalRecord/Chart/2" class="btn btn-sm btn-primary"><i class="bi bi-folder2-open me-1"></i> View Chart</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <!-- Empty State Placeholder (hidden) -->
            <div id="emptyState" class="d-none text-center p-5 text-muted">
                <i class="bi bi-search display-1 mb-3 d-block text-secondary"></i>
                <h4 class="fw-bold">No Records Found</h4>
                <p>Try adjusting your search criteria or filter.</p>
            </div>
            
        </div>
    </div>
</div>
