@model IEnumerable<Clinic.Domain.Entities.MasterData.Patient>
@{
    var metadata = ViewBag.Metadata as Clinic.Application.UI.UIMetadata;
}

<!-- Medical Record Dashboard Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Medical Record Dashboard</h2>
        <div>
            <a href="/Appointment" class="btn btn-outline-primary shadow-sm"><i class="bi bi-calendar me-1"></i> Appointments</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-people me-2"></i>Patient Records</h5>
            
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 bg-light" placeholder="Search by name, MRN...">
                <button class="btn btn-primary"><i class="bi bi-funnel"></i></button>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>MRN</th>
                                <th>Patient Name</th>
                                <th>DOB / Age</th>
                                <th>Last Visit</th>
                                <th>Last Doctor</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                var initials = "";
                                if (!string.IsNullOrWhiteSpace(patient.FullName))
                                {
                                    var parts = patient.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                    initials = string.Join("", parts.Take(2).Select(s => s[0])).ToUpper();
                                }
                                
                                var ageStr = "-";
                                if (patient.BirthDate.HasValue)
                                {
                                    var today = DateTime.Today;
                                    var age = today.Year - patient.BirthDate.Value.Year;
                                    if (patient.BirthDate.Value.Date > today.AddYears(-age)) age--;
                                    ageStr = $"{patient.BirthDate.Value:dd MMM yyyy} ({age}y)";
                                }

                                var badgeClass = patient.IsDeleted ? "bg-secondary" : "bg-success";
                                var statusText = patient.IsDeleted ? "Archived" : (patient.Status ?? "Active");

                                <tr>
                                    <td class="fw-bold text-primary">@patient.MRN</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">@initials</div>
                                            <span class="fw-bold">@patient.FullName</span>
                                        </div>
                                    </td>
                                    <td>@ageStr</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td class="text-center"><span class="badge @badgeClass">@statusText</span></td>
                                    <td class="text-end">
                                        <a href="/MedicalRecord/Chart/@patient.Id" class="btn btn-sm btn-primary"><i class="bi bi-folder2-open me-1"></i> View Chart</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div id="emptyState" class="text-center p-5 text-muted">
                    <i class="bi bi-search display-1 mb-3 d-block text-secondary"></i>
                    <h4 class="fw-bold">No Records Found</h4>
                    <p>Try adjusting your search criteria or filter.</p>
                </div>
            }
        </div>
    </div>
</div>
