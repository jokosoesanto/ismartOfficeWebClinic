@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Medical Record History Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/MedicalRecord" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Chart</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">JS</div>
                <h5 class="fw-bold text-muted mb-0">John Smith (PT-2601001)</h5>
            </div>
            <button class="btn btn-sm btn-outline-primary"><i class="bi bi-printer me-1"></i> Print History</button>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Tooth</th>
                            <th>Surface</th>
                            <th>Treatment</th>
                            <th>Provider</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>31/07/2026</td>
                            <td class="fw-bold">14</td>
                            <td>MOD</td>
                            <td>Root Canal Treatment</td>
                            <td>Dr. Emily Chen</td>
                            <td><span class="badge bg-success">Completed</span></td>
                            <td class="text-center">
                                <a href="/MedicalRecord/1" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td>15/06/2026</td>
                            <td class="fw-bold">-</td>
                            <td>-</td>
                            <td>Comprehensive Exam</td>
                            <td>Dr. Alan</td>
                            <td><span class="badge bg-success">Completed</span></td>
                            <td class="text-center">
                                <a href="/MedicalRecord/2" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
