@using Clinic.Application.DTOs.Operations
@model List<InventoryExpiryMonitoringDto>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 fw-bold">Expiry & Near-Expiry Monitoring</h2>
            <p class="text-muted mb-0">Monitor batch expirations based on configuration threshold (Near Expiry &lt;= @ViewBag.Threshold days).</p>
        </div>
        <div>
            <a href="/Inventory" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i> Back to Inventory</a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" action="/Inventory/ExpiryMonitoring" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-muted small fw-bold">Status Filter</label>
                    <select class="form-select" name="statusFilter">
                        <option value="All" selected="@(ViewBag.StatusFilter == "All" || string.IsNullOrEmpty(ViewBag.StatusFilter))">All</option>
                        <option value="Expired" selected="@(ViewBag.StatusFilter == "Expired")">Expired</option>
                        <option value="Near Expiry" selected="@(ViewBag.StatusFilter == "Near Expiry")">Near Expiry</option>
                        <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                        <option value="No Expiry" selected="@(ViewBag.StatusFilter == "No Expiry")">No Expiry</option>
                    </select>
                </div>
                <div class="col-md-8 d-flex align-items-end">
                    <a href="/Inventory/ExpiryMonitoring" class="btn btn-light me-2">Clear Filter</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- List Section -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Item</th>
                            <th>Batch Number</th>
                            <th>Expiry Date</th>
                            <th>Days to Expiry</th>
                            <th class="text-end">Current Stock</th>
                            <th class="pe-4 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">No batches found matching the criteria.</td>
                            </tr>
                        }
                        @foreach (var batch in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@batch.ItemCode</div>
                                    <div class="small text-muted">@batch.ItemName</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@batch.BatchNumber</span></td>
                                <td>
                                    @(batch.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")
                                </td>
                                <td>
                                    @if(batch.DaysToExpiry.HasValue)
                                    {
                                        <span class="@(batch.DaysToExpiry < 0 ? "text-danger fw-bold" : batch.DaysToExpiry <= ViewBag.Threshold ? "text-warning fw-bold" : "text-success")">
                                            @Math.Abs(batch.DaysToExpiry.Value) @(batch.DaysToExpiry < 0 ? "days ago" : "days")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end fw-bold">@batch.CurrentStock.ToString("N0")</td>
                                <td class="pe-4 text-center">
                                    @if (batch.ExpiryStatus == "Expired")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Expired</span>
                                    }
                                    else if (batch.ExpiryStatus == "Near Expiry")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Near Expiry</span>
                                    }
                                    else if (batch.ExpiryStatus == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">No Expiry</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
