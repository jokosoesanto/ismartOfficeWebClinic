@model Clinic.Application.DTOs.MasterData.SpecialtyDto
@{
    var isNew = Model.Id == null || Model.Id == Guid.Empty;
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@meta.Title</h2>
        <a href="/Specialty" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Specialties</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-award me-2"></i>Specialty Details</h5>
        </div>
        <div class="card-body p-4">
            <form method="post" action="/Specialty/@(isNew ? "Create" : "Edit/" + Model.Id)" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                @if (!isNew)
                {
                    <input type="hidden" name="Id" value="@Model.Id" />
                }
                
                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">General Information</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Code" required value="@Model.Code">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Name" required value="@Model.Name">
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea class="form-control" name="Description" rows="2">@Model.Description</textarea>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <label class="form-check-label fw-bold" for="IsActive">Is Active</label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a href="/Specialty" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Specialty</button>
                </div>
            </form>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var forms = document.querySelectorAll('.needs-validation');
                    Array.prototype.slice.call(forms).forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                });
            </script>
        </div>
    </div>
</div>
