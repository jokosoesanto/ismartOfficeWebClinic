@model IEnumerable<Clinic.Domain.Entities.MasterData.Specialty>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@meta.Title</h2>
        <div class="d-flex align-items-center gap-2">
            <a asp-permission="Specialty.Create" href="/Specialty/Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Specialty</a>
            <a href="?" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</a>
        </div>
    </div>

    <div class="row g-4 h-100">
        <!-- Settings Menu -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">System Setup</h6>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush border rounded mb-3">
                        <h6 class="dropdown-header fw-bold bg-light border-bottom">Administration</h6>
                        <a href="/Admin/Users" class="list-group-item list-group-item-action"><i class="bi bi-people me-2"></i>Users</a>
                        <a href="/Admin/Roles" class="list-group-item list-group-item-action"><i class="bi bi-shield-lock me-2"></i>Roles</a>
                        <a href="/Admin/Permissions" class="list-group-item list-group-item-action"><i class="bi bi-ui-checks-grid me-2"></i>Permissions</a>
                        <a href="/Admin/Locations" class="list-group-item list-group-item-action"><i class="bi bi-building me-2"></i>Locations</a>
                        <a href="/Admin/Chairs" class="list-group-item list-group-item-action"><i class="bi bi-usb-drive me-2"></i>Chairs</a>
                    </div>
                    <div class="list-group list-group-flush border rounded mb-3">
                        <h6 class="dropdown-header fw-bold bg-light border-bottom">Master Data</h6>
                        <a href="/Doctor" class="list-group-item list-group-item-action"><i class="bi bi-person-badge me-2"></i>Doctors / Providers</a>
                        <a href="/Specialty" class="list-group-item list-group-item-action active fw-bold"><i class="bi bi-award me-2"></i>Specialties</a>
                        <a href="/Admin/Insurance" class="list-group-item list-group-item-action"><i class="bi bi-card-checklist me-2"></i>Insurance</a>
                        <a href="/Admin/Procedures" class="list-group-item list-group-item-action"><i class="bi bi-list-check me-2"></i>Procedures</a>
                        <a href="/Admin/Lookup" class="list-group-item list-group-item-action"><i class="bi bi-tags me-2"></i>Master Lookup</a>
                    </div>
                    <div class="list-group list-group-flush border rounded">
                        <h6 class="dropdown-header fw-bold bg-light border-bottom">System Configuration</h6>
                    @if (User.HasClaim("Permission", "Configuration.Security"))
                    {
                        <a href="/Configuration/Security" class="list-group-item list-group-item-action"><i class="bi bi-gear me-2"></i>Configuration</a>
                    }
                    </div>
                </div>
            </div>
        </div>

        <!-- Data Grid -->
        <div class="col-md-9">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Registered @meta.Title</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle enterprise-grid" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Code</td>
                                        <td><span class="fw-semibold">@item.Name</span></td>
                                        <td>@item.Description</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-permission="Specialty.Edit" href="/Specialty/Edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                                <form asp-controller="Specialty" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this specialty?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" @(!User.HasClaim("Permission", "Specialty.Delete") ? "disabled" : "")><i class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
