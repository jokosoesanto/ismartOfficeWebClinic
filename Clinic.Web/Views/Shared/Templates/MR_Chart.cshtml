@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Comprehensive Medical Record Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Patient Chart</h2>
        <div>
            <a href="/MedicalRecord/Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Treatment / Note</a>
            <a href="/Billing" class="btn btn-outline-success shadow-sm ms-2"><i class="bi bi-cash-coin me-1"></i> Go to Billing</a>
        </div>
    </div>

    <!-- Patient Summary Panel -->
    <div class="card shadow-sm border-0 border-start border-primary border-5 mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px; font-size: 1.2rem;">JS</div>
                <div>
                    <h4 class="mb-1 fw-bold">John Smith <span class="badge bg-secondary ms-2 fs-6">PT-2601001</span></h4>
                    <span class="text-muted"><i class="bi bi-person-fill"></i> 36 Years Old, Male | <i class="bi bi-calendar-event"></i> Last Visit: 15 Jul 2026 | <i class="bi bi-heart-pulse"></i> Blood Type: O+</span>
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-danger mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Allergy: Penicillin</span><br>
                <span class="badge bg-info text-dark"><i class="bi bi-shield-check me-1"></i> Insurance: BlueCross Active</span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4 fw-bold" id="mrTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="odontogram-tab" data-bs-toggle="tab" data-bs-target="#odontogram" type="button" role="tab"><i class="bi bi-images me-2"></i>Odontogram</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab"><i class="bi bi-clock-history me-2"></i>Visit & Treatment History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes" type="button" role="tab"><i class="bi bi-journal-text me-2"></i>Clinical Notes</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="medhistory-tab" data-bs-toggle="tab" data-bs-target="#medhistory" type="button" role="tab"><i class="bi bi-clipboard2-pulse me-2"></i>Medical History & Vitals</button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="mrTabContent">
        
        <!-- ODONTOGRAM TAB -->
        <div class="tab-pane fade show active" id="odontogram" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-images me-2"></i>Interactive Chart</h5>
                            <div class="btn-group">
                                <button class="btn btn-outline-secondary btn-sm active" id="btnAdultAdult" onclick="odo.setMode(true); this.classList.add('active'); document.getElementById('btnChildChild').classList.remove('active');">Adult</button>
                                <button class="btn btn-outline-secondary btn-sm" id="btnChildChild" onclick="odo.setMode(false); this.classList.add('active'); document.getElementById('btnAdultAdult').classList.remove('active');">Child</button>
                            </div>
                        </div>
                        
                        <!-- Odontogram Toolbar -->
                        <div class="bg-light border-top border-bottom p-2 mt-3 d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                <select id="selCondition" class="form-select form-select-sm w-auto">
                                    <option value="" disabled selected>-- Select Condition --</option>
                                    <option value="Caries" data-color="#dc3545">Caries (Decay)</option>
                                    <option value="Missing" data-color="#6c757d">Missing Tooth</option>
                                    <option value="Fracture" data-color="#fd7e14">Fracture</option>
                                </select>
                                <select id="selTreatment" class="form-select form-select-sm w-auto">
                                    <option value="" disabled selected>-- Select Treatment --</option>
                                    <option value="Filling" data-color="#0dcaf0">Composite Filling</option>
                                    <option value="RCT" data-color="#198754">Root Canal</option>
                                    <option value="Crown" data-color="#ffc107">Crown</option>
                                </select>
                                <button class="btn btn-sm btn-primary" onclick="applySelection()"><i class="bi bi-check-circle me-1"></i>Apply</button>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-secondary" onclick="odo.undo()"><i class="bi bi-arrow-counterclockwise"></i> Undo</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="odo.clearSelection()"><i class="bi bi-x-circle"></i> Clear Selection</button>
                            </div>
                        </div>

                        <!-- SVG Container -->
                        <div class="card-body bg-white m-0 p-3 overflow-auto" style="min-height: 400px;" id="odontogramContainer">
                        </div>

                        <!-- Legend -->
                        <div class="card-footer bg-white border-top-0 d-flex flex-wrap gap-3 pb-4">
                            <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:#dc3545;"></span>Caries</span>
                            <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:#0dcaf0;"></span>Filling</span>
                            <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:#198754;"></span>RCT</span>
                            <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:#ffc107;"></span>Crown</span>
                            <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:#6c757d;"></span>Missing</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                            <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-list-task me-2"></i>Tooth Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <label class="form-label fw-bold text-primary">Selected Tooth</label>
                                <input type="text" class="form-control fs-5 fw-bold text-primary" id="txtSelectedTooth" readonly placeholder="None">
                                <small class="text-muted" id="txtSelectedSurface"></small>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-danger">Existing Conditions (Diagnosis)</label>
                                <ul class="list-group list-group-flush border rounded mb-2" id="diagnosisList">
                                    <li class="list-group-item d-flex justify-content-between align-items-center text-muted small">
                                        No conditions recorded.
                                    </li>
                                </ul>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-success">Planned/Completed Treatments</label>
                                <ul class="list-group list-group-flush border rounded mb-2" id="treatmentList">
                                    <li class="list-group-item d-flex justify-content-between align-items-center text-muted small">
                                        No treatments recorded.
                                    </li>
                                </ul>
                                <a href="/MedicalRecord/Create" class="btn btn-sm btn-outline-success w-100"><i class="bi bi-plus"></i> Add Full Treatment Record</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- VISIT & TREATMENT HISTORY TAB -->
        <div class="tab-pane fade" id="history" role="tabpanel">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-muted text-uppercase mb-0">Timeline View</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-filter"></i> Filter</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="border-start border-2 border-primary ms-3 ps-4 py-2 position-relative">
                        <!-- Timeline Item 1 -->
                        <div class="mb-5 position-relative">
                            <span class="position-absolute bg-primary rounded-circle" style="width: 15px; height: 15px; left: -31px; top: 5px;"></span>
                            <h5 class="fw-bold text-primary mb-0">31 Jul 2026 - Root Canal Treatment (Tooth #14)</h5>
                            <p class="text-muted small mb-2"><i class="bi bi-person me-1"></i> Provider: Dr. Emily Chen | Status: <span class="badge bg-success">Completed</span></p>
                            <div class="bg-light p-3 rounded border border-secondary border-opacity-25">
                                <p class="mb-1 fw-bold">Clinical Note:</p>
                                <p class="mb-0 text-muted">Patient presented with severe pain in upper left quadrant. Caries reached pulp on #14. Extirpation done. Canals cleaned and shaped. Calcium hydroxide placed. Temporary filling.</p>
                            </div>
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-info"><i class="bi bi-paperclip me-1"></i> View X-Ray</button>
                            </div>
                        </div>

                        <!-- Timeline Item 2 -->
                        <div class="mb-0 position-relative">
                            <span class="position-absolute bg-secondary rounded-circle" style="width: 15px; height: 15px; left: -31px; top: 5px;"></span>
                            <h5 class="fw-bold text-secondary mb-0">15 Jul 2026 - General Consultation</h5>
                            <p class="text-muted small mb-2"><i class="bi bi-person me-1"></i> Provider: Dr. Alan | Status: <span class="badge bg-secondary">Completed</span></p>
                            <div class="bg-light p-3 rounded border border-secondary border-opacity-25">
                                <p class="mb-1 fw-bold">Clinical Note:</p>
                                <p class="mb-0 text-muted">Routine checkup. Patient complained about occasional sensitivity to cold. Identified deep caries on #14. Recommended RCT.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CLINICAL NOTES TAB -->
        <div class="tab-pane fade" id="notes" role="tabpanel">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-muted text-uppercase mb-0">Dedicated Clinical Notes</h5>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addNoteModal"><i class="bi bi-plus"></i> New Note</button>
                </div>
                <div class="card-body">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Provider</th>
                                <th>Note Type</th>
                                <th>Description</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>31 Jul 2026</td>
                                <td>Dr. Emily Chen</td>
                                <td><span class="badge bg-primary">Progress Note</span></td>
                                <td>Post-RCT follow up instructions given to patient.</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MEDICAL HISTORY & VITALS TAB -->
        <div class="tab-pane fade" id="medhistory" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-danger text-white pt-3 pb-2">
                            <h6 class="fw-bold text-uppercase mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Allergies & Alerts</h6>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-danger">Penicillin</span>
                                    <span class="badge bg-danger rounded-pill">Severe</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-warning">Latex</span>
                                    <span class="badge bg-warning rounded-pill">Mild</span>
                                </li>
                            </ul>
                            <button class="btn btn-sm btn-outline-danger mt-3 w-100"><i class="bi bi-plus"></i> Add Allergy</button>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-info text-white pt-3 pb-2">
                            <h6 class="fw-bold text-uppercase mb-0"><i class="bi bi-heart-pulse me-2"></i>Vital Signs (Latest)</h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <h3 class="fw-bold text-primary mb-0">120/80</h3>
                                    <small class="text-muted">Blood Pressure</small>
                                </div>
                                <div class="col-4 border-start border-end">
                                    <h3 class="fw-bold text-primary mb-0">72</h3>
                                    <small class="text-muted">Heart Rate</small>
                                </div>
                                <div class="col-4">
                                    <h3 class="fw-bold text-primary mb-0">36.5°C</h3>
                                    <small class="text-muted">Temperature</small>
                                </div>
                            </div>
                            <div class="text-center text-muted small">Recorded on: 31 Jul 2026</div>
                            <button class="btn btn-sm btn-outline-info mt-3 w-100"><i class="bi bi-plus"></i> Record Vitals</button>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-secondary text-white pt-3 pb-2">
                            <h6 class="fw-bold text-uppercase mb-0"><i class="bi bi-capsule me-2"></i>Medication History</h6>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Medication</th>
                                        <th>Dosage</th>
                                        <th>Prescribed Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Amoxicillin</td>
                                        <td>500mg, 3x/day</td>
                                        <td>15 Jul 2026</td>
                                        <td><span class="badge bg-secondary">Completed</span></td>
                                    </tr>
                                    <tr>
                                        <td>Ibuprofen</td>
                                        <td>400mg, as needed</td>
                                        <td>31 Jul 2026</td>
                                        <td><span class="badge bg-success">Active</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-sm border-0 border-dashed">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-cloud-arrow-up display-4 text-muted mb-3 d-block"></i>
                            <h5 class="fw-bold">Attachments / Documents Placeholder</h5>
                            <p class="text-muted">Drag and drop X-Rays, Lab Results, or Consent Forms here.</p>
                            <button class="btn btn-outline-primary">Browse Files</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Add Note Modal -->
<div class="modal fade" id="addNoteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary">New Clinical Note</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Note Type</label>
                        <select class="form-select">
                            <option>Progress Note</option>
                            <option>Consultation Note</option>
                            <option>Discharge Summary</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea class="form-control" rows="4"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Save Note</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/odontogram.js"></script>
<script>
    let odo;
    document.addEventListener("DOMContentLoaded", function () {
        odo = new Odontogram("odontogramContainer");
        
        odo.onSelectSurface = function(toothId, surfaceId) {
            document.getElementById('txtSelectedTooth').value = `Tooth #${toothId}`;
            
            const surfaceNames = { 'T': 'Top (Buccal/Facial)', 'B': 'Bottom (Lingual)', 'L': 'Left (Mesial/Distal)', 'R': 'Right (Distal/Mesial)', 'C': 'Center (Occlusal/Incisal)' };
            document.getElementById('txtSelectedSurface').innerText = `Surface: ${surfaceNames[surfaceId] || surfaceId}`;
        };
    });

    function applySelection() {
        const cond = document.getElementById('selCondition');
        const treat = document.getElementById('selTreatment');
        
        let type = null;
        let color = null;
        let text = null;
        
        // Prioritize treatment over condition if both selected (or could enforce only one)
        if (treat.value) {
            type = treat.value;
            color = treat.options[treat.selectedIndex].dataset.color;
            text = treat.options[treat.selectedIndex].text;
            
            // Add to Treatment List
            addToList('treatmentList', text, odo.selectedTooth, odo.selectedSurface, "bg-success");
        } else if (cond.value) {
            type = cond.value;
            color = cond.options[cond.selectedIndex].dataset.color;
            text = cond.options[cond.selectedIndex].text;
            
            // Add to Diagnosis List
            addToList('diagnosisList', text, odo.selectedTooth, odo.selectedSurface, "bg-danger");
        } else {
            alert("Please select a condition or treatment to apply.");
            return;
        }

        odo.applyTreatment(type, color);
        
        // Reset dropdowns
        cond.value = "";
        treat.value = "";
    }

    function addToList(listId, text, tooth, surface, badgeClass) {
        const list = document.getElementById(listId);
        
        // Remove empty state if present
        if (list.innerHTML.includes("No ")) {
            list.innerHTML = "";
        }
        
        const surfaceNames = { 'T': 'T', 'B': 'B', 'L': 'L', 'R': 'R', 'C': 'C' };
        
        const li = document.createElement("li");
        li.className = "list-group-item d-flex justify-content-between align-items-center";
        li.innerHTML = `<span><span class="badge ${badgeClass} me-2">${text}</span> #${tooth} (${surfaceNames[surface]})</span>
                        <button class="btn btn-sm btn-outline-secondary border-0" onclick="this.parentElement.remove()"><i class="bi bi-trash"></i></button>`;
        list.appendChild(li);
    }
</script>
