<partial name="Templates/_OdontogramScripts" />
<form id="applyTreatmentForm" method="post" action="/MedicalRecord/Chart/@Model.Id/ApplyTreatment" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
    <input type="hidden" name="treatmentName" id="hiddenTreatmentName" />
    <input type="hidden" name="siteNumber" id="hiddenSiteNumber" />
    <input type="hidden" name="siteDetail" id="hiddenSiteDetail" />
</form>
<script>
    function reflectHistory(tooth, surface, text, color) {
        if (!odo) return;
        odo.clearSelection();
        
        if (tooth) {
            let svgSurface = 'C';
            if (surface) {
                svgSurface = odo.getSvgSurface(tooth, surface);
            }
            odo.handleClick(tooth, svgSurface);
        }
    }

    function openAddTreatment() {
        var patientId = '@Model.Id';
        var appointmentId = '@ViewBag.AppointmentId';
        if (!appointmentId) return;
        
        var url = '/MedicalRecord/Create/' + appointmentId + '?patientId=' + patientId;
        if (odo && odo.selectedTooth) {
            url += '&siteNumber=' + encodeURIComponent(odo.selectedTooth);
        }
        if (odo && odo.selectedSurface) {
            url += '&siteDetail=' + encodeURIComponent(odo.selectedSurface);
        }
        window.location.href = url;
    }

    document.addEventListener("DOMContentLoaded", function () {
        var sessionKey = 'activeTab_' + window.location.pathname;
        var hash = window.location.hash;

        var savedHash = sessionStorage.getItem(sessionKey);
        sessionStorage.removeItem(sessionKey);

        var tabTrigger = null;

        // 1. Try to use the hash from the URL
        if (hash) {
            tabTrigger = document.querySelector('button[data-bs-target="' + hash + '"]');
        }

        // 2. If the URL hash is invalid or missing, try to use the saved hash
        if (!tabTrigger && savedHash) {
            tabTrigger = document.querySelector('button[data-bs-target="' + savedHash + '"]');
            if (tabTrigger) {
                hash = savedHash;
            }
        }

        // 3. If a valid trigger was found, activate it and update URL
        if (tabTrigger) {
            var tab = new bootstrap.Tab(tabTrigger);
            tab.show();
            history.replaceState(null, null, hash);
        }

        // Update hash when a tab is clicked
        var tabElements = document.querySelectorAll('button[data-bs-toggle="tab"]');
        tabElements.forEach(function (tabEl) {
            tabEl.addEventListener('shown.bs.tab', function (event) {
                var target = event.target.getAttribute("data-bs-target");
                if (target) {
                    history.replaceState(null, null, target);
                }
            });
        });

        // Store active tab before form submission
        document.addEventListener('submit', function (e) {
            var currentHash = window.location.hash;
            // If no hash in URL but a tab is active, try to find the active tab pane manually
            if (!currentHash) {
                var activePane = document.querySelector('.tab-pane.active');
                if (activePane) {
                    currentHash = '#' + activePane.id;
                }
            }
            if (currentHash) {
                sessionStorage.setItem(sessionKey, currentHash);
            }
        });
    });
</script>
