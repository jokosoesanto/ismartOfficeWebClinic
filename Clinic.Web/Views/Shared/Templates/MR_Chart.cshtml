@model Clinic.Domain.Entities.MasterData.Patient
@{
    var metadata = ViewBag.Metadata as Clinic.Application.UI.UIMetadata;
    var initials = string.IsNullOrWhiteSpace(Model.FullName) ? "" : string.Join("", Model.FullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    var age = Model.BirthDate.HasValue ? (int)((DateTime.Now - Model.BirthDate.Value).TotalDays / 365.2425) : 0;
    var ageText = Model.BirthDate.HasValue ? $"{age} Years Old" : "Age Unknown";
    var genderText = string.IsNullOrWhiteSpace(Model.Gender) ? "Unknown" : Model.Gender;
    var bloodTypeText = string.IsNullOrWhiteSpace(Model.BloodType) ? "Unknown" : Model.BloodType;
}

<!-- Comprehensive Medical Record Template -->
<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Patient Chart</h2>
        <div>
            @if (ViewBag.AppointmentId != null)
            {
                var appt = ViewBag.Appointment as Clinic.Application.DTOs.Operations.AppointmentDto;
                if (appt != null && appt.Status == Clinic.Domain.Enums.AppointmentStatus.OnTime)
                {
                    <form action="/MedicalRecord/CompleteVisit/@appt.Id" method="post" class="d-inline ms-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="patientId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success shadow-sm" onclick="return confirm('Are you sure you want to complete this visit?');"><i class="bi bi-check-circle me-1"></i> Complete Visit</button>
                    </form>
                }
            }
            <a href="/Billing" class="btn btn-outline-success shadow-sm ms-2"><i class="bi bi-cash-coin me-1"></i> Go to Billing</a>
        </div>
    </div>

    <!-- Patient Summary Panel -->
    <div class="card shadow-sm border-0 border-start border-primary border-5 mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px; font-size: 1.2rem;">@initials</div>
                <div>
                    <h4 class="mb-1 fw-bold">@Model.FullName <span class="badge bg-secondary ms-2 fs-6">@Model.MRN</span></h4>
                    <span class="text-muted"><i class="bi bi-person-fill"></i> @ageText, @genderText | <i class="bi bi-calendar-event"></i> Last Visit: (No Record) | <i class="bi bi-heart-pulse"></i> Blood Type: @bloodTypeText</span>
                </div>
            </div>
            <div class="text-end">
                @if (Model.AllergyStatus == Clinic.Domain.Enums.AllergyStatus.HasAllergies)
                {
                    <span class="badge bg-danger mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i> Allergy: Known Allergies</span><br>
                }
                else if (Model.AllergyStatus == Clinic.Domain.Enums.AllergyStatus.NoKnownAllergy)
                {
                    <span class="badge bg-success mb-2"><i class="bi bi-shield-check me-1"></i> Allergy: No Known Allergy</span><br>
                }
                else
                {
                    <span class="badge bg-secondary mb-2"><i class="bi bi-question-circle me-1"></i> Allergy: Not Recorded</span><br>
                }
                <span class="badge bg-info text-dark"><i class="bi bi-shield-check me-1"></i> Insurance: (No Record)</span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4 fw-bold" id="mrTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="odontogram-tab" data-bs-toggle="tab" data-bs-target="#odontogram" type="button" role="tab"><i class="bi bi-images me-2"></i>Odontogram</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab"><i class="bi bi-clock-history me-2"></i>Visit & Treatment History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes" type="button" role="tab"><i class="bi bi-journal-text me-2"></i>Clinical Notes</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="medhistory-tab" data-bs-toggle="tab" data-bs-target="#medhistory" type="button" role="tab"><i class="bi bi-clipboard2-pulse me-2"></i>Medical History & Vitals</button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="mrTabContent">
        
        <!-- ODONTOGRAM TAB -->
        <div class="tab-pane fade show active" id="odontogram" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-8">
                    <partial name="Templates/_OdontogramCard" />
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                            <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-list-task me-2"></i>Tooth Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <label class="form-label fw-bold text-primary">Selected Tooth</label>
                                <input type="text" class="form-control fs-5 fw-bold text-primary" id="txtSelectedTooth" readonly placeholder="None">
                                <small class="text-muted" id="txtSelectedSurface"></small>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-danger">Existing Conditions (Diagnosis)</label>
                                <ul class="list-group list-group-flush border rounded mb-2" id="diagnosisList">
                                    <li class="list-group-item d-flex justify-content-between align-items-center text-muted small">
                                        No conditions recorded.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Treatment History Section (for this appointment) -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                            <h5 class="mb-0 text-primary"><i class="bi bi-clock-history me-2"></i>Treatment History</h5>
                        </div>
                        <div class="card-body p-4">
                            @if (ViewBag.ExistingTreatments != null && ((IEnumerable<Clinic.Application.DTOs.Operations.AppointmentTreatmentDto>)ViewBag.ExistingTreatments).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle enterprise-grid" data-page-length="5" data-order='[[0, "desc"]]'>
                                        <thead class="table-light">
                                            <tr>
                                                <th>Date</th>
                                                <th>Treatment</th>
                                                <th>Tooth</th>
                                                <th>Surface</th>
                                                <th>Price</th>
                                                <th>Remarks</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach(var t in (IEnumerable<Clinic.Application.DTOs.Operations.AppointmentTreatmentDto>)ViewBag.ExistingTreatments)
                                            {
                                                <tr style="cursor: pointer;" onclick="reflectHistory('@t.SiteNumber', '@t.SiteDetail', '@t.TreatmentItemName', '@t.TreatmentItemColor')">
                                                    <td>@t.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                                    <td class="fw-semibold">@t.TreatmentItemName</td>
                                                    <td>@t.SiteNumber</td>
                                                    <td>@t.SiteDetail</td>
                                                    <td>$@t.ActualPrice.ToString("F2")</td>
                                                    <td class="text-muted small">@t.Remark</td>
                                                    <td class="text-end" onclick="event.stopPropagation();">
                                                        <form asp-controller="MedicalRecord" asp-action="DeleteTreatment" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this treatment (@t.TreatmentItemName on Tooth @t.SiteNumber)? This action cannot be undone.');">
                                                            <input type="hidden" name="treatmentId" value="@t.Id" />
                                                            <input type="hidden" name="patientId" value="@Model.Id" />
                                                            <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Treatment">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1"></i>
                                    <p class="mt-2">No treatments recorded yet.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- VISIT & TREATMENT HISTORY TAB -->
        <div class="tab-pane fade" id="history" role="tabpanel">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-muted text-uppercase mb-0">Timeline View</h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                            <i class="bi bi-filter"></i> Filter
                            @(ViewBag.HistoryStatusFilter != null ? "(Active)" : "")
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-3 shadow" style="min-width: 250px;">
                            <form method="get" action="/MedicalRecord/Chart/@Model.Id">
                                @if (ViewBag.AppointmentId != null)
                                {
                                    <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
                                }
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Visit Status</label>
                                    <select name="historyStatus" class="form-select form-select-sm">
                                        <option value="">All Statuses</option>
                                        @foreach (var status in Enum.GetValues(typeof(Clinic.Domain.Enums.AppointmentStatus)).Cast<Clinic.Domain.Enums.AppointmentStatus>())
                                        {
                                            if (ViewBag.HistoryStatusFilter != null && (Clinic.Domain.Enums.AppointmentStatus)ViewBag.HistoryStatusFilter == status)
                                            {
                                                <option value="@status" selected>@status</option>
                                            }
                                            else
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <a href="/MedicalRecord/Chart/@Model.Id@(ViewBag.AppointmentId != null ? "?appointmentId=" + ViewBag.AppointmentId : "")#history" class="btn btn-sm btn-outline-secondary" onclick="sessionStorage.setItem('activeTab_' + window.location.pathname, '#history');">Clear</a>
                                    <button type="submit" class="btn btn-sm btn-primary" onclick="sessionStorage.setItem('activeTab_' + window.location.pathname, '#history');">Apply</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (ViewBag.HistoricalVisits != null && ((IEnumerable<Clinic.Application.DTOs.Operations.AppointmentDto>)ViewBag.HistoricalVisits).Any())
                    {
                        var historicalVisits = (IEnumerable<Clinic.Application.DTOs.Operations.AppointmentDto>)ViewBag.HistoricalVisits;
                        var historicalTreatmentsLookup = ViewBag.HistoricalTreatments as ILookup<Guid, Clinic.Application.DTOs.Operations.AppointmentTreatmentDto>;

                        <div class="border-start border-2 border-primary ms-3 ps-4 py-2 position-relative">
                            @foreach (var visit in historicalVisits)
                            {
                                var badgeClass = visit.Status == Clinic.Domain.Enums.AppointmentStatus.Completed ? "bg-success" : 
                                                 visit.Status == Clinic.Domain.Enums.AppointmentStatus.Schedule ? "bg-warning text-dark" : "bg-secondary";
                                
                                <div class="mb-5 position-relative">
                                    <span class="position-absolute bg-primary rounded-circle" style="width: 15px; height: 15px; left: -31px; top: 5px;"></span>
                                    <h5 class="fw-bold text-primary mb-0">@visit.Date.ToString("dd MMM yyyy")</h5>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-person me-1"></i> Provider: @(visit.DoctorName ?? "Unassigned") | Status: <span class="badge @badgeClass">@visit.Status</span>
                                    </p>

                                    <!-- Treatments for this visit -->
                                    @{
                                        var treatments = historicalTreatmentsLookup?[visit.Id]?.ToList();
                                    }
                                    @if (treatments != null && treatments.Any())
                                    {
                                        <div class="table-responsive mb-3">
                                            <table class="table table-sm table-bordered align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Treatment</th>
                                                        <th>Tooth</th>
                                                        <th>Surface</th>
                                                        <th>Remarks</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var t in treatments)
                                                    {
                                                        <tr>
                                                            <td class="fw-semibold">@t.TreatmentItemName</td>
                                                            <td>@(string.IsNullOrEmpty(t.SiteNumber) ? "-" : t.SiteNumber)</td>
                                                            <td>@(string.IsNullOrEmpty(t.SiteDetail) ? "-" : t.SiteDetail)</td>
                                                            <td class="text-muted small">@t.Remark</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small mb-3 fst-italic">No treatments recorded for this visit.</div>
                                    }

                                    <!-- Clinical Note for this visit -->
                                    @if (visit.ClinicalNote != null)
                                    {
                                        <div class="bg-light p-3 rounded border border-secondary border-opacity-25">
                                            <p class="mb-1 fw-bold"><i class="bi bi-journal-text me-1"></i>Clinical Note:</p>
                                            @if (!string.IsNullOrWhiteSpace(visit.ClinicalNote.Subjective)) { <div class="mb-1"><span class="fw-semibold">S:</span> <span class="text-muted">@visit.ClinicalNote.Subjective</span></div> }
                                            @if (!string.IsNullOrWhiteSpace(visit.ClinicalNote.Objective)) { <div class="mb-1"><span class="fw-semibold">O:</span> <span class="text-muted">@visit.ClinicalNote.Objective</span></div> }
                                            @if (!string.IsNullOrWhiteSpace(visit.ClinicalNote.Assessment)) { <div class="mb-1"><span class="fw-semibold">A:</span> <span class="text-muted">@visit.ClinicalNote.Assessment</span></div> }
                                            @if (!string.IsNullOrWhiteSpace(visit.ClinicalNote.Plan)) { <div class="mb-1"><span class="fw-semibold">P:</span> <span class="text-muted">@visit.ClinicalNote.Plan</span></div> }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-clock-history display-4 text-secondary mb-3 d-block"></i>
                            <h5>No Historical Visits</h5>
                            <p>This patient does not have any recorded previous encounters.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CLINICAL NOTES TAB -->
        <div class="tab-pane fade" id="notes" role="tabpanel">
            @if (ViewBag.Appointment != null)
            {
                var isLocked = ViewBag.Appointment.Status == Clinic.Domain.Enums.AppointmentStatus.Completed ||
                               ViewBag.Appointment.Status == Clinic.Domain.Enums.AppointmentStatus.Failed ||
                               ViewBag.Appointment.Status == Clinic.Domain.Enums.AppointmentStatus.Reschedule ||
                               ViewBag.Appointment.IsDeleted;
                var note = ViewBag.Appointment.ClinicalNote;
                
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white pt-3 pb-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-uppercase mb-0"><i class="bi bi-journal-text me-2"></i>Encounter Clinical Note (SOAP)</h6>
                    </div>
                    <div class="card-body">
                        @if (note == null)
                        {
                            <div class="alert alert-secondary py-2"><i class="bi bi-info-circle me-2"></i>No Clinical Note Recorded</div>
                        }

                        <form action="/MedicalRecord/SaveClinicalNote" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="patientId" value="@Model.Id" />
                            <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />

                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">S — Subjective</label>
                                <textarea name="subjective" class="form-control" rows="2" @(isLocked ? "readonly" : "") placeholder="Patient-reported information, symptoms, etc.">@note?.Subjective</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">O — Objective</label>
                                <textarea name="objective" class="form-control" rows="2" @(isLocked ? "readonly" : "") placeholder="Clinician-observed findings, measurements, etc.">@note?.Objective</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">A — Assessment</label>
                                <textarea name="assessment" class="form-control" rows="2" @(isLocked ? "readonly" : "") placeholder="Clinical assessment/findings.">@note?.Assessment</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">P — Plan</label>
                                <textarea name="plan" class="form-control" rows="2" @(isLocked ? "readonly" : "") placeholder="Planned clinical management, follow-up, etc.">@note?.Plan</textarea>
                            </div>

                            @if (!isLocked)
                            {
                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save me-1"></i> @(note == null ? "Save Clinical Note" : "Update Clinical Note")
                                    </button>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">Please select an active appointment to view/edit clinical notes.</div>
            }
        </div>

        <!-- MEDICAL HISTORY & VITALS TAB -->
        <div class="tab-pane fade" id="medhistory" role="tabpanel">
            @if (ViewBag.Appointment != null)
            {
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-primary text-white pt-3 pb-2">
                                <h6 class="fw-bold text-uppercase mb-0"><i class="bi bi-chat-left-text me-2"></i>Chief Complaint (Current Visit)</h6>
                            </div>
                            <div class="card-body">
                                @if (ViewBag.Appointment.ChiefComplaints != null && ((IEnumerable<Clinic.Application.DTOs.Operations.AppointmentChiefComplaintDto>)ViewBag.Appointment.ChiefComplaints).Any(c => !c.IsDeleted))
                                {
                                    <ul class="list-group list-group-flush mb-3">
                                        @foreach (var complaint in ((IEnumerable<Clinic.Application.DTOs.Operations.AppointmentChiefComplaintDto>)ViewBag.Appointment.ChiefComplaints).Where(c => !c.IsDeleted))
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <div>
                                                    <span class="fw-bold text-dark">@complaint.Complaint</span>
                                                    @if (!string.IsNullOrEmpty(complaint.ToothNumber))
                                                    {
                                                        <span class="badge bg-secondary ms-2">Tooth: @complaint.ToothNumber</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(complaint.Notes))
                                                    {
                                                        <div class="text-muted small">@complaint.Notes</div>
                                                    }
                                                </div>
                                                <form action="/MedicalRecord/RemoveChiefComplaint" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="patientId" value="@Model.Id" />
                                                    <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
                                                    <input type="hidden" name="complaintId" value="@complaint.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove" onclick="return confirm('Remove this chief complaint?');"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="alert alert-secondary py-2"><i class="bi bi-info-circle me-2"></i>No chief complaint recorded for this visit.</div>
                                }

                                <form action="/MedicalRecord/AddChiefComplaint" method="post" class="mt-2 border-top pt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="patientId" value="@Model.Id" />
                                    <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
                                    <div class="row g-2">
                                        <div class="col-4">
                                            <input type="text" name="complaint" class="form-control form-control-sm" placeholder="Chief Complaint (e.g., Toothache)" required />
                                        </div>
                                        <div class="col-2">
                                            <input type="text" name="toothNumber" class="form-control form-control-sm" placeholder="Tooth #" />
                                        </div>
                                        <div class="col-4">
                                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="Additional Notes (Optional)" />
                                        </div>
                                        <div class="col-2">
                                            <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-plus"></i> Add</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-success text-white pt-3 pb-2">
                                <h6 class="fw-bold text-uppercase mb-0"><i class="bi bi-file-medical me-2"></i>Clinical Diagnosis (Current Visit)</h6>
                            </div>
                            <div class="card-body">
                                @if (ViewBag.ExistingDiagnoses != null && ((IEnumerable<Clinic.Application.DTOs.Operations.AppointmentDiagnosisDto>)ViewBag.ExistingDiagnoses).Any())
                                {
                                    <ul class="list-group list-group-flush mb-3">
                                        @foreach (var diagnosis in (IEnumerable<Clinic.Application.DTOs.Operations.AppointmentDiagnosisDto>)ViewBag.ExistingDiagnoses)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <div>
                                                    <span class="fw-bold text-dark">@diagnosis.DiagnosisCode - @diagnosis.DiagnosisName</span>
                                                    @if (!string.IsNullOrEmpty(diagnosis.Remark))
                                                    {
                                                        <div class="text-muted small">@diagnosis.Remark</div>
                                                    }
                                                </div>
                                                <form action="/MedicalRecord/Chart/@Model.Id/RemoveDiagnosis" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
                                                    <input type="hidden" name="diagnosisId" value="@diagnosis.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove" onclick="return confirm('Remove this diagnosis?');"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="alert alert-secondary py-2"><i class="bi bi-info-circle me-2"></i>No clinical diagnosis recorded for this visit.</div>
                                }

                                <form action="/MedicalRecord/Chart/@Model.Id/AddDiagnosis" method="post" class="mt-2 border-top pt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="appointmentId" value="@ViewBag.AppointmentId" />
                                    <div class="row g-2">
                                        <div class="col-6">
