@model Clinic.Web.Models.CollectionReportViewModel
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<!-- Report Viewer Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@(meta?.Title ?? "Collection Report")</h2>
        <div>
            <button class="btn btn-primary shadow-sm disabled" title="Printing is out of scope"><i class="bi bi-printer me-1"></i> Print</button>
            <button class="btn btn-outline-success shadow-sm ms-2 disabled" title="Export is out of scope"><i class="bi bi-file-earmark-excel me-1"></i> Export Excel</button>
            <button class="btn btn-outline-danger shadow-sm ms-2 disabled" title="Export is out of scope"><i class="bi bi-file-earmark-pdf me-1"></i> Export PDF</button>
        </div>
    </div>

    <div class="row h-100 g-4">
        <!-- Report Tree and Filters -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Report Library</h6>
                </div>
                <div class="card-body">
                    <!-- Search Reports -->
                    <div class="input-group input-group-sm mb-3">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search reports...">
                    </div>
                    
                    <div class="list-group list-group-flush border rounded" style="max-height: 400px; overflow-y: auto;">
                        <a href="/Report" class="list-group-item list-group-item-action ps-4 active">
                            <i class="bi bi-file-bar-graph me-2"></i>Collection Report
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0" id="parameterPanel">
                <div class="card-header bg-light border-bottom-0 pt-3 pb-2">
                    <h6 class="fw-bold text-primary text-uppercase mb-0"><i class="bi bi-sliders me-2"></i>Report Parameters</h6>
                </div>
                <div class="card-body bg-light">
                    <form method="get" action="/Report">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Date Range</label>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text">From</span>
                                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" required>
                            </div>
                            <div class="input-group input-group-sm mb-3">
                                <span class="input-group-text">To</span>
                                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" required>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-arrow-clockwise me-1"></i> Apply / View Report</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Report Preview Panel -->
        <div class="col-md-9">
            <div class="card shadow-sm border-0 h-100 bg-secondary bg-opacity-10 position-relative">
                
                <!-- Toolbar overlay for export -->
                <div class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <div class="btn-group shadow-sm">
                        <button class="btn btn-light btn-sm" title="Zoom In"><i class="bi bi-zoom-in"></i></button>
                        <button class="btn btn-light btn-sm" title="Zoom Out"><i class="bi bi-zoom-out"></i></button>
                        <button class="btn btn-light btn-sm border-start" title="Fit to Width"><i class="bi bi-arrows-fullscreen"></i></button>
                    </div>
                </div>

                <div class="card-body p-4 d-flex justify-content-center align-items-start overflow-auto" id="reportPreviewContainer">
                    <!-- The actual A4 size report page -->
                    <div id="reportPage" class="bg-white p-5 shadow" style="width: 21cm; min-height: 29.7cm;">
                        <div class="text-center mb-4 border-bottom pb-4">
                            <h3 class="fw-bold text-uppercase" id="reportTitleHeader">Collection Report</h3>
                            <h5 class="text-muted">iSmart Office Dental Clinic</h5>
                            <p class="mb-0 text-muted">Period: @Model.FromDate.ToString("dd MMM yyyy") - @Model.ToDate.ToString("dd MMM yyyy")</p>
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Receipt</th>
                                        <th>Patient</th>
                                        <th>Invoice</th>
                                        <th>Payment Method</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Payments.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                No payment transactions found for the selected date range.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach(var payment in Model.Payments)
                                        {
                                            <tr>
                                                <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                                                <td>@payment.ReceiptNumber</td>
                                                <td>@(payment.Invoice?.Appointment?.Patient?.FullName)</td>
                                                <td>@payment.Invoice?.InvoiceNumber</td>
                                                <td>@payment.PaymentMethod</td>
                                                <td class="text-end">@ViewData[$"FormattedAmount_{payment.Id}"]</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold table-active">
                                        <td colspan="5" class="text-end">Total Collection:</td>
                                        <td class="text-end">@Model.FormattedTotalCollection</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        
                        <div class="mt-5 text-end text-muted small">
                            <p>Generated on: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
