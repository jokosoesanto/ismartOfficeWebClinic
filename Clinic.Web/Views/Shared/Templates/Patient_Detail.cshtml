@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Patient Detail Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <div>
            <a href="/Patient/Edit/1" class="btn btn-primary shadow-sm me-2"><i class="bi bi-pencil me-1"></i> Edit Patient</a>
            <a href="/Patient" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Patient List</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <!-- Patient Profile Card -->
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-3 display-1" style="width: 150px; height: 150px;">
                        JS
                    </div>
                    <h3 class="fw-bold mb-1">John Smith</h3>
                    <p class="text-muted mb-3 fs-5">#PT-2601001 <span class="badge bg-success ms-2 fs-6 align-middle">Active</span></p>
                    
                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <a href="/MedicalRecord" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-tooth me-1"></i> Dental Chart</a>
                        <a href="/Billing" class="btn btn-sm btn-outline-info rounded-pill px-3"><i class="bi bi-receipt me-1"></i> Billing</a>
                        <a href="/Appointment/Create" class="btn btn-sm btn-outline-success rounded-pill px-3"><i class="bi bi-calendar-plus me-1"></i> Appt</a>
                    </div>
                    
                    <ul class="list-unstyled text-start mt-4 pt-3 border-top">
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-credit-card-2-front text-muted me-3"></i> <span><strong>SSN/KTP:</strong> 123-456-7890</span></li>
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-droplet-half text-danger me-3"></i> <span><strong>Blood Type:</strong> O+</span></li>
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-briefcase text-muted me-3"></i> <span><strong>Occupation:</strong> Software Engineer at Acme Corp</span></li>
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-telephone text-muted me-3"></i> <span>555-0101</span></li>
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-envelope text-muted me-3"></i> <span>john.smith@example.com</span></li>
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-calendar text-muted me-3"></i> <span>01/01/1990 (36 y/o)</span></li>
                        <li class="mb-3 d-flex align-items-center"><i class="bi bi-person text-muted me-3"></i> <span>Male, Married</span></li>
                        <li class="d-flex align-items-start"><i class="bi bi-geo-alt text-muted me-3 mt-1"></i> <span>123 Main St, Springfield, IL 62701</span></li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4 border-start border-danger border-5">
                <div class="card-body">
                    <h5 class="fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Medical Alerts</h5>
                    <p class="mb-0"><strong>Allergies:</strong> Penicillin</p>
                    <p class="mb-0 mt-2"><strong>Conditions:</strong> Hypertension (Controlled)</p>
                </div>
            </div>
            
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <ul class="nav nav-tabs card-header-tabs">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#history"><i class="bi bi-clock-history me-2"></i>Treatment History</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#insurance_info"><i class="bi bi-shield-check me-2"></i>Insurance</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#appointments"><i class="bi bi-calendar-event me-2"></i>Appointments</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="history">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Provider</th>
                                            <th>Treatment</th>
                                            <th>Tooth</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>15 Jul 2026</td>
                                            <td>Dr. Emily Chen</td>
                                            <td>Composite Filling</td>
                                            <td>#14</td>
                                            <td><span class="badge bg-success">Completed</span></td>
                                        </tr>
                                        <tr>
                                            <td>10 Jun 2026</td>
                                            <td>Dr. Alan</td>
                                            <td>Comprehensive Exam</td>
                                            <td>-</td>
                                            <td><span class="badge bg-success">Completed</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-end mt-3">
                                <a href="/MedicalRecord" class="btn btn-sm btn-outline-primary">View Full Chart <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="insurance_info">
                            <div class="alert alert-light border">
                                <strong>Delta Dental</strong> - Policy #123456789 (Group: Acme Corp) - 80% Coverage Basic
                            </div>
                        </div>
                        <div class="tab-pane fade" id="appointments">
                            <div class="list-group">
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1 fw-bold">Root Canal</h6>
                                        <small class="text-muted">31 Jul 2026, 09:00 AM</small>
                                    </div>
                                    <p class="mb-1 small">Dr. Emily Chen</p>
                                    <span class="badge bg-warning text-dark">Upcoming</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
