@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Scheduler Form Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/Appointment" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Schedule</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-event me-2"></i>Appointment Details</h5>
        </div>
        <div class="card-body p-4">
            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Patient</label>
                        <div class="input-group">
                            <input type="text" class="form-control" value="John Smith" readonly>
                            <button class="btn btn-outline-primary" type="button"><i class="bi bi-search"></i> Look Up</button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Provider <span class="text-danger">*</span></label>
                        <select class="form-select" required>
                            <option value="">Select Provider...</option>
                            <option>Dr. Alan</option>
                            <option selected>Dr. Emily Chen</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Chair <span class="text-danger">*</span></label>
                        <select class="form-select" required>
                            <option value="">Select Chair...</option>
                            <option selected>Chair 1</option>
                            <option>Chair 2</option>
                            <option>Chair 3</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Room</label>
                        <select class="form-select">
                            <option value="">Select Room...</option>
                            <option selected>Room A</option>
                            <option>Room B</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="apptStatus" required>
                            <option value="Scheduled" selected>Scheduled</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Arrived">Arrived (Check-In)</option>
                            <option value="In-Chair">In-Chair</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" value="2026-07-31" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Start Time <span class="text-danger">*</span></label>
                        <input type="time" class="form-control" value="09:00" id="startTime" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">End Time <span class="text-danger">*</span></label>
                        <input type="time" class="form-control" value="10:00" id="endTime" required>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Treatment/Reason</label>
                        <input type="text" class="form-control" value="Root Canal">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Notes</label>
                        <textarea class="form-control" rows="3">Patient requested morning schedule.</textarea>
                    </div>
                </div>
                
                <hr class="my-4">
                
                <div class="d-flex justify-content-end gap-2">
                    <a href="/Appointment" class="btn btn-secondary shadow-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-save me-2"></i>Save Appointment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Validation: Time Slot (Business Rule)
    document.querySelector('form').addEventListener('submit', function(e) {
        e.preventDefault(); // Prevent native form submission for prototype

        const start = document.getElementById('startTime').value;
        const end = document.getElementById('endTime').value;
        const status = document.getElementById('apptStatus').value;
        
        if (start >= end) {
            alert('End time must be after Start time.');
            return; // Stop execution
        }

        if (status === 'Cancelled') {
            const confirmCancel = confirm('Are you sure you want to cancel this appointment?');
            if (!confirmCancel) {
                return; // Stop execution
            }
        }

        // If validation passes, mimic successful save redirect
        window.location.href = '/Appointment';
    });
</script>
