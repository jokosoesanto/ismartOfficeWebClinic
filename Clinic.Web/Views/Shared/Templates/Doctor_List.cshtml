@model IEnumerable<Clinic.Domain.Entities.MasterData.Doctor>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Doctor Management</h2>
            <p class="text-muted mb-0">Manage doctors across multiple clinic locations.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-permission="Doctor.Create" href="/Doctor/Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Doctor</a>
            <a href="?" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</a>
        </div>
    </div>

    <div class="row g-4 h-100">
        <!-- Data Grid -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Registered @meta.Title</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle enterprise-grid" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Specialty</th>
                                    <th>Primary Location</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.DoctorCode</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle me-3" style="width:12px;height:12px;background-color:@(string.IsNullOrEmpty(item.Color) ? "#0d6efd" : item.Color)"></div>
                                                <div>
                                                    <span class="fw-semibold">@item.Title @item.FullName</span><br/>
                                                    <small class="text-muted">@item.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Specialty?.Name</td>
                                        <td>@item.PrimaryLocation?.ClinicName</td>
                                        <td>@item.Phone</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-permission="Doctor.Edit" href="/Doctor/Edit/@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                                <form asp-controller="Doctor" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this doctor?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" @(!User.HasClaim("Permission", "Doctor.Delete") ? "disabled" : "")><i class="bi bi-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
