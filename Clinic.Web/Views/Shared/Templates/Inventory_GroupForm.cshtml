@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Inventory Group Form Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/Inventory" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Inventory</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-folder me-2"></i>Group Details</h5>
        </div>
        <div class="card-body p-4">
            <form>
                <div class="mb-3">
                    <label class="form-label fw-bold">Parent Group</label>
                    <select class="form-select">
                        <option>Root</option>
                        <option>Dental Supplies</option>
                        <option>Office Supplies</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Group Name</label>
                    <input type="text" class="form-control" placeholder="e.g. Composite Resins">
                </div>
                
                <hr class="my-4">
                <div class="d-flex justify-content-end gap-2">
                    <a href="/Inventory" class="btn btn-secondary shadow-sm">Cancel</a>
                    <a href="/Inventory" class="btn btn-primary shadow-sm"><i class="bi bi-save me-2"></i>Save Group</a>
                </div>
            </form>
        </div>
    </div>
</div>
