@model Clinic.Application.DTOs.MasterData.ChairDto
@{
    var isNew = Model.Id == Guid.Empty;
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
    var locations = ViewBag.Locations as IEnumerable<Clinic.Application.DTOs.MasterData.LocationDto>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@meta?.Title</h2>
        <a href="/Chair" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Chairs</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-usb-drive me-2"></i>Chair Details</h5>
        </div>
        <div class="card-body p-4">
            <form method="post" action="/Chair/@(isNew ? "Create" : "Edit/" + Model.Id)" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                @if (!isNew)
                {
                    <input type="hidden" name="Id" value="@Model.Id" />
                }
                
                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">General Information</h6>
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All"></div>
                        <ul>
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                foreach (var error in modelState.Errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        </ul>
                    </div>
                }

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Chair Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Code" required value="@Model.Code">
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Chair Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="Name" required value="@Model.Name">
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                        <select class="form-select" name="LocationId" required>
                            <option value="">-- Select Location --</option>
                            @if (locations != null)
                            {
                                foreach (var l in locations)
                                {
                                    if (Model.LocationId == l.Id)
                                    {
                                        <option value="@l.Id" selected>@l.ClinicName</option>
                                    }
                                    else
                                    {
                                        <option value="@l.Id">@l.ClinicName</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea class="form-control" name="Description" rows="3">@Model.Description</textarea>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" @(isNew || Model.IsActive ? "checked" : "")>
                            <label class="form-check-label fw-bold" for="IsActive">Is Active</label>
                            <input type="hidden" name="IsActive" value="false" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a href="/Chair" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Chair</button>
                </div>
            </form>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var forms = document.querySelectorAll('.needs-validation');
                    Array.prototype.slice.call(forms).forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                });
            </script>
        </div>
    </div>
</div>
