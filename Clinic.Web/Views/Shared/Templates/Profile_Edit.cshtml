@model Clinic.Application.UI.UIMetadata
@{
    var successMessage = TempData["SuccessMessage"] as string;
    var profileDto = Model.Data as Clinic.Application.DTOs.Auth.UpdateProfileDto ?? new Clinic.Application.DTOs.Auth.UpdateProfileDto();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Edit Profile</h5>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger shadow-sm">
                        <h6 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Please fix the following errors:</h6>
                        <hr>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form method="post" action="/Profile/Update">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="FullName" value="@profileDto.FullName" required autofocus>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Display Name (Optional)</label>
                        <input type="text" class="form-control" name="DisplayName" value="@profileDto.DisplayName">
                        <div class="form-text">If provided, this will be shown instead of your full name.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" name="Email" value="@profileDto.Email" required>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input type="text" class="form-control" name="PhoneNumber" value="@profileDto.PhoneNumber">
                    </div>
                    
                    <div class="d-flex justify-content-end mt-4 gap-2">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary shadow-sm">Cancel</a>
                        <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-save me-2"></i>Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
