@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Patient List Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Patient Management</h2>
        <div>
            <a href="/Patient/Create" class="btn btn-primary shadow-sm"><i class="bi bi-person-plus me-1"></i> Add Patient</a>
            <button class="btn btn-outline-secondary shadow-sm ms-2"><i class="bi bi-upload me-1"></i> Export</button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded d-flex align-items-center p-3">
            <div class="flex-grow-1">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search by Patient Name, ID, or Phone...">
                    <button class="btn btn-primary px-4">Search</button>
                </div>
            </div>
            <div class="ms-3 border-start ps-3 d-flex gap-2">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="activeOnly" checked>
                    <label class="form-check-label text-muted" for="activeOnly">Active Only</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Patient ID</th>
                            <th>Name</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th class="text-center pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-4 fw-bold">#PT-2601001</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px; font-size: 12px;">JS</div>
                                    <span class="fw-bold">John Smith</span>
                                </div>
                            </td>
                            <td>01/01/1990 (36 y/o)</td>
                            <td>Male</td>
                            <td>555-0101</td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td class="text-center pe-4">
                                <a href="/Patient/1" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                <a href="/Patient/Edit/1" class="btn btn-sm btn-outline-primary ms-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a href="/MedicalRecord" class="btn btn-sm btn-outline-success ms-1" title="Dental Chart"><i class="bi bi-tooth"></i></a>
                                <button class="btn btn-sm btn-outline-danger ms-1" title="Delete" data-bs-toggle="modal" data-bs-target="#deletePatientModal" onclick="prepareDelete('John Smith', true)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="ps-4 fw-bold">#PT-2601002</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-info text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px; font-size: 12px;">JS</div>
                                    <span class="fw-bold">Jane Smith</span>
                                </div>
                            </td>
                            <td>15/05/1985 (41 y/o)</td>
                            <td>Female</td>
                            <td>555-0202</td>
                            <td><span class="badge bg-success">Active</span></td>
                            <td class="text-center pe-4">
                                <a href="/Patient/2" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                <a href="/Patient/Edit/2" class="btn btn-sm btn-outline-primary ms-1" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a href="/MedicalRecord" class="btn btn-sm btn-outline-success ms-1" title="Dental Chart"><i class="bi bi-tooth"></i></a>
                                <button class="btn btn-sm btn-outline-danger ms-1" title="Delete" data-bs-toggle="modal" data-bs-target="#deletePatientModal" onclick="prepareDelete('Jane Smith', false)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3">
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal (Data Deletion Protection Rule) -->
<div class="modal fade" id="deletePatientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-bottom-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Patient</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-x-circle text-danger mb-3" style="font-size: 4rem;"></i>
                <h4 class="fw-bold mb-3" id="deleteModalPatientName">Delete Patient?</h4>
                
                <div id="deleteWarningMessage" class="alert alert-warning text-start d-none mb-0">
                    <strong><i class="bi bi-shield-lock-fill me-2"></i>Deletion Blocked</strong><br>
                    This patient cannot be deleted because they have existing <strong>Medical Records</strong> or <strong>Financial Balances</strong>.
                </div>
                
                <p id="deleteConfirmMessage" class="text-muted mb-0">
                    Are you sure you want to delete this patient record? This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light border-top-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmDelete">Delete Patient</button>
            </div>
        </div>
    </div>
</div>

<script>
    function prepareDelete(patientName, hasDependencies) {
        document.getElementById('deleteModalPatientName').innerText = "Delete " + patientName + "?";
        
        const warningEl = document.getElementById('deleteWarningMessage');
        const confirmEl = document.getElementById('deleteConfirmMessage');
        const btnDelete = document.getElementById('btnConfirmDelete');
        
        if (hasDependencies) {
            warningEl.classList.remove('d-none');
            confirmEl.classList.add('d-none');
            btnDelete.disabled = true;
        } else {
            warningEl.classList.add('d-none');
            confirmEl.classList.remove('d-none');
            btnDelete.disabled = false;
        }
    }
</script>
