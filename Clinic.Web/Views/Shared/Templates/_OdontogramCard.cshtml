<div class="card shadow-sm border-0 h-100">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-images me-2"></i>Interactive Chart</h5>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm active" id="btnAdultAdult" onclick="odo.setMode(true); this.classList.add('active'); document.getElementById('btnChildChild').classList.remove('active');">Adult</button>
            <button class="btn btn-outline-secondary btn-sm" id="btnChildChild" onclick="odo.setMode(false); this.classList.add('active'); document.getElementById('btnAdultAdult').classList.remove('active');">Child</button>
        </div>
    </div>
    
    @{
        var apptContext = ViewBag.Appointment as Clinic.Application.DTOs.Operations.AppointmentDto;
        bool isReadOnly = apptContext == null || apptContext.Status == Clinic.Domain.Enums.AppointmentStatus.Completed;
    }

    <!-- Odontogram Toolbar -->
    @if (!isReadOnly)
    {
        <div class="bg-light border-top border-bottom p-2 mt-3 d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2">
                <select id="selCondition" class="form-select w-auto">
                    <option value="" disabled selected>-- Select Condition --</option>
                    @if (ViewBag.Conditions != null)
                    {
                        foreach (var c in ViewBag.Conditions)
                        {
                            if (c.IsActive)
                            {
                                <option value="@c.ConditionName" data-color="@c.Color">@c.ConditionName</option>
                            }
                        }
                    }
                </select>
                <select id="selTreatment" class="form-select w-auto">
                    <option value="" disabled selected>-- Select Treatment --</option>
                    @if (ViewBag.Treatments != null)
                    {
                        foreach (var t in ViewBag.Treatments)
                        {
                            if (t.IsActive)
                            {
                                <option value="@t.TreatmentName" data-color="@t.Color">@t.TreatmentName</option>
                            }
                        }
                    }
                </select>
                <button class="btn btn-primary" onclick="applySelection()"><i class="bi bi-check-circle me-1"></i>Apply</button>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-secondary" onclick="odo.undo()"><i class="bi bi-arrow-counterclockwise"></i> Undo</button>
                <button class="btn btn-sm btn-outline-danger" onclick="odo.clearSelection()"><i class="bi bi-x-circle"></i> Clear Selection</button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-light border-top border-bottom p-3 mt-3 text-center text-muted">
            <i class="bi bi-lock-fill me-2"></i> Treatment capture is locked because the appointment is completed or no active appointment context.
        </div>
    }

    <!-- SVG Container -->
    <div class="card-body bg-white m-0 p-3 overflow-auto" style="min-height: 400px;" id="odontogramContainer">
    </div>

    <!-- Legend -->
    <div class="card-footer bg-white border-top-0 d-flex flex-wrap gap-3 pb-4" id="odontogramLegend">
        <span class="small fw-bold text-danger">Conditions:</span>
        @if (ViewBag.Conditions != null)
        {
            foreach (var c in ViewBag.Conditions)
            {
                if (c.IsActive)
                {
                    <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:@c.Color;"></span>@c.ConditionName</span>
                }
            }
        }
        <span class="small fw-bold text-primary ms-3">Treatments:</span>
        @if (ViewBag.Treatments != null)
        {
            foreach (var t in ViewBag.Treatments)
            {
                if (t.IsActive)
                {
                    <span class="small"><span class="d-inline-block rounded-circle me-1" style="width:10px; height:10px; background-color:@t.Color;"></span>@t.TreatmentName</span>
                }
            }
        }
    </div>
</div>
