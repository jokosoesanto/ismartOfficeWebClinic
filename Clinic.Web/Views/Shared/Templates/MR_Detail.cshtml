@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Medical Record Detail Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/MedicalRecord/History/1" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to History</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-file-earmark-medical me-2"></i>Treatment Record</h5>
            <span class="badge bg-success fs-6">Completed</span>
        </div>
        <div class="card-body p-5">
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h6 class="text-muted text-uppercase fw-bold mb-1">Patient</h6>
                    <p class="fs-5 fw-bold mb-0">John Smith</p>
                    <p class="text-muted small">PT-2601001</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h6 class="text-muted text-uppercase fw-bold mb-1">Provider</h6>
                    <p class="fs-5 fw-bold mb-0">Dr. Emily Chen</p>
                    <p class="text-muted small">Date: 31 Jul 2026</p>
                </div>
            </div>

            <div class="bg-light p-4 rounded border mb-4">
                <div class="row text-center">
                    <div class="col-4 border-end">
                        <span class="d-block text-muted text-uppercase fw-bold small mb-1">Tooth</span>
                        <h3 class="text-primary fw-bold mb-0">14</h3>
                    </div>
                    <div class="col-4 border-end">
                        <span class="d-block text-muted text-uppercase fw-bold small mb-1">Surface</span>
                        <h3 class="text-primary fw-bold mb-0">MOD</h3>
                    </div>
                    <div class="col-4">
                        <span class="d-block text-muted text-uppercase fw-bold small mb-1">Fee</span>
                        <h3 class="text-success fw-bold mb-0">$450.00</h3>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="text-muted text-uppercase fw-bold mb-2">Procedure</h6>
                <h4 class="fw-bold">Root Canal Treatment</h4>
            </div>

            <div>
                <h6 class="text-muted text-uppercase fw-bold mb-2">Clinical Notes</h6>
                <div class="p-3 border rounded bg-white" style="min-height: 100px;">
                    Patient presented with severe pain in tooth #14. Diagnosis: Irreversible pulpitis. Administered local anesthesia. Accessed pulp chamber, extirpated pulp. Canals cleaned and shaped. Obturation performed with gutta-percha. Temporary filling placed. Patient advised to return for permanent crown preparation.
                </div>
            </div>
            
            <hr class="my-5">
            <div class="text-center text-muted small">
                <p class="mb-0">Record entered by: Dr. Emily Chen on 31 Jul 2026 10:15 AM</p>
                <p>iSmart Office Web Clinic Framework</p>
            </div>
        </div>
    </div>
</div>
