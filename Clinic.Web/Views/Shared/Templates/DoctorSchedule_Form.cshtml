@model Clinic.Application.DTOs.MasterData.DoctorScheduleDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@meta.Title</h2>
        <a href="/Doctor/Edit/@ViewBag.DoctorId" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Doctor</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-calendar3 me-2"></i>Schedule Details</h5>
        </div>
        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All" class="text-danger mb-0"></div>
                </div>
            }

            <form method="post" action="/Doctor/@ViewBag.DoctorId/Schedule/@(Model.Id == null || Model.Id == Guid.Empty ? "Create" : "Edit/" + Model.Id)" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="DoctorId" value="@ViewBag.DoctorId" />
                <input type="hidden" name="Id" value="@Model.Id" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="LocationId" asp-items="ViewBag.Locations" required>
                            <option value="">-- Select Location --</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Day of Week <span class="text-danger">*</span></label>
                        <select class="form-select" name="DayOfWeek" required>
                            <option value="">-- Select Day --</option>
                            <option value="1" selected="@(Model.DayOfWeek == 1)">Monday</option>
                            <option value="2" selected="@(Model.DayOfWeek == 2)">Tuesday</option>
                            <option value="3" selected="@(Model.DayOfWeek == 3)">Wednesday</option>
                            <option value="4" selected="@(Model.DayOfWeek == 4)">Thursday</option>
                            <option value="5" selected="@(Model.DayOfWeek == 5)">Friday</option>
                            <option value="6" selected="@(Model.DayOfWeek == 6)">Saturday</option>
                            <option value="0" selected="@(Model.DayOfWeek == 0)">Sunday</option>
                        </select>
                    </div>
                    
                    <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary mt-3">Working Hours</h6>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Start Time</label>
                        <input type="time" class="form-control" name="StartTime" value="@Model.StartTime">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">End Time</label>
                        <input type="time" class="form-control" name="EndTime" value="@Model.EndTime">
                    </div>

                    <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary mt-3">Break Hours</h6>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Break Start</label>
                        <input type="time" class="form-control" name="BreakStart" value="@Model.BreakStart">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Break End</label>
                        <input type="time" class="form-control" name="BreakEnd" value="@Model.BreakEnd">
                    </div>

                    <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary mt-3">Limits</h6>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Max Appointments</label>
                        <input type="number" class="form-control" name="MaximumAppointment" value="@Model.MaximumAppointment">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Slot Interval (mins)</label>
                        <input type="number" class="form-control" name="SlotInterval" value="@Model.SlotInterval">
                    </div>
                    
                    <div class="col-12 mb-3">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="IsAvailable" name="IsAvailable" value="true" @(Model.IsAvailable ? "checked" : "")>
                            <label class="form-check-label fw-bold" for="IsAvailable">Is Available</label>
                            <input type="hidden" name="IsAvailable" value="false" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a href="/Doctor/Edit/@ViewBag.DoctorId" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Schedule</button>
                </div>
            </form>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var forms = document.querySelectorAll('.needs-validation');
                    Array.prototype.slice.call(forms).forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                });
            </script>
        </div>
    </div>
</div>
