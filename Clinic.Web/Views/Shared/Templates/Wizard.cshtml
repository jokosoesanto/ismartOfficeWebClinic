@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Wizard Template -->
<div class="template-wizard card shadow-sm w-75 mx-auto mt-4">
    <div class="card-header bg-white p-4 text-center">
        <!-- Step Indicator -->
        <div class="d-flex justify-content-between align-items-center position-relative w-75 mx-auto">
            <div class="progress position-absolute" style="height: 3px; width: 100%; top: 50%; left: 0; z-index: 1;">
                <div class="progress-bar" role="progressbar" style="width: 50%;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            
            <div class="position-relative bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; z-index: 2;">1</div>
            <div class="position-relative bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; z-index: 2;">2</div>
            <div class="position-relative bg-light text-muted border rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; z-index: 2;">3</div>
        </div>
        <div class="d-flex justify-content-between text-muted small mt-2 w-75 mx-auto">
            <span>Basic Info</span>
            <span>Details</span>
            <span>Confirm</span>
        </div>
    </div>
    
    <div class="card-body p-5 text-center">
        <i class="bi bi-ui-checks-grid display-1 text-secondary mb-3"></i>
        <h3>Wizard Step Content Placeholder</h3>
        <p class="text-muted">Form elements for the current step will be rendered here.</p>
    </div>
    
    <div class="card-footer bg-light p-3 d-flex justify-content-between">
        <!-- Navigation -->
        <button class="btn btn-outline-secondary"><i class="bi bi-chevron-left"></i> Previous</button>
        <button class="btn btn-primary">Next <i class="bi bi-chevron-right"></i></button>
    </div>
</div>
