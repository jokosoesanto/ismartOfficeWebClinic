@model Clinic.Application.DTOs.MasterData.DoctorDto
@{
    var isNew = Model.Id == null || Model.Id == Guid.Empty;
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@meta.Title</h2>
        <a href="/Doctor" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Doctors</a>
    </div>

    <form method="post" action="/Doctor/@(isNew ? "Create" : "Edit/" + Model.Id)" class="needs-validation" novalidate id="doctorForm">
        @Html.AntiForgeryToken()
        @if (!isNew)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }
        
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-body p-0">
                        <div class="nav flex-column nav-pills p-3" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                            <button class="nav-link active text-start mb-2" id="v-pills-general-tab" data-bs-toggle="pill" data-bs-target="#v-pills-general" type="button" role="tab" aria-selected="true">
                                <i class="bi bi-person me-2"></i> General Info
                            </button>
                            <button class="nav-link text-start mb-2" id="v-pills-professional-tab" data-bs-toggle="pill" data-bs-target="#v-pills-professional" type="button" role="tab" aria-selected="false">
                                <i class="bi bi-briefcase me-2"></i> Professional
                            </button>
                            <button class="nav-link text-start mb-2" id="v-pills-contact-tab" data-bs-toggle="pill" data-bs-target="#v-pills-contact" type="button" role="tab" aria-selected="false">
                                <i class="bi bi-telephone me-2"></i> Contact Info
                            </button>
                            <button class="nav-link text-start mb-2" id="v-pills-practice-tab" data-bs-toggle="pill" data-bs-target="#v-pills-practice" type="button" role="tab" aria-selected="false">
                                <i class="bi bi-building me-2"></i> Practice Settings
                            </button>
                            @if(!isNew)
                            {
                                <button class="nav-link text-start" id="v-pills-schedule-tab" data-bs-toggle="pill" data-bs-target="#v-pills-schedule" type="button" role="tab" aria-selected="false">
                                    <i class="bi bi-calendar3 me-2"></i> Schedule
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="tab-content" id="v-pills-tabContent">
                    
                    <!-- General Tab -->
                    <div class="tab-pane fade show active" id="v-pills-general" role="tabpanel">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-person me-2"></i>General Information</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Doctor Code <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" name="DoctorCode" required value="@Model.DoctorCode">
                                        <div class="invalid-feedback">Doctor Code is required.</div>
                                    </div>
                                    <div class="col-md-2 mb-3">
                                        <label class="form-label fw-bold">Title</label>
                                        <input type="text" class="form-control" name="Title" value="@Model.Title" placeholder="Dr.">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" name="FullName" required value="@Model.FullName">
                                        <div class="invalid-feedback">Full Name is required.</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Specialty <span class="text-danger">*</span></label>
                                        <select class="form-select" name="SpecialtyId" asp-items="ViewBag.Specialties" required>
                                            <option value="">-- Select Specialty --</option>
                                        </select>
                                        <div class="invalid-feedback">Specialty is required.</div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Primary Location</label>
                                        <select class="form-select" name="PrimaryLocationId" asp-items="ViewBag.Locations">
                                            <option value="">-- Select Location --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Gender</label>
                                        <select class="form-select" name="Gender">
                                            <option value="">-- Select --</option>
                                            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                                            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Birth Date</label>
                                        <input type="date" class="form-control" name="BirthDate" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Calendar Color</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="color" class="form-control form-control-color" name="Color" value="@(string.IsNullOrEmpty(Model.Color) ? "#0d6efd" : Model.Color)" title="Choose calendar color">
                                            <span class="text-muted small">Color used in Schedule Board</span>
                                        </div>
                                    </div>
                                    <div class="col-12 mb-3">
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")>
                                            <label class="form-check-label fw-bold" for="IsActive">Is Active</label>
                                            <input type="hidden" name="IsActive" value="false" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Tab -->
                    <div class="tab-pane fade" id="v-pills-professional" role="tabpanel">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-briefcase me-2"></i>Professional Details</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">License Number</label>
                                        <input type="text" class="form-control" name="LicenseNumber" value="@Model.LicenseNumber">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Registration Number (STR)</label>
                                        <input type="text" class="form-control" name="RegistrationNumber" value="@Model.RegistrationNumber">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Info Tab -->
                    <div class="tab-pane fade" id="v-pills-contact" role="tabpanel">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-telephone me-2"></i>Contact Information</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Phone</label>
                                        <input type="text" class="form-control" name="Phone" value="@Model.Phone">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Email</label>
                                        <input type="email" class="form-control" name="Email" value="@Model.Email">
                                    </div>
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-bold">Address</label>
                                        <textarea class="form-control" name="Address" rows="2">@Model.Address</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Practice Settings Tab -->
                    <div class="tab-pane fade" id="v-pills-practice" role="tabpanel">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-building me-2"></i>Practice Settings</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Consultation Duration (mins)</label>
                                        <input type="number" class="form-control" name="ConsultationDuration" value="@Model.ConsultationDuration">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-bold">Appointment Interval (Minutes)</label>
                                        <input type="number" class="form-control" name="AppointmentInterval" value="@Model.AppointmentInterval">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if(!isNew)
                    {
                    <!-- Schedule Tab -->
                    <div class="tab-pane fade" id="v-pills-schedule" role="tabpanel">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between">
                                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-calendar3 me-2"></i>Weekly Schedule</h5>
                                <a href="/Doctor/@Model.Id/Schedule/Create" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i> Add Schedule</a>
                            </div>
                            <div class="card-body p-4">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle enterprise-grid">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Day</th>
                                                <th>Time</th>
                                                <th>Break</th>
                                                <th>Max Appt</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if(Model.Schedules.Any())
                                            {
                                                foreach (var s in Model.Schedules.OrderBy(x => x.DayOfWeek))
                                                {
                                                    <tr>
                                                        <td>
                                                            @if(s.IsAvailable) { <span class="badge bg-success bg-opacity-10 text-success me-2">Available</span> }
                                                            else { <span class="badge bg-danger bg-opacity-10 text-danger me-2">Off</span> }
                                                            <span class="fw-semibold">@((DayOfWeek)s.DayOfWeek)</span>
                                                        </td>
                                                        <td>@(s.StartTime) - @(s.EndTime)</td>
                                                        <td>@(s.BreakStart != null ? $"{s.BreakStart} - {s.BreakEnd}" : "-")</td>
                                                        <td>@s.MaximumAppointment</td>
                                                        <td>
                                                            <a href="/Doctor/@Model.Id/Schedule/Edit/@s.Id" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteSchedule('@s.Id')"><i class="bi bi-trash"></i></button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                    
                </div>
                
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Doctor" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-save me-2"></i>Save Doctor</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

<form id="deleteScheduleForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="doctorId" value="@Model.Id" />
</form>

<script>
function deleteSchedule(scheduleId) {
    if(confirm('Delete this schedule?')) {
        var form = document.getElementById('deleteScheduleForm');
        form.action = '/Doctor/DeleteSchedule/' + scheduleId;
        form.submit();
    }
}
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    var specVal = '@Model.SpecialtyId';
    if (specVal && specVal !== '00000000-0000-0000-0000-000000000000') {
        document.querySelector('select[name="SpecialtyId"]').value = specVal;
    }
    var locVal = '@Model.PrimaryLocationId';
    if (locVal && locVal !== '00000000-0000-0000-0000-000000000000') {
        document.querySelector('select[name="PrimaryLocationId"]').value = locVal;
    }

    // UX Form Validation & Tab Switching
    var form = document.getElementById('doctorForm');
    form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
            
            // Find the first invalid element
            var firstInvalid = form.querySelector(':invalid');
            if (firstInvalid) {
                // Find its closest tab pane
                var tabPane = firstInvalid.closest('.tab-pane');
                if (tabPane) {
                    var tabId = tabPane.id;
                    // Find the button that triggers this tab and click it
                    var tabButton = document.querySelector('button[data-bs-target="#' + tabId + '"]');
                    if (tabButton) {
                        var bsTab = new bootstrap.Tab(tabButton);
                        bsTab.show();
                        
                        // Focus the element after tab transition
                        setTimeout(function() {
                            firstInvalid.focus();
                        }, 200);
                    }
                }
            }
        }
        form.classList.add('was-validated');
    }, false);
});
</script>
