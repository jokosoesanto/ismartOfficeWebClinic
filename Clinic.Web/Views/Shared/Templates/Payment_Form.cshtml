@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Payment Form Template (Parity with frmPayment.cs) -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/Billing" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Billing</a>
    </div>

    <div class="row g-4">
        <!-- Patient Information & Appt List -->
        <div class="col-md-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-person me-2"></i>Patient Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Patient ID</label>
                            <div class="input-group">
                                <input type="text" class="form-control" value="PT-2601001" readonly>
                                <button class="btn btn-outline-primary" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">First Name</label>
                            <input type="text" class="form-control" value="John" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Last Name</label>
                            <input type="text" class="form-control" value="Smith" readonly>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-list-check me-2"></i>Appointments to Pay</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">
                            <thead class="table-light">
                                <tr>
                                    <th>Select</th>
                                    <th>Date</th>
                                    <th>Treatment</th>
                                    <th class="text-end">Fee</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><input class="form-check-input procedure-check" type="checkbox" checked value="450.00"></td>
                                    <td>31/07/2026</td>
                                    <td>Root Canal <span class="badge bg-secondary ms-2">D3330</span></td>
                                    <td class="text-end procedure-fee">$450.00</td>
                                </tr>
                                <tr>
                                    <td><input class="form-check-input procedure-check" type="checkbox" checked value="150.00"></td>
                                    <td>31/07/2026</td>
                                    <td>Panoramic X-Ray <span class="badge bg-secondary ms-2">D0330</span></td>
                                    <td class="text-end procedure-fee">$150.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Details -->
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-header bg-light border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-primary text-uppercase mb-0"><i class="bi bi-credit-card me-2"></i>Payment Details</h5>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-4 text-center p-3 bg-white border rounded">
                            <h6 class="text-muted text-uppercase mb-1">Total Bill</h6>
                            <h2 class="text-danger fw-bold mb-0" id="lblTotalBill">$600.00</h2>
                        </div>
                        
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Discount (%)</label>
                                <input type="number" class="form-control" id="inputDiscount" placeholder="0" min="0" max="100" value="0">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Insurance Coverage</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="inputInsurance" placeholder="0.00" min="0" value="0.00">
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Payment Method</label>
                            <select class="form-select" id="paymentMethod">
                                <option>Cash</option>
                                <option selected>Credit Card</option>
                                <option>Bank Transfer</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Payment Amount</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">$</span>
                                <input type="number" class="form-control fw-bold text-success fs-5" id="inputPayment" min="0" step="0.01" value="600.00" required>
                            </div>
                        </div>

                        <div class="mb-4 p-3 bg-white border rounded">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted fw-bold">Discount Applied:</span>
                                <span class="fw-bold text-success" id="lblDiscountAmt">$0.00</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted fw-bold">Net Bill:</span>
                                <span class="fw-bold" id="lblNetBill">$600.00</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted fw-bold">Remaining Outstanding:</span>
                                <span class="fw-bold text-danger" id="lblOutstanding">$0.00</span>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm" id="btnMakePayment"><i class="bi bi-check-circle me-2"></i>Make Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const checkboxes = document.querySelectorAll('.procedure-check');
        const inputDiscount = document.getElementById('inputDiscount');
        const inputInsurance = document.getElementById('inputInsurance');
        const inputPayment = document.getElementById('inputPayment');
        const form = document.querySelector('form');

        function formatCurrency(val) {
            return '$' + parseFloat(val).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
        }

        function calculate() {
            let total = 0;
            checkboxes.forEach(chk => {
                if(chk.checked) total += parseFloat(chk.value);
            });

            const discountPct = parseFloat(inputDiscount.value) || 0;
            const discountAmt = total * (discountPct / 100);
            const netBill = total - discountAmt;
            
            const insuranceCov = parseFloat(inputInsurance.value) || 0;
            const paymentAmt = parseFloat(inputPayment.value) || 0;
            
            const outstanding = netBill - insuranceCov - paymentAmt;

            document.getElementById('lblTotalBill').innerText = formatCurrency(total);
            document.getElementById('lblDiscountAmt').innerText = '-' + formatCurrency(discountAmt);
            document.getElementById('lblNetBill').innerText = formatCurrency(netBill);
            
            const outLabel = document.getElementById('lblOutstanding');
            outLabel.innerText = formatCurrency(Math.max(0, outstanding));
            
            if (outstanding > 0) {
                outLabel.className = 'fw-bold text-danger';
            } else {
                outLabel.className = 'fw-bold text-success';
            }
        }

        checkboxes.forEach(c => c.addEventListener('change', calculate));
        inputDiscount.addEventListener('input', calculate);
        inputInsurance.addEventListener('input', calculate);
        inputPayment.addEventListener('input', calculate);

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            if(parseFloat(inputPayment.value) < 0) {
                alert('Business Rule Error: Payment amount cannot be negative.');
                return;
            }
            
            const insurance = parseFloat(inputInsurance.value) || 0;
            const totalStr = document.getElementById('lblNetBill').innerText.replace('$','').replace(',','');
            const net = parseFloat(totalStr);
            
            if(insurance > net) {
                alert('Business Rule Error: Insurance coverage cannot exceed the total bill.');
                return;
            }
            
            if(confirm('Are you sure you want to finalize this payment?')) {
                window.location.href = '/Billing/Preview/1';
            }
        });
        
        calculate();
    });
</script>
