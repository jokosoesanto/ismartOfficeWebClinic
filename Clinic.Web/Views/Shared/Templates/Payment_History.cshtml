@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Payment History Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Billing & Payment History</h2>
        <div>
            <a href="/Billing/Create" class="btn btn-primary shadow-sm"><i class="bi bi-cash-coin me-1"></i> New Payment</a>
            <button class="btn btn-outline-secondary shadow-sm ms-2"><i class="bi bi-printer me-1"></i> Print Statement</button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-file-earmark-text me-2"></i>Billing History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Patient</th>
                                    <th>Invoice #</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>31/07/2026</td>
                                    <td>John Smith</td>
                                    <td><a href="/Billing/Preview/1">INV-2607-001</a></td>
                                    <td class="text-end fw-bold">$450.00</td>
                                </tr>
                                <tr>
                                    <td>25/07/2026</td>
                                    <td>Jane Smith</td>
                                    <td><a href="/Billing/Preview/2">INV-2607-015</a></td>
                                    <td class="text-end fw-bold">$120.00</td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="3" class="text-end">Total Billings:</td>
                                    <td class="text-end">$570.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-success text-uppercase mb-0"><i class="bi bi-cash me-2"></i>Payment History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Patient</th>
                                    <th>Method</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>31/07/2026</td>
                                    <td>John Smith</td>
                                    <td>Credit Card</td>
                                    <td class="text-end text-success fw-bold">+$450.00</td>
                                    <td class="text-center">
                                        <a href="/Billing/Preview/1" class="btn btn-sm btn-outline-info"><i class="bi bi-receipt"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light fw-bold text-success">
                                <tr>
                                    <td colspan="3" class="text-end">Total Payments:</td>
                                    <td class="text-end">+$450.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
