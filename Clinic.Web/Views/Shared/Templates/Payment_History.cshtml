@model IEnumerable<Clinic.Domain.Entities.Operations.Invoice>
@inject Clinic.Application.Interfaces.Configuration.ICurrencyService CurrencyService

@{
    var metadata = ViewBag.Metadata as Clinic.Application.UI.UIMetadata;
    if (metadata != null)
    {
        ViewData["Title"] = metadata.Title;
        ViewData["ModuleName"] = metadata.ModuleName;
    }
    
    // Flatten payments
    var payments = Model
        .SelectMany(i => i.Payments.Where(p => !p.IsDeleted))
        .OrderByDescending(p => p.PaymentDate)
        .ToList();
}

<!-- Payment History -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Payment History</h2>
    </div>

    <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-success text-uppercase mb-0"><i class="bi bi-cash me-2"></i>Transactions</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Receipt #</th>
                            <th>Invoice #</th>
                            <th>Patient</th>
                            <th>Method</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!payments.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt display-4 mb-3 d-block"></i>
                                    <h5>No payment transactions found.</h5>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var payment in payments)
                            {
                                var invoice = payment.Invoice;
                                var patientName = invoice?.Appointment?.Patient?.FullName ?? "Unknown";
                                var formattedAmount = await CurrencyService.FormatAmountAsync(payment.Amount);

                                <tr>
                                    <td>@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold">@payment.ReceiptNumber</td>
                                    <td>
                                        <a href="/Billing/Appointment/@invoice?.AppointmentId/Invoice" class="text-decoration-none">
                                            @invoice?.InvoiceNumber
                                        </a>
                                    </td>
                                    <td>@patientName</td>
                                    <td><span class="badge bg-light text-dark border">@payment.PaymentMethod</span></td>
                                    <td class="text-end">
                                        <div class="text-success fw-bold">+@formattedAmount</div>
                                        @if (payment.Refunds != null && payment.Refunds.Any(r => !r.IsDeleted))
                                        {
                                            var refunded = payment.Refunds.Where(r => !r.IsDeleted).Sum(r => r.Amount);
                                            <div class="text-danger small">-@await CurrencyService.FormatAmountAsync(refunded) (Refunded)</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="/Billing/Appointment/@invoice?.AppointmentId/Invoice" class="btn btn-sm btn-outline-info" title="View Invoice">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Billing/Payment/@payment.Id/Allocate" class="btn btn-sm btn-outline-primary ms-1" title="Allocate Payment">
                                            <i class="bi bi-diagram-2"></i> Allocate
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" title="Refund Payment" data-bs-toggle="modal" data-bs-target="#refundModal-@payment.Id">
                                            <i class="bi bi-arrow-counterclockwise"></i> Refund
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (payments.Any())
                    {
                        var totalPayments = payments.Sum(p => p.Amount - (p.Refunds?.Where(r => !r.IsDeleted).Sum(r => r.Amount) ?? 0m));
                        var formattedTotal = await CurrencyService.FormatAmountAsync(totalPayments);
                        <tfoot class="table-light fw-bold text-success">
                            <tr>
                                <td colspan="5" class="text-end">Total Displayed Payments:</td>
                                <td class="text-end">+@formattedTotal</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var payment in payments)
{
    var refunded = payment.Refunds?.Where(r => !r.IsDeleted).Sum(r => r.Amount) ?? 0m;
    var refundable = payment.Amount - refunded;
    
    if (refundable > 0)
    {
        <div class="modal fade" id="refundModal-@payment.Id" tabindex="-1" aria-labelledby="refundModalLabel-@payment.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/Billing/Payment/@payment.Id/Refund" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="refundModalLabel-@payment.Id">Refund Payment: @payment.ReceiptNumber</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label text-muted">Original Payment Amount</label>
                                <div class="fw-bold">@await CurrencyService.FormatAmountAsync(payment.Amount)</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Already Refunded</label>
                                <div class="fw-bold text-danger">@await CurrencyService.FormatAmountAsync(refunded)</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted">Refundable Amount</label>
                                <div class="fw-bold text-success">@await CurrencyService.FormatAmountAsync(refundable)</div>
                            </div>
                            <hr />
                            <div class="mb-3">
                                <label class="form-label fw-bold">Refund Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">@await CurrencyService.GetCurrencySymbolAsync()</span>
                                    <input type="number" step="0.01" min="0.01" max="@refundable" name="Amount" class="form-control" required />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Reason</label>
                                <textarea name="Reason" class="form-control" rows="3" required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Process Refund</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
