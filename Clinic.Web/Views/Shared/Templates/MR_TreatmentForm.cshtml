@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Medical Record Treatment Form Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/MedicalRecord" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Chart</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 800px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-file-medical me-2"></i>Treatment Information</h5>
        </div>
        <div class="card-body p-4">
            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Patient</label>
                        <input type="text" class="form-control" value="John Smith (PT-2601001)" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Provider</label>
                        <select class="form-select">
                            <option>Dr. Alan</option>
                            <option selected>Dr. Emily Chen</option>
                        </select>
                    </div>
                    
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Date</label>
                        <input type="date" class="form-control" value="2026-07-31">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tooth Number</label>
                        <input type="text" class="form-control" value="14" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Surface</label>
                        <input type="text" class="form-control" placeholder="e.g. MOD">
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label fw-bold">Treatment</label>
                        <select class="form-select">
                            <option>Composite Filling</option>
                            <option selected>Root Canal Treatment</option>
                            <option>Extraction</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Clinical Notes</label>
                        <textarea class="form-control" rows="4" placeholder="Detailed clinical findings, procedure steps, and recommendations..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Status</label>
                        <select class="form-select">
                            <option>Planned</option>
                            <option selected>Completed</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Fee</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" value="450.00">
                        </div>
                    </div>
                </div>
                
                <hr class="my-4">
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-danger shadow-sm"><i class="bi bi-trash me-2"></i>Delete</button>
                    <div>
                        <a href="/MedicalRecord" class="btn btn-secondary shadow-sm">Cancel</a>
                        <button type="submit" class="btn btn-primary shadow-sm ms-2"><i class="bi bi-save me-2"></i>Save Treatment</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            
            // Simple Parity Validation
            const toothNo = document.querySelector("input[value='14']");
            const treatment = document.querySelector("select").value; // Treatment
            
            if (treatment === "") {
                alert("Please select a treatment.");
                return;
            }
            
            if (confirm("Are you sure you want to save this treatment record?")) {
                window.location.href = "/MedicalRecord/Chart/1";
            }
        });
    });
</script>
