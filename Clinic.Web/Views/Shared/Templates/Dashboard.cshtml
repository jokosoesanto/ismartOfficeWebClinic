@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Clinical Workspace Dashboard -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 fw-bold">Clinical Workspace</h2>
            <p class="text-muted mb-0">Overview of today's clinical operations</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2"><i class="bi bi-clock me-2"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <h6 class="text-muted fw-bold text-uppercase mb-3">Quick Actions</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/Appointment/Create" class="btn btn-primary shadow-sm"><i class="bi bi-calendar-plus me-2"></i>New Appointment</a>
                        <a href="/Patient/Create" class="btn btn-success shadow-sm"><i class="bi bi-person-plus me-2"></i>Register Patient</a>
                        <a href="/Billing/Create" class="btn btn-info text-white shadow-sm"><i class="bi bi-receipt me-2"></i>Process Payment</a>
                        <a href="/MedicalRecord" class="btn btn-secondary shadow-sm"><i class="bi bi-journal-medical me-2"></i>Odontogram</a>
                        <a href="/Patient" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-search me-2"></i>Search Patient</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Today's Schedule -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-event me-2"></i>Today's Schedule</h5>
                    <a href="/Appointment" class="btn btn-sm btn-link text-decoration-none">Open Scheduler <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Time</th>
                                    <th>Patient</th>
                                    <th>Provider</th>
                                    <th>Treatment/Reason</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">09:00 AM</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">JS</div>
                                            <div>
                                                <h6 class="mb-0">John Smith</h6>
                                                <small class="text-muted">#PT-2601001</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>Dr. Emily Chen</td>
                                    <td>Root Canal</td>
                                    <td><span class="badge bg-warning text-dark">Scheduled</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-in-right me-1"></i>Check-in</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">10:30 AM</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-info text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">MD</div>
                                            <div>
                                                <h6 class="mb-0">Maria Doe</h6>
                                                <small class="text-muted">#PT-2601054</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>Dr. Emily Chen</td>
                                    <td>Orthodontic Consult</td>
                                    <td><span class="badge bg-success">Confirmed</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-in-right me-1"></i>Check-in</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Waiting Patients -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-success mb-0"><i class="bi bi-people me-2"></i>Waiting Patients (2)</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 fw-bold">Sarah Connor</h6>
                                <p class="mb-0 text-muted small"><i class="bi bi-clock me-1"></i>Waiting for 15 mins (Dr. Alan)</p>
                            </div>
                            <a href="/MedicalRecord/Create" class="btn btn-sm btn-primary rounded-pill px-3">Seat</a>
                        </div>
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 fw-bold">Bruce Wayne</h6>
                                <p class="mb-0 text-muted small"><i class="bi bi-clock me-1"></i>Waiting for 5 mins (Dr. Chen)</p>
                            </div>
                            <a href="/MedicalRecord/Create" class="btn btn-sm btn-primary rounded-pill px-3">Seat</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Treatment & Outstanding Cases -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-danger mb-0"><i class="bi bi-clipboard2-pulse me-2"></i>Pending Treatments</h5>
                    <a href="/MedicalRecord/Pending" class="btn btn-sm btn-link text-decoration-none">View All</a>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-danger bg-opacity-10 text-danger rounded p-2 me-3"><i class="bi bi-tooth"></i></div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Implant Phase 2 (Tooth #4)</h6>
                                    <small class="text-muted">Patient: Clark Kent</small>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill">Resume</button>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <div class="bg-danger bg-opacity-10 text-danger rounded p-2 me-3"><i class="bi bi-bandaid"></i></div>
                                <div>
                                    <h6 class="mb-0 fw-bold">Braces Adjustment</h6>
                                    <small class="text-muted">Patient: Diana Prince</small>
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill">Resume</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Recent Payments / Receivables -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-info mb-0"><i class="bi bi-cash-coin me-2"></i>Recent Payments</h5>
                    <a href="/Billing" class="btn btn-sm btn-link text-decoration-none">Go to Billing</a>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-4 pb-3 border-bottom">
                        <div class="text-center w-50 border-end">
                            <h3 class="fw-bold text-dark mb-0">$1,240.00</h3>
                            <small class="text-muted text-uppercase fw-bold">Today's Collection</small>
                        </div>
                        <div class="text-center w-50">
                            <h3 class="fw-bold text-danger mb-0">$450.00</h3>
                            <small class="text-muted text-uppercase fw-bold">Outstanding (Today)</small>
                        </div>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-0 py-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-credit-card text-info me-3 fs-4"></i>
                                <div>
                                    <h6 class="mb-0">#INV-2026-001 (Credit Card)</h6>
                                    <small class="text-muted">10 mins ago - Peter Parker</small>
                                </div>
                            </div>
                            <span class="fw-bold text-success">+$250.00</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-0 py-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-cash text-success me-3 fs-4"></i>
                                <div>
                                    <h6 class="mb-0">#INV-2026-002 (Cash)</h6>
                                    <small class="text-muted">45 mins ago - Bruce Banner</small>
                                </div>
                            </div>
                            <span class="fw-bold text-success">+$150.00</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Recent Activity & Notifications -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted fw-bold text-uppercase mb-3"><i class="bi bi-activity me-2"></i>Recent System Activity & Notifications</h6>
                    <div class="alert alert-warning border-0 d-flex align-items-center mb-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                        <div>
                            <strong>Low Inventory Alert:</strong> Composite Resin (Shade A2) is below minimum threshold (2 units remaining). <a href="/Inventory" class="alert-link">Reorder now</a>.
                        </div>
                    </div>
                    <div class="alert alert-info border-0 d-flex align-items-center mb-0" role="alert">
                        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                        <div>
                            <strong>System Update:</strong> The ADA Claim Form template has been updated to the 2026 version.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
