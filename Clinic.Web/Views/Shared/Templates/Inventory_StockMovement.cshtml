@using Clinic.Domain.Entities.Operations
@model StockMovementReportDto

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Stock Movement & Status</h2>
        <div>
            <a href="/Inventory" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-1"></i> Back to Inventory</a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" action="/Inventory/StockMovement" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Date From</label>
                    <input type="date" class="form-control" name="DateFrom" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Date To</label>
                    <input type="date" class="form-control" name="DateTo" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Transaction Type</label>
                    <select class="form-select" name="TransactionType">
                        <option value="">All Types</option>
                        <option value="@((int)InventoryTransactionType.StockIn)" selected="@(Model.Filter.TransactionType == InventoryTransactionType.StockIn)">Stock In</option>
                        <option value="@((int)InventoryTransactionType.StockOut)" selected="@(Model.Filter.TransactionType == InventoryTransactionType.StockOut)">Stock Out</option>
                        <option value="@((int)InventoryTransactionType.AdjustmentIncrease)" selected="@(Model.Filter.TransactionType == InventoryTransactionType.AdjustmentIncrease)">Adjustment Increase</option>
                        <option value="@((int)InventoryTransactionType.AdjustmentDecrease)" selected="@(Model.Filter.TransactionType == InventoryTransactionType.AdjustmentDecrease)">Adjustment Decrease</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small fw-bold">Item</label>
                    <select class="form-select" name="InventoryItemId">
                        <option value="">All Items</option>
                        @foreach(var item in Model.AvailableItems)
                        {
                            <option value="@item.Id" selected="@(Model.Filter.InventoryItemId == item.Id)">@item.Code - @item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <a href="/Inventory/StockMovement" class="btn btn-light me-2">Clear Filter</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Section -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body">
                    <h6 class="card-title opacity-75">Total Items</h6>
                    <h3 class="mb-0 fw-bold">@Model.Summary.TotalItems</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body">
                    <h6 class="card-title opacity-75">Stock In</h6>
                    <h3 class="mb-0 fw-bold">@Model.Summary.TotalStockIn.ToString("N0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 bg-danger text-white h-100">
                <div class="card-body">
                    <h6 class="card-title opacity-75">Stock Out</h6>
                    <h3 class="mb-0 fw-bold">@Model.Summary.TotalStockOut.ToString("N0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-dark h-100">
                <div class="card-body">
                    <h6 class="card-title opacity-75">Adj Increase</h6>
                    <h3 class="mb-0 fw-bold">@Model.Summary.TotalAdjustmentIncrease.ToString("N0")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-secondary text-white h-100">
                <div class="card-body">
                    <h6 class="card-title opacity-75">Adj Decrease</h6>
                    <h3 class="mb-0 fw-bold">@Model.Summary.TotalAdjustmentDecrease.ToString("N0")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Stock Movement Transactions -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Stock Movements</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Date</th>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Notes</th>
                                    <th>Created By</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(!Model.Transactions.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">No transactions found for the selected filter.</td>
                                    </tr>
                                }
                                @foreach (var tx in Model.Transactions)
                                {
                                    <tr>
                                        <td class="text-nowrap">@tx.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <div class="fw-bold">@tx.ItemCode</div>
                                            <div class="small text-muted">@tx.ItemName</div>
                                        </td>
                                        <td>
                                            @{
                                                var badgeClass = "bg-secondary";
                                                if (tx.TransactionType == "StockIn" || tx.TransactionType == "OpeningBalance" || tx.TransactionType == "AdjustmentIncrease") badgeClass = "bg-success";
                                                else if (tx.TransactionType == "StockOut" || tx.TransactionType == "AdjustmentDecrease") badgeClass = "bg-danger";
                                            }
                                            <span class="badge @badgeClass">@tx.TransactionType</span>
                                        </td>
                                        <td class="text-end fw-bold">@tx.Quantity.ToString("N0")</td>
                                        <td class="small">@(string.IsNullOrEmpty(tx.Notes) ? "-" : tx.Notes)</td>
                                        <td class="small text-muted">@(string.IsNullOrEmpty(tx.CreatedBy) ? "-" : tx.CreatedBy)</td>
                                        <td>
                                            @if (tx.TransactionType == "StockIn")
                                            {
                                                <button class="btn btn-sm btn-outline-info" 
                                                        data-item="@tx.ItemName"
                                                        data-qty="@tx.Quantity.ToString("N0")"
                                                        data-supplier="@(tx.SupplierId.HasValue ? $"{tx.SupplierCode} — {tx.SupplierName}" : "Not specified")"
                                                        data-batch="@(!string.IsNullOrEmpty(tx.BatchNumber) ? tx.BatchNumber : "No Batch")"
                                                        data-expiry="@(tx.ExpiryDate.HasValue ? tx.ExpiryDate.Value.ToString("yyyy-MM-dd") : "No Expiry")"
                                                        data-date="@tx.Date.ToString("yyyy-MM-dd HH:mm")"
                                                        onclick="openTransactionDetail(this)" title="View Details">
                                                    <i class="bi bi-info-circle"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory Status (Current Stock) -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Inventory Status</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Current Stock</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(!Model.ItemStatuses.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">No items match filter.</td>
                                    </tr>
                                }
                                @foreach (var stat in Model.ItemStatuses)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@stat.Code</div>
                                            <div class="small text-muted">@stat.Name</div>
                                        </td>
                                        <td class="text-end fw-bold @(stat.Status == "In Stock" ? "text-success" : stat.Status == "Low Stock" ? "text-warning" : "text-danger")">
                                            @stat.CurrentStock.ToString("N0")
                                        </td>
                                        <td>
                                            @if (stat.Status == "In Stock")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">In Stock</span>
                                            }
                                            else if (stat.Status == "Low Stock")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Low Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Out of Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Transaction Detail Modal -->
<div class="modal fade" id="transactionDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Stock In Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th style="width: 35%" class="text-muted">Item</th>
                            <td class="fw-bold" id="tdDetailItem"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Transaction Type</th>
                            <td>Stock In</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Quantity</th>
                            <td id="tdDetailQty"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Supplier</th>
                            <td id="tdDetailSupplier"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Batch</th>
                            <td id="tdDetailBatch"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Expiry</th>
                            <td id="tdDetailExpiry"></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Date</th>
                            <td id="tdDetailDate"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openTransactionDetail(btn) {
        document.getElementById('tdDetailItem').innerText = btn.getAttribute('data-item');
        document.getElementById('tdDetailQty').innerText = btn.getAttribute('data-qty');
        document.getElementById('tdDetailSupplier').innerText = btn.getAttribute('data-supplier');
        document.getElementById('tdDetailBatch').innerText = btn.getAttribute('data-batch');
        document.getElementById('tdDetailExpiry').innerText = btn.getAttribute('data-expiry');
        document.getElementById('tdDetailDate').innerText = btn.getAttribute('data-date');
        
        var modal = new bootstrap.Modal(document.getElementById('transactionDetailModal'));
        modal.show();
    }
</script>
