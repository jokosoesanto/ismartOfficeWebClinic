@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Inventory List Template (Parity with frmInventoryList.cs) -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">Inventory Management</h2>
        <div>
            <a href="/Inventory/CreateItem" class="btn btn-primary shadow-sm"><i class="bi bi-box-seam me-1"></i> Add Item</a>
            <a href="/Inventory/CreateGroup" class="btn btn-outline-secondary shadow-sm ms-2"><i class="bi bi-folder-plus me-1"></i> Add Group</a>
        </div>
    </div>

    <div class="row g-4 h-100">
        <!-- TreeView for Inventory Groups -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Inventory Groups</h6>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush border rounded">
                        <a href="#" class="list-group-item list-group-item-action active fw-bold"><i class="bi bi-folder2-open me-2"></i>All Items</a>
                        <a href="#" class="list-group-item list-group-item-action ps-4"><i class="bi bi-folder me-2"></i>Dental Supplies</a>
                        <a href="#" class="list-group-item list-group-item-action ps-5 text-muted"><i class="bi bi-file-earmark me-2"></i>Composite Resins</a>
                        <a href="#" class="list-group-item list-group-item-action ps-5 text-muted"><i class="bi bi-file-earmark me-2"></i>Anesthetics</a>
                        <a href="#" class="list-group-item list-group-item-action ps-4"><i class="bi bi-folder me-2"></i>Office Supplies</a>
                        <a href="#" class="list-group-item list-group-item-action ps-4"><i class="bi bi-folder me-2"></i>Equipment</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ListView for Inventory Items -->
        <div class="col-md-9">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-muted text-uppercase mb-0">Items</h6>
                    <div class="input-group" style="width: 250px;">
                        <input type="text" class="form-control form-control-sm" placeholder="Search item...">
                        <button class="btn btn-outline-secondary btn-sm" type="button"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Item Code</th>
                                    <th>Description</th>
                                    <th>Group</th>
                                    <th class="text-end">Qty on Hand</th>
                                    <th>UoM</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">ITM-001</td>
                                    <td>Composite Resin (Shade A2)</td>
                                    <td>Dental Supplies / Composite Resins</td>
                                    <td class="text-end text-danger fw-bold">2</td>
                                    <td>Box</td>
                                    <td class="text-center">
                                        <a href="/Inventory/1" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">ITM-002</td>
                                    <td>Lidocaine 2%</td>
                                    <td>Dental Supplies / Anesthetics</td>
                                    <td class="text-end text-success fw-bold">45</td>
                                    <td>Vial</td>
                                    <td class="text-center">
                                        <a href="/Inventory/2" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
