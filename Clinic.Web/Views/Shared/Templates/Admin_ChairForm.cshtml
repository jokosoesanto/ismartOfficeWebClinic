@model Clinic.Application.UI.UIMetadata
@{
    var chairDto = Model.Data?.GetType().GetProperty("Chair")?.GetValue(Model.Data) as Clinic.Application.DTOs.MasterData.ChairDto;
    var isNew = chairDto == null || chairDto.Id == Guid.Empty;
    var locations = Model.Data?.GetType().GetProperty("Locations")?.GetValue(Model.Data) as IEnumerable<Clinic.Application.DTOs.MasterData.LocationDto>;
}

<!-- Admin Chair Form Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/Admin/Chairs" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Chairs</a>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-usb-drive me-2"></i>Chair Details</h5>
        </div>
        <div class="card-body p-4">
            <form method="post" action="/Admin/SaveChair">
                @if (!isNew)
                {
                    <input type="hidden" name="Id" value="@chairDto?.Id" />
                }
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Chair Code <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Code" required value="@chairDto?.Code">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Chair Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Name" required value="@chairDto?.Name">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Location <span class="text-danger">*</span></label>
                    <select class="form-select" name="LocationId" required>
                        <option value="">-- Select Location --</option>
                        @if (locations != null)
                        {
                            foreach (var l in locations)
                            {
                                if (chairDto?.LocationId == l.Id)
                                {
                                    <option value="@l.Id" selected>@l.ClinicName</option>
                                }
                                else
                                {
                                    <option value="@l.Id">@l.ClinicName</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea class="form-control" name="Description" rows="3">@chairDto?.Description</textarea>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="isActive" name="IsActive" value="true" @(isNew || chairDto!.IsActive ? "checked" : "")>
                    <label class="form-check-label fw-bold" for="isActive">Chair is Active</label>
                </div>
                
                <hr class="my-4">
                <div class="d-flex justify-content-end gap-2">
                    <a href="/Admin/Chairs" class="btn btn-secondary shadow-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-save me-2"></i>Save Chair</button>
                </div>
            </form>
        </div>
    </div>
</div>
