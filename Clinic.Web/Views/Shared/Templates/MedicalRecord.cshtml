@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- MedicalRecord Template -->
<div class="template-medical-record card shadow-sm h-100">
    <div class="card-header bg-white d-flex align-items-center p-3">
        <i class="bi bi-file-medical display-6 text-primary me-3"></i>
        <div>
            <h4 class="mb-0">Medical Record Placeholder</h4>
            <small class="text-muted">Patient clinical history and treatments</small>
        </div>
    </div>
    <div class="card-body p-4 bg-light text-center d-flex flex-column justify-content-center align-items-center text-muted" style="border: 2px dashed #ccc; margin: 15px;">
        <i class="bi bi-heart-pulse display-1 mb-3"></i>
        <h3>Clinical Data View</h3>
        <p>This template will host the patient's medical history, prescriptions, and diagnosis.</p>
    </div>
</div>
