@model Clinic.Application.UI.UIMetadata
@{
    var user = Model.Data as Clinic.Application.DTOs.Auth.UserDto;
}

<!-- Admin User Detail Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <div>
            <a href="/Admin/UserForm/@(user?.Id)" class="btn btn-primary shadow-sm me-2"><i class="bi bi-pencil me-1"></i> Edit User</a>
            <a href="/Admin/Users" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Users</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 text-center">
                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-inline-flex justify-content-center align-items-center mb-3 display-1" style="width: 150px; height: 150px;">
                        <i class="bi bi-person"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@(user?.DisplayName ?? user?.FullName)</h3>
                    <p class="text-muted mb-3 fs-5">@user?.Username</p>
                    
                    <div class="mb-4">
                        @if(user?.Roles != null)
                        {
                            foreach(var role in user.Roles)
                            {
                                <span class="badge bg-primary fs-6 me-1">@role</span>
                            }
                        }
                        @if (user?.IsActive == true)
                        {
                            <span class="badge bg-success fs-6">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Inactive</span>
                        }
                    </div>

                    <ul class="list-unstyled text-start mt-4 pt-3 border-top">
                        <li class="mb-3 d-flex justify-content-between">
                            <span class="text-muted fw-bold">Email:</span>
                            <span>@user?.Email</span>
                        </li>
                        <li class="mb-3 d-flex justify-content-between">
                            <span class="text-muted fw-bold">Phone:</span>
                            <span>@(user?.PhoneNumber ?? "-")</span>
                        </li>
                        <li class="mb-3 d-flex justify-content-between">
                            <span class="text-muted fw-bold">Primary Location:</span>
                            <span>@(string.IsNullOrEmpty(user?.PrimaryLocationName) ? "None" : user.PrimaryLocationName)</span>
                        </li>
                        <li class="mb-3 d-flex justify-content-between">
                            <span class="text-muted fw-bold">Last Login:</span>
                            <span>@(user?.LastLoginAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never")</span>
                        </li>
                    </ul>
                    
                    <form method="post" action="/Admin/ResetPassword/@user?.Id">
                        <button type="submit" class="btn btn-outline-danger w-100 mt-3" onclick="return confirm('Are you sure you want to reset the password for this user?');"><i class="bi bi-key me-1"></i> Reset Password</button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-7">
            <div class="card shadow-sm border-0 mb-4 border-start border-info border-5">
                <div class="card-body">
                    <h5 class="fw-bold text-info"><i class="bi bi-info-circle-fill me-2"></i> Provider Information</h5>
                    <div class="row mt-3">
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted fw-bold small text-uppercase">Specialty</p>
                            <p class="fw-bold">Orthodontist</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted fw-bold small text-uppercase">License Number</p>
                            <p class="fw-bold">DNT-9876543</p>
                        </div>
                        <div class="col-sm-6 mt-2">
                            <p class="mb-1 text-muted fw-bold small text-uppercase">Scheduler Color</p>
                            <p class="fw-bold"><span class="d-inline-block rounded-circle me-2" style="width: 15px; height: 15px; background-color: #ff9900;"></span> #ff9900</p>
                        </div>
                        <div class="col-sm-6 mt-2">
                            <p class="mb-1 text-muted fw-bold small text-uppercase">Default Chair</p>
                            <p class="fw-bold">Chair 2</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h6 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-shield-check me-2"></i>Effective Permissions</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush border rounded">
                        @if(user?.Permissions != null && user.Permissions.Any())
                        {
                            foreach(var perm in user.Permissions.OrderBy(p => p))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@perm</span>
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center text-muted bg-light">
                                <span>No explicit permissions</span>
                                <i class="bi bi-x-circle text-danger"></i>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
