@model Clinic.Application.UI.UIMetadata
@{
    
}

<!-- Inventory Item Form Template -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">@Model.Title</h2>
        <a href="/Inventory" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left me-2"></i>Back to Inventory</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-box me-2"></i>Item Details</h5>
        </div>
        <div class="card-body p-4">
            <form>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Item Code</label>
                        <input type="text" class="form-control" placeholder="Auto-generated or Manual">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Group</label>
                        <select class="form-select">
                            <option>Composite Resins</option>
                            <option>Anesthetics</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Description</label>
                        <input type="text" class="form-control" placeholder="Item Name">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Unit of Measure (UoM)</label>
                        <select class="form-select">
                            <option>Box</option>
                            <option>Pieces</option>
                            <option>Vial</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Minimum Safe Qty</label>
                        <input type="number" class="form-control" value="5">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Current Qty</label>
                        <input type="number" class="form-control" value="0" readonly>
                    </div>
                </div>
                
                <hr class="my-4">
                <div class="d-flex justify-content-end gap-2">
                    <a href="/Inventory" class="btn btn-secondary shadow-sm">Cancel</a>
                    <a href="/Inventory" class="btn btn-primary shadow-sm"><i class="bi bi-save me-2"></i>Save Item</a>
                </div>
            </form>
        </div>
    </div>
</div>
