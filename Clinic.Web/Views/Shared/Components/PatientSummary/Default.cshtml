<clinic-card title="Patient Profile" icon="bi-person-circle">
    <div class="row align-items-center">
        <div class="col-md-2 text-center">
            <i class="bi bi-person-bounding-box text-secondary" style="font-size: 4rem;"></i>
        </div>
        <div class="col-md-6">
            <h4 class="mb-1">John Doe <span class="badge bg-success ms-2">Active</span></h4>
            <p class="text-muted mb-1">ID: @ViewData["PatientId"] | DOB: 01/01/1990 (36 Yrs)</p>
            <p class="text-muted mb-0"><i class="bi bi-telephone"></i> 555-0101 | <i class="bi bi-envelope"></i> john.doe@example.com</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Book Appt</button>
            <button class="btn btn-outline-primary"><i class="bi bi-file-medical"></i> Medical Record</button>
        </div>
    </div>
</clinic-card>
