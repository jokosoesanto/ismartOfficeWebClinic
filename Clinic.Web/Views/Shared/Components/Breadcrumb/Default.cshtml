@model List<Clinic.Application.Navigation.NavigationItem>
<nav aria-label="breadcrumb">
    <ol class="breadcrumb m-0 bg-transparent">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            var isLast = i == Model.Count - 1;
            var isGroup = item.Children != null && item.Children.Count > 0;
            
            if (isLast)
            {
                <li class="breadcrumb-item active" aria-current="page">@item.BreadcrumbTitle</li>
            }
            else if (isGroup)
            {
                <li class="breadcrumb-item">@item.BreadcrumbTitle</li>
            }
            else
            {
                <li class="breadcrumb-item"><a href="@item.Route" class="text-decoration-none">@item.BreadcrumbTitle</a></li>
            }
        }
    </ol>
</nav>
