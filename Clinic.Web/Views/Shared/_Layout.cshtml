<!DOCTYPE html>
<html lang="en" data-theme="medical-blue">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iSmartOffice Clinic Web</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    
    <!-- Local Libraries -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
    
    <!-- Theme CSS -->
    <link rel="stylesheet" href="~/css/themes/themes.css" asp-append-version="true" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-brand p-3 border-bottom">
            <h5 class="m-0 text-primary"><i class="bi bi-heart-pulse-fill me-2"></i>iSmartOffice</h5>
        </div>

        <!-- Navigation ViewComponent -->
        @await Component.InvokeAsync("Sidebar")
    </nav>

    <!-- Header -->
    <header class="header bg-card d-flex justify-content-between align-items-center shadow-sm">
        <div class="d-flex align-items-center">
            <button class="btn btn-light me-3" id="sidebarToggle">
                <i class="bi bi-list fs-5"></i>
            </button>
            <!-- Breadcrumb ViewComponent -->
            @await Component.InvokeAsync("Breadcrumb")
        </div>

        <div class="header-right d-flex align-items-center">
            <!-- Search -->
            <div class="input-group me-3" style="width: 250px;">
                <input type="text" class="form-control" placeholder="Search..." aria-label="Search">
                <button class="btn btn-outline-secondary" type="button"><i class="bi bi-search"></i></button>
            </div>

            <!-- Notifications -->
            <div class="dropdown me-3">
                <button class="btn btn-light position-relative" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        3
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <h6 class="dropdown-header">Notifications</h6>
                    </li>
                    <li><a class="dropdown-item" href="#">New Appointment Booked</a></li>
                    <li><a class="dropdown-item" href="#">Stock Alert: Gloves</a></li>
                    <li><a class="dropdown-item" href="#">System Update</a></li>
                </ul>
            </div>

            <!-- Theme Switcher (Hidden) -->
            @* <div class="dropdown me-3">
                <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-palette"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" id="themeSwitcher">
                    <li><a class="dropdown-item" href="#" data-theme-val="medical-blue">Medical Blue</a></li>
                    <li><a class="dropdown-item" href="#" data-theme-val="medical-green">Medical Green</a></li>
                    <li><a class="dropdown-item" href="#" data-theme-val="corporate-indigo">Corporate Indigo</a></li>
                    <li><a class="dropdown-item" href="#" data-theme-val="navy-professional">Navy Professional</a></li>
                    <li><a class="dropdown-item" href="#" data-theme-val="dark-mode">Dark Mode</a></li>
                    <li><a class="dropdown-item" href="#" data-theme-val="minimal-light">Minimal Light</a></li>
                </ul>
            </div> *@
            
            <!-- Profile -->
            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle d-flex align-items-center" type="button"
                        data-bs-toggle="dropdown">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=0D8ABC&color=fff" alt="Profile"
                         class="rounded-circle me-2" width="32" height="32">
                    <span>Admin</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li>
                        <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                            <button type="submit"
                                    class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-card border-top"
            style="margin-left: var(--sidebar-width); transition: margin-left 0.3s ease;">
        <div class="container-fluid text-center">
            <span class="text-muted">&copy; 2026 - iSmartOffice Clinic Web</span>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Local Libraries -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- Site Scripts -->
    <script src="~/js/datatables-setup.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // Sidebar Toggle
            document.getElementById('sidebarToggle').addEventListener('click', function () {
                document.body.classList.toggle('sidebar-collapsed');
            });

            // Theme Switcher Logic (Disabled for Design Convergence Sprint)
            /*
            document.querySelectorAll('#themeSwitcher .dropdown-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const theme = this.getAttribute('data-theme-val');
                    document.documentElement.setAttribute('data-theme', theme);
                    localStorage.setItem('clinic-theme', theme);
                });
            });
        
            const savedTheme = localStorage.getItem('clinic-theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
            }
            */
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
