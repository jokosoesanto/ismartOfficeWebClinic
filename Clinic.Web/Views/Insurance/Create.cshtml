@model Clinic.Application.DTOs.MasterData.InsuranceCreateEditDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Create Insurance</h2>
            <p class="text-muted mb-0">Add a new insurance configuration to the system.</p>
        </div>
        <div>
            <a href="/Insurance" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold text-muted">Insurance Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control shadow-sm" placeholder="e.g. Blue Cross" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GroupId" class="form-label fw-semibold text-muted">Insurance Group <span class="text-danger">*</span></label>
                                <select asp-for="GroupId" class="form-select shadow-sm" asp-items="ViewBag.InsuranceGroups">
                                    <option value="">-- Select Group --</option>
                                </select>
                                <span asp-validation-for="GroupId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrimaryCoverage" class="form-label fw-semibold text-muted">Primary Coverage <span class="text-danger">*</span></label>
                            <input asp-for="PrimaryCoverage" class="form-control shadow-sm" placeholder="e.g. General Dental, Orthodontics" />
                            <span asp-validation-for="PrimaryCoverage" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OfficeAddress" class="form-label fw-semibold text-muted">Office Address</label>
                            <textarea asp-for="OfficeAddress" class="form-control shadow-sm" rows="3" placeholder="Full mailing address..."></textarea>
                            <span asp-validation-for="OfficeAddress" class="text-danger small"></span>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="ContactName" class="form-label fw-semibold text-muted">Contact Name</label>
                                <input asp-for="ContactName" class="form-control shadow-sm" />
                                <span asp-validation-for="ContactName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ContactNumber" class="form-label fw-semibold text-muted">Contact Number</label>
                                <input asp-for="ContactNumber" class="form-control shadow-sm" />
                                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ContactEmail" class="form-label fw-semibold text-muted">Contact Email</label>
                                <input asp-for="ContactEmail" class="form-control shadow-sm" type="email" />
                                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Remark" class="form-label fw-semibold text-muted">Remark</label>
                            <textarea asp-for="Remark" class="form-control shadow-sm" rows="3" placeholder="Additional notes..."></textarea>
                            <span asp-validation-for="Remark" class="text-danger small"></span>
                        </div>

                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body">
                                <h6 class="fw-semibold text-muted mb-3">System Information</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-3 mb-md-0">
                                        <div class="form-check form-switch mt-1">
                                            <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch">
                                            <label class="form-check-label ms-2" asp-for="IsActive">Active Record</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <small class="text-muted d-block"><i class="bi bi-info-circle me-1"></i>B2B ExtSys/ID fields are managed via API</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a href="/Insurance" class="btn btn-light shadow-sm me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-4">Create Insurance</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 d-none d-lg-block">
            <div class="card shadow-sm border-0 bg-primary-subtle text-primary">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-square me-2"></i>Insurance Setup</h5>
                    <p class="mb-2"><strong>Name:</strong> Ensure the name matches official documentation exactly.</p>
                    <p class="mb-2"><strong>Group:</strong> Required for standard billing categorization. Manage groups in Master References.</p>
                    <p class="mb-0"><strong>Primary Coverage:</strong> Helps front-desk identify which plans apply.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
