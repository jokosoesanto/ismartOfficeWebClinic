@model Clinic.Web.Models.DashboardViewModel
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<!-- Clinical Workspace Dashboard -->
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0 fw-bold">Clinical Workspace</h2>
            <p class="text-muted mb-0">Overview of today's clinical operations</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 p-2"><i class="bi bi-clock me-2"></i>@DateTime.Now.ToString("dd MMM yyyy")</span>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <h6 class="text-muted fw-bold text-uppercase mb-3">Quick Actions</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/Appointment/Create" class="btn btn-primary shadow-sm"><i class="bi bi-calendar-plus me-2"></i>New Appointment</a>
                        <a href="/Patient/Create" class="btn btn-success shadow-sm"><i class="bi bi-person-plus me-2"></i>Register Patient</a>
                        <a href="/MedicalRecord" class="btn btn-secondary shadow-sm"><i class="bi bi-journal-medical me-2"></i>Odontogram</a>
                        <a href="/Patient" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-search me-2"></i>Search Patient</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Today's Schedule -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-event me-2"></i>Today's Schedule</h5>
                    <a href="/Appointment" class="btn btn-sm btn-link text-decoration-none">Open Scheduler <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Time</th>
                                    <th>Patient</th>
                                    <th>Provider</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.TodaysAppointments.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <div class="mb-2"><i class="bi bi-calendar-x fs-1 text-light"></i></div>
                                            <h6>No appointments scheduled for today</h6>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var appointment in Model.TodaysAppointments)
                                    {
                                        var patientInitials = string.IsNullOrWhiteSpace(appointment.Patient?.FullName) ? "??" : (appointment.Patient.FullName.Length >= 2 ? appointment.Patient.FullName.Substring(0, 2).ToUpper() : appointment.Patient.FullName.ToUpper());
                                        var bgClass = appointment.Status == Clinic.Domain.Enums.AppointmentStatus.OnTime ? "bg-info" : "bg-primary";
                                        
                                        <tr>
                                            <td class="fw-bold">@appointment.StartTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="@bgClass text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">@patientInitials</div>
                                                    <div>
                                                        <h6 class="mb-0">@appointment.Patient?.FullName</h6>
                                                        <small class="text-muted">@appointment.Patient?.MRN</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@appointment.Doctor?.FullName</td>
                                            <td>
                                                @{
                                                    var statusBadge = "bg-secondary";
                                                    if (appointment.Status == Clinic.Domain.Enums.AppointmentStatus.Schedule) statusBadge = "bg-warning text-dark";
                                                    else if (appointment.Status == Clinic.Domain.Enums.AppointmentStatus.OnTime) statusBadge = "bg-info text-dark";
                                                    else if (appointment.Status == Clinic.Domain.Enums.AppointmentStatus.Completed) statusBadge = "bg-success";
                                                    else if (appointment.Status == Clinic.Domain.Enums.AppointmentStatus.Late) statusBadge = "bg-danger";
                                                }
                                                <span class="badge @statusBadge">@appointment.Status.ToString()</span>
                                            </td>
                                            <td>
                                                <a href="/Appointment/Details/@appointment.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>View</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Waiting Patients -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold text-success mb-0"><i class="bi bi-people me-2"></i>Waiting Patients (@Model.WaitingPatients.Count)</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        @if (!Model.WaitingPatients.Any())
                        {
                            <div class="list-group-item px-0 py-4 text-center border-0">
                                <div class="text-muted mb-2"><i class="bi bi-emoji-smile fs-2"></i></div>
                                <h6 class="text-muted mb-0">No patients currently waiting</h6>
                            </div>
                        }
                        else
                        {
                            foreach (var waiting in Model.WaitingPatients)
                            {
                                var waitTime = DateTime.UtcNow - waiting.UpdatedAt;
                                var mins = waitTime.HasValue ? (int)waitTime.Value.TotalMinutes : 0;
                                
                                <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 fw-bold">@waiting.Patient?.FullName</h6>
                                        <p class="mb-0 text-muted small"><i class="bi bi-clock me-1"></i>Waiting for @mins mins (Dr. @(waiting.Doctor?.FullName?.Split(' ').LastOrDefault() ?? waiting.Doctor?.FullName))</p>
                                    </div>
                                    <a href="/MedicalRecord/Chart/@waiting.PatientId?appointmentId=@waiting.Id" class="btn btn-sm btn-primary rounded-pill px-3">Open Chart</a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Payments / Receivables -->
        <div class="col-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-info mb-0"><i class="bi bi-cash-coin me-2"></i>Recent Payments</h5>
                    <a href="/Billing" class="btn btn-sm btn-link text-decoration-none">Go to Billing</a>
                </div>
                <div class="card-body">
                    <div class="mb-4 pb-3 border-bottom text-center">
                        <h3 class="fw-bold text-dark mb-0">@Model.FormattedTodaysCollection</h3>
                        <small class="text-muted text-uppercase fw-bold">Today's Collection</small>
                    </div>
                    <ul class="list-group list-group-flush">
                        @if (!Model.RecentPayments.Any())
                        {
                            <li class="list-group-item px-0 text-center border-0 py-4">
                                <div class="text-muted mb-2"><i class="bi bi-receipt fs-2"></i></div>
                                <h6 class="text-muted mb-0">No payments recorded today</h6>
                            </li>
                        }
                        else
                        {
                            foreach (var payment in Model.RecentPayments)
                            {
                                var iconClass = payment.PaymentMethod.Contains("Cash", StringComparison.OrdinalIgnoreCase) ? "bi-cash text-success" : "bi-credit-card text-info";
                                var minsAgo = (int)(DateTime.UtcNow - payment.PaymentDate).TotalMinutes;
                                var timeText = minsAgo < 60 ? $"{minsAgo} mins ago" : $"{minsAgo / 60} hours ago";

                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center border-0 py-2">
                                    <div class="d-flex align-items-center">
                                        <i class="bi @iconClass me-3 fs-4"></i>
                                        <div>
                                            <h6 class="mb-0">#@payment.ReceiptNumber (@payment.PaymentMethod)</h6>
                                            <small class="text-muted">@timeText - @(payment.Invoice?.Appointment?.Patient?.FullName ?? "Unknown")</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-success">+$@payment.Amount.ToString("N2")</span>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
