@model IEnumerable<Clinic.Application.DTOs.Operations.DoctorLeaveRequestDto>
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Doctor Leave</h2>
            <p class="text-muted mb-0">Manage doctor leave requests and schedules.</p>
        </div>
        <div>
            <a href="/DoctorLeave/Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Create Leave Request
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-semibold text-dark">No Leave Requests Found</h5>
                    <p class="text-muted">Get started by creating the first doctor leave request.</p>
                    <a href="/DoctorLeave/Create" class="btn btn-primary mt-2 shadow-sm">
                        <i class="bi bi-plus-lg me-2"></i>Create Leave Request
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="leaveTable" class="table table-hover align-middle mb-0" style="width:100%">
                        <thead class="table-light text-muted">
                            <tr>
                                <th>Doctor</th>
                                <th>Leave Dates</th>
                                <th>Days</th>
                                <th>Reason</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@item.DoctorName</td>
                                    <td>
                                        @if (item.LeaveDates.Any())
                                        {
                                            var sorted = item.LeaveDates.OrderBy(d => d).ToList();
                                            var firstDate = sorted.First();
                                            var lastDate = sorted.Last();
                                            @if (sorted.Count == 1)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">@firstDate.ToString("dd MMM yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">@firstDate.ToString("dd MMM") – @lastDate.ToString("dd MMM yyyy")</span>
                                                @if (sorted.Count > 2)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-html="true" data-bs-content="@string.Join("<br/>", sorted.Select(d => d.ToString("ddd, dd MMM yyyy")))" title="All Leave Dates">
                                                        <i class="bi bi-eye text-primary"></i>
                                                    </button>
                                                }
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">@item.LeaveDates.Count day@(item.LeaveDates.Count != 1 ? "s" : "")</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Reason))
                                        {
                                            <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.Reason">@item.Reason</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">—</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td class="text-end">
                                        <a href="/DoctorLeave/Edit/@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm ms-1" onclick="deleteLeave('@item.Id', '@(item.DoctorName?.Replace("'", "\\'"))')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function deleteLeave(id, doctorName) {
            if (confirm(`Are you sure you want to delete the leave request for '${doctorName}'?`)) {
                var form = $('#deleteForm');
                form.attr('action', '/DoctorLeave/Delete/' + id);
                form.submit();
            }
        }

        $(document).ready(function() {
            // Initialize popovers
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            popoverTriggerList.map(function (el) {
                return new bootstrap.Popover(el);
            });

            if (typeof $.fn.DataTable !== 'undefined') {
                // Initialize DataTable if available
                if (!$.fn.DataTable.isDataTable('#leaveTable')) {
                    $('#leaveTable').DataTable({
                        order: [[4, 'desc']],
                        pageLength: 15,
                        language: {
                            emptyTable: "No leave requests found"
                        }
                    });
                }
            }
        });
    </script>
}
