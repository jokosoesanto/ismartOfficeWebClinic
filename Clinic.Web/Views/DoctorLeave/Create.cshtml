@model Clinic.Application.DTOs.Operations.DoctorLeaveRequestDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Create Doctor Leave</h2>
            <p class="text-muted mb-0">Submit a new leave request for a doctor.</p>
        </div>
        <div>
            <a href="/DoctorLeave" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="leaveForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="DoctorId" class="form-label fw-semibold text-muted">Doctor <span class="text-danger">*</span></label>
                                <select asp-for="DoctorId" class="form-select shadow-sm" asp-items="ViewBag.Doctors">
                                    <option value="">-- Select Doctor --</option>
                                </select>
                                <span asp-validation-for="DoctorId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Reason" class="form-label fw-semibold text-muted">Reason</label>
                                <input asp-for="Reason" class="form-control shadow-sm" placeholder="e.g. Annual Leave, Personal" />
                                <span asp-validation-for="Reason" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">Leave Dates <span class="text-danger">*</span></label>
                            <small class="d-block text-muted mb-2">Click on any date to toggle it. You can select multiple dates.</small>
                            <div class="card shadow-sm border-0 border-top border-primary border-3">
                                <div class="card-body p-2">
                                    <div id="leaveCalendar"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div id="selectedDatesContainer">
                                <div id="noDatesMessage" class="text-muted fst-italic py-2">
                                    <i class="bi bi-info-circle me-1"></i>No dates selected yet. Click on dates in the calendar above to select them.
                                </div>
                                <div id="dateTagsContainer" class="d-flex flex-wrap gap-2"></div>
                            </div>
                            <div id="hiddenDatesContainer"></div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a href="/DoctorLeave" class="btn btn-light shadow-sm me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-4" id="submitBtn">Create Leave Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-none d-lg-block">
            <div class="card shadow-sm border-0 bg-primary-subtle text-primary">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-square me-2"></i>Leave Request Guide</h5>
                    <p class="mb-2"><strong>Multi-date:</strong> You can select multiple dates — consecutive or non-consecutive — in one request.</p>
                    <p class="mb-0"><strong>Duplicates:</strong> A doctor cannot have overlapping leave dates across requests.</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-3" id="dateSummaryCard" style="display:none;">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-calendar-check me-2"></i>Date Summary</h6>
                    <div id="dateSummaryList"></div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold text-muted">Total Days:</span>
                        <span class="fw-bold text-primary" id="totalDaysCount">0</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-3 border-start border-warning border-4" id="affectedAppointmentsCard" style="display:none;">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-warning-emphasis mb-2"><i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Affected Appointments</h6>
                    <p class="text-muted small mb-3">Existing appointments are affected by this leave.</p>
                    <div id="affectedAppointmentsList" class="small" style="max-height: 250px; overflow-y: auto;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Custom styles to make calendar background events look nice */
        .selected-date-bg {
            opacity: 0.3 !important; /* Adjust opacity for better visibility */
            cursor: pointer;
        }
        /* Make all days look clickable */
        .fc-daygrid-day {
            cursor: pointer;
        }
        .fc-daygrid-day:hover {
            background-color: rgba(0,0,0,0.03);
        }
        /* Calendar text should not look like hyperlinks */
        .fc-daygrid-day-number,
        .fc-col-header-cell-cushion {
            text-decoration: none !important;
            color: var(--bs-body-color) !important;
        }
        /* Current date circular highlight */
        .fc-day-today {
            background-color: transparent !important; /* Remove full cell highlight */
        }
        .fc-day-today .fc-daygrid-day-number {
            background-color: var(--bs-primary) !important;
            color: white !important;
            border-radius: 50%;
            min-width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 2px;
        }
        /* Disabled past dates */
        .fc-day-disabled {
            opacity: 0.5;
            background-color: rgba(0,0,0,0.02) !important;
        }
        .fc-day-disabled,
        .fc-day-disabled .fc-daygrid-day-number {
            cursor: not-allowed !important;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script>
        (function() {
            var selectedDates = [];
            var tagsContainer = document.getElementById('dateTagsContainer');
            var hiddenContainer = document.getElementById('hiddenDatesContainer');
            var noDatesMsg = document.getElementById('noDatesMessage');
            var summaryCard = document.getElementById('dateSummaryCard');
            var summaryList = document.getElementById('dateSummaryList');
            var totalDays = document.getElementById('totalDaysCount');
            var calendarEl = document.getElementById('leaveCalendar');
            var affectedCard = document.getElementById('affectedAppointmentsCard');
            var affectedList = document.getElementById('affectedAppointmentsList');
            var doctorSelect = document.getElementById('DoctorId');
            var calendar;

            function fetchAffectedAppointments() {
                var doctorId = doctorSelect.value;
                
                if (!doctorId || selectedDates.length === 0) {
                    affectedCard.style.display = 'none';
                    return;
                }

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                fetch('/DoctorLeave/GetAffectedAppointments?doctorId=' + doctorId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(selectedDates)
                })
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        affectedCard.style.display = '';
                        var html = '<ul class="list-group list-group-flush">';
                        data.forEach(function(appt) {
                            html += '<li class="list-group-item px-0 py-2 border-0 border-bottom bg-transparent">';
                            html += '<div class="d-flex justify-content-between align-items-center">';
                            html += '<div>';
                            html += '<div class="fw-bold text-dark">' + appt.date + ' &bull; ' + appt.time + '</div>';
                            html += '<div class="text-muted">' + appt.patient + ' <span class="ms-1 text-secondary">(Chair: ' + appt.chair + ')</span></div>';
                            html += '</div>';
                            html += '<div>';
                            html += '<a href="/Appointment/Edit/' + appt.id + '" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit Appointment"><i class="bi bi-pencil"></i></a>';
                            html += '<a href="/Appointment/Reassign/' + appt.id + '" target="_blank" class="btn btn-sm btn-outline-info shadow-sm ms-1" title="Reassign Doctor"><i class="bi bi-arrow-left-right"></i></a>';
                            html += '</div>';
                            html += '</div>';
                            html += '</li>';
                        });
                        html += '</ul>';
                        affectedList.innerHTML = html;
                    } else {
                        affectedCard.style.display = 'none';
                        affectedList.innerHTML = '';
                    }
                })
                .catch(error => {
                    console.error('Error fetching affected appointments:', error);
                });
            }

            doctorSelect.addEventListener('change', fetchAffectedAppointments);

            function formatDate(dateStr) {
                var d = new Date(dateStr + 'T00:00:00');
                var options = { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' };
                return d.toLocaleDateString('en-GB', options);
            }

            function toggleDate(dateStr) {
                var idx = selectedDates.indexOf(dateStr);
                if (idx !== -1) {
                    selectedDates.splice(idx, 1);
                } else {
                    selectedDates.push(dateStr);
                }
                selectedDates.sort();
                renderDates();
                if (calendar) {
                    calendar.refetchEvents();
                }
            }

            function removeDate(dateStr) {
                selectedDates = selectedDates.filter(function(d) { return d !== dateStr; });
                renderDates();
                if (calendar) {
                    calendar.refetchEvents();
                }
            }

            function renderDates() {
                tagsContainer.innerHTML = '';
                hiddenContainer.innerHTML = '';
                summaryList.innerHTML = '';

                if (selectedDates.length === 0) {
                    noDatesMsg.style.display = '';
                    summaryCard.style.display = 'none';
                } else {
                    noDatesMsg.style.display = 'none';
                    summaryCard.style.display = '';
                }

                for (var i = 0; i < selectedDates.length; i++) {
                    var d = selectedDates[i];

                    // Tag badge
                    var tag = document.createElement('span');
                    tag.className = 'badge bg-warning text-dark d-inline-flex align-items-center px-3 py-2 shadow-sm';
                    tag.style.fontSize = '0.85rem';
                    tag.innerHTML = '<i class="bi bi-calendar-date me-1"></i>' + formatDate(d) +
                        ' <button type="button" class="btn-close btn-close-sm ms-2" style="font-size:0.6rem;" data-date="' + d + '"></button>';

                    tag.querySelector('.btn-close').addEventListener('click', (function(dateVal) {
                        return function() { removeDate(dateVal); };
                    })(d));

                    tagsContainer.appendChild(tag);

                    // Hidden input for form submission
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'LeaveDates';
                    input.value = d;
                    hiddenContainer.appendChild(input);

                    // Summary list
                    var row = document.createElement('div');
                    row.className = 'd-flex justify-content-between mb-1';
                    row.innerHTML = '<small class="text-muted">' + (i + 1) + '.</small><small class="fw-semibold">' + formatDate(d) + '</small>';
                    summaryList.appendChild(row);
                }

                totalDays.textContent = selectedDates.length;
                fetchAffectedAppointments();
            }

            function getCalendarEvents(fetchInfo, successCallback, failureCallback) {
                var events = selectedDates.map(function(d) {
                    return {
                        start: d,
                        allDay: true,
                        display: 'background',
                        backgroundColor: 'var(--bs-primary)',
                        classNames: ['selected-date-bg']
                    };
                });
                successCallback(events);
            }

            // Handle form validation
            document.getElementById('leaveForm').addEventListener('submit', function(e) {
                if (selectedDates.length === 0) {
                    e.preventDefault();
                    alert('Please select at least one leave date.');
                }
            });

            // Initialize with any existing dates (for server-side re-render after validation failure)
            @if (Model.LeaveDates != null && Model.LeaveDates.Any())
            {
                @foreach (var date in Model.LeaveDates)
                {
                    <text>selectedDates.push('@date.ToString("yyyy-MM-dd")');</text>
                }
                <text>renderDates();</text>
            }

            // Initialize calendar
            document.addEventListener('DOMContentLoaded', function() {
                calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: ''
                    },
                    buttonText: {
                        today: 'Today'
                    },
                    height: 'auto',
                    selectable: false,
                    dayCellClassNames: function(arg) {
                        var today = new Date();
                        today.setHours(0, 0, 0, 0);
                        if (arg.date < today) {
                            return ['fc-day-disabled'];
                        }
                        return [];
                    },
                    dateClick: function(info) {
                        var today = new Date();
                        today.setHours(0, 0, 0, 0);
                        if (info.date < today) {
                            return; // Do nothing for past dates
                        }
                        toggleDate(info.dateStr);
                    },
                    events: getCalendarEvents
                });
                calendar.render();
            });
        })();
    </script>
}
