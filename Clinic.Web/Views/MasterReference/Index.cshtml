@model IEnumerable<string>
@{
    ViewData["Title"] = "Master References";
}

<div class="row">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0">Categories</h6>
            </div>
            <div class="list-group list-group-flush" id="categoryList">
                @foreach(var cat in Model)
                {
                    <a href="#" class="list-group-item list-group-item-action category-item" data-category="@cat">
                        @cat
                    </a>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0" id="selectedCategoryTitle">Select a Category</h5>
                <button class="btn btn-primary btn-sm" id="btnCreate" disabled>
                    <i class="fas fa-plus"></i> Create New
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered w-100 enterprise-grid" id="referenceTable">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Order</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded via Ajax -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="formModalContent">
            <!-- Form loaded here -->
        </div>
    </div>
</div>

<script>
    // TIER 2: Register advanced DataTable config BEFORE $(document).ready()
    window.EnterpriseDataTables.register('referenceTable', {
        columns: [
            { data: 'code' },
            { data: 'name' },
            { data: 'description' },
            { data: 'sortOrder' },
            { 
                data: 'isSystem',
                render: function(data) {
                    return data ? '<span class="badge bg-secondary">System</span>' : '<span class="badge bg-primary">Custom</span>';
                }
            },
            { 
                data: 'isActive',
                render: function(data) {
                    return data ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>';
                }
            },
            {
                data: 'id',
                orderable: false,
                render: function(data, type, row) {
                    var btns = '<button class="btn btn-sm btn-outline-secondary btn-edit" data-id="' + data + '"><i class="fas fa-edit"></i> Edit</button>';
                    if (!row.isSystem) {
                        btns += ' <button class="btn btn-sm btn-outline-danger btn-delete" data-id="' + data + '"><i class="fas fa-trash"></i> Delete</button>';
                    }
                    return btns;
                }
            }
        ]
    });
</script>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentCategory = '';
            var table = $('#referenceTable').DataTable();

            $('.category-item').on('click', function(e) {
                e.preventDefault();
                $('.category-item').removeClass('active');
                $(this).addClass('active');
                
                currentCategory = $(this).data('category');
                $('#selectedCategoryTitle').text(currentCategory + ' References');
                $('#btnCreate').prop('disabled', false);
                
                loadData();
            });

            function loadData() {
                if(!currentCategory) return;
                
                $.get('/MasterReference/GetList?category=' + currentCategory, function(res) {
                    table.clear();
                    table.rows.add(res.data);
                    table.draw();
                });
            }

            $('#btnCreate').click(function() {
                $.get('/MasterReference/Create?category=' + currentCategory, function(html) {
                    $('#formModalContent').html(html);
                    $('#formModal').modal('show');
                });
            });

            $('#referenceTable').on('click', '.btn-edit', function() {
                var id = $(this).data('id');
                $.get('/MasterReference/Edit/' + id, function(html) {
                    $('#formModalContent').html(html);
                    $('#formModal').modal('show');
                });
            });

            $('#referenceTable').on('click', '.btn-delete', function() {
                if (confirm('Are you sure you want to delete this master reference?')) {
                    var id = $(this).data('id');
                    $.post('/MasterReference/Delete/' + id, function() {
                        loadData();
                    }).fail(function(err) {
                        alert('Error: ' + err.responseText);
                    });
                }
            });

            $(document).on('submit', '#referenceForm', function(e) {
                e.preventDefault();
                var form = $(this);
                $.post(form.attr('action'), form.serialize())
                    .done(function() {
                        $('#formModal').modal('hide');
                        loadData();
                    })
                    .fail(function(err) {
                        alert('Error: ' + err.responseText);
                    });
            });
        });
    </script>
}

