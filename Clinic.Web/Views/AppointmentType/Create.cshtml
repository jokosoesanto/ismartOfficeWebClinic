@model Clinic.Application.DTOs.MasterData.AppointmentTypeCreateDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Create Appointment Type</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/AppointmentType">Appointment Types</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Create</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Code" class="form-label fw-bold">Code <span class="text-danger">*</span></label>
                        <input asp-for="Code" class="form-control" required />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayName" class="form-label fw-bold">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Complexity" class="form-label fw-bold">Complexity <span class="text-danger">*</span></label>
                        <select asp-for="Complexity" class="form-select" asp-items="Html.GetEnumSelectList<Clinic.Domain.Enums.AppointmentComplexity>()" required></select>
                        <span asp-validation-for="Complexity" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationInMinutes" class="form-label fw-bold">Duration (Minutes) <span class="text-danger">*</span></label>
                        <input asp-for="DurationInMinutes" type="number" min="1" max="1440" class="form-control" required />
                        <span asp-validation-for="DurationInMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    
                    <div class="col-md-12 mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="flexSwitchCheckChecked">
                            <label class="form-check-label fw-bold" for="flexSwitchCheckChecked">Active</label>
                        </div>
                    </div>
                </div>

                <hr class="mt-4 mb-4" />
                
                <div class="d-flex justify-content-end">
                    <a href="/AppointmentType" class="btn btn-light shadow-sm me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Create Appointment Type
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
