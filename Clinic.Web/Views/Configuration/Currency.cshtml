@using Clinic.Domain.Entities.System
@using Clinic.Application.Interfaces.Configuration
@inject ICurrencyService CurrencyService
@{
    ViewData["Title"] = "Application Currency Configuration";
    var currentCurrency = ViewBag.CurrentCurrency as string;
    var currencies = ViewBag.Currencies as List<MasterReference>;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold text-dark"><i class="bi bi-currency-exchange me-2 text-primary"></i>Application Currency</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-controller="Configuration" asp-action="UpdateCurrency" method="post">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label for="currencyCode" class="form-label fw-semibold">Currency</label>
                        <select class="form-select" id="currencyCode" name="currencyCode" required>
                            <option value="">-- Select Currency --</option>
                            @if (currencies != null)
                            {
                                foreach (var c in currencies)
                                {
                                    if (c.Code == currentCurrency)
                                    {
                                        <option value="@c.Code" selected>@c.Name (@c.Code)</option>
                                    }
                                    else
                                    {
                                        <option value="@c.Code">@c.Name (@c.Code)</option>
                                    }
                                }
                            }
                        </select>
                        <div class="form-text mt-2">
                            This currency will be used throughout the application for prices and monetary amounts.
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-save me-2"></i>Save Configuration
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
