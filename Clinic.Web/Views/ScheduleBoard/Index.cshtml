@{
    ViewData["Title"] = "Doctor Schedule Board";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Doctor Schedule</h2>
            <p class="text-muted mb-0">Manage doctor schedules across clinic locations.</p>
        </div>
        <div class="btn-group" role="group">
            <button type="button" id="btnListView" class="btn btn-primary active"><i class="bi bi-list-task me-1"></i> List View</button>
            <button type="button" id="btnCalendarView" class="btn btn-outline-primary"><i class="bi bi-calendar-month me-1"></i> Calendar View</button>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light rounded">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Date</label>
                    <input type="date" id="filterDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Clinic / Location</label>
                    <select id="filterLocation" class="form-select" asp-items="ViewBag.Locations">
                        <option value="">All Locations</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Specialty</label>
                    <select id="filterSpecialty" class="form-select" asp-items="ViewBag.Specialties">
                        <option value="">All Specialties</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">Availability</label>
                    <select id="filterAvailability" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Available">Available</option>
                        <option value="Leave">Leave</option>
                        <option value="Unavailable">Unavailable</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Not Scheduled">Not Scheduled</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 text-end">
                    <button type="button" id="btnReset" class="btn btn-secondary btn-sm"><i class="bi bi-x-circle me-1"></i> Reset Filters</button>
                    <button type="button" id="btnSearch" class="btn btn-primary btn-sm ms-2"><i class="bi bi-search me-1"></i> Apply Filters</button>
                </div>
            </div>
        </div>
    </div>

    <!-- List View -->
    <div id="listViewContainer" class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table id="scheduleTable" class="table table-hover align-middle w-100 enterprise-grid">
                    <thead class="table-light">
                        <tr>
                            <th>Doctor Name</th>
                            <th>Specialty</th>
                            <th>Clinic / Location</th>
                            <th>Chair</th>
                            <th>Day</th>
                            <th>Date</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Calendar View -->
    <div id="calendarViewContainer" class="card shadow-sm border-0 d-none">
        <div class="card-body">
            <div id="monthViewFilters" class="d-none mb-3 text-center">
                <div class="btn-group shadow-sm" role="group" aria-label="Month View Filters">
                    <input type="radio" class="btn-check month-filter" name="monthFilter" id="monthApptOnly" value="appt" autocomplete="off" checked>
                    <label class="btn btn-outline-primary btn-sm" for="monthApptOnly"><i class="bi bi-calendar-check me-1"></i> Appointments Only</label>
                  
                    <input type="radio" class="btn-check month-filter" name="monthFilter" id="monthSchedOnly" value="sched" autocomplete="off">
                    <label class="btn btn-outline-primary btn-sm" for="monthSchedOnly"><i class="bi bi-clock-history me-1"></i> Doctor Schedule Only</label>
                </div>
            </div>
            <div id="calendar"></div>
            <div id="customDayGrid" class="mt-3" style="display:none;">
                <div id="parallelBoard" class="d-flex flex-column gap-4"></div>
            </div>
        </div>
    </div>
    <!-- Appointment Detail Modal -->
    <div class="modal fade" id="appointmentDetailModal" tabindex="-1" aria-labelledby="appointmentDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title" id="appointmentDetailModalLabel"><i class="bi bi-calendar-check me-2"></i>Appointment Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Patient</small>
                        <div class="fs-5 fw-semibold text-dark" id="modalApptPatient"></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Date & Time</small>
                            <div class="text-dark fw-medium" id="modalApptTime"></div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Doctor</small>
                            <div class="text-dark fw-medium" id="modalApptDoctor"></div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Location</small>
                            <div class="text-dark fw-medium" id="modalApptLocation"></div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Chair</small>
                            <div class="text-dark fw-medium" id="modalApptChair"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Schedule Detail Modal -->
    <div class="modal fade" id="scheduleDetailModal" tabindex="-1" aria-labelledby="scheduleDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title text-dark" id="scheduleDetailModalLabel"><i class="bi bi-clock-history me-2 text-muted"></i>Doctor Schedule Capacity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Doctor</small>
                        <div class="fs-5 fw-semibold text-dark" id="modalSchedDoctor"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Capacity Time</small>
                            <div class="text-dark fw-medium" id="modalSchedTime"></div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Location</small>
                            <div class="text-dark fw-medium" id="modalSchedLocation"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Doctor Leave Detail Modal -->
    <div class="modal fade" id="leaveDetailModal" tabindex="-1" aria-labelledby="leaveDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 text-white" id="leaveDetailModalHeader">
                    <h5 class="modal-title" id="leaveDetailModalLabel"><i class="bi bi-airplane-fill me-2"></i>Doctor Leave</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Doctor</small>
                        <div class="fs-5 fw-semibold text-dark" id="modalLeaveDoctor"></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Date</small>
                            <div class="text-dark fw-medium" id="modalLeaveDate"></div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">Reason</small>
                            <div class="text-dark fw-medium" id="modalLeaveReason"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Prevent FC from adding borders to our custom transparent events */
    .fc-event.custom-ui-event {
        border: none !important;
        background: transparent !important;
        box-shadow: none !important;
    }
    
    /* ScheduleBoard Month View Filters */
    #calendar.month-mode-appt .doctor-schedule-event {
        display: none !important;
    }
    #calendar.month-mode-sched .appointment-event {
        display: none !important;
    }
    

    
    /* Hover effects for custom events */
    .fc-event.custom-ui-event:hover {
        opacity: 0.95;
        z-index: 99 !important;
    }
    
    /* Ensure month view cells allow proper overflow reading if needed */
    .fc-daygrid-event {
        white-space: normal !important;
        align-items: center;
    }
    
    /* Plain text weekday headers */
    .fc-col-header-cell-cushion {
        color: #495057 !important;
        text-decoration: none !important;
        text-transform: uppercase !important;
        font-weight: 600 !important;
        font-size: 0.85rem !important;
        cursor: default !important;
    }
    .fc-col-header-cell-cushion:hover {
        color: #495057 !important;
        text-decoration: none !important;
    }
    
    /* Plain text month dates (Requirement 08) */
    .fc-daygrid-day-number {
        color: #495057 !important;
        text-decoration: none !important;
        font-weight: 500 !important;
        cursor: default !important;
    }
    .fc-daygrid-day-number:hover {
        color: #495057 !important;
        text-decoration: none !important;
    }
    
    /* Icon-only view controls (Requirement 01) */
    .fc-toolbar .fc-button.fc-dayGridMonth-button,
    .fc-toolbar .fc-button.fc-timeGridDay-button {
        font-size: 0 !important;
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
        color: #6c757d !important;
        padding: 0.25rem 0.5rem !important;
    }
    .fc-toolbar .fc-button.fc-dayGridMonth-button i,
    .fc-toolbar .fc-button.fc-timeGridDay-button i {
        font-size: 1.25rem !important;
    }
    .fc-toolbar .fc-button.fc-dayGridMonth-button.fc-button-active,
    .fc-toolbar .fc-button.fc-timeGridDay-button.fc-button-active {
        color: #0d6efd !important;
        background-color: transparent !important;
    }
    .fc-toolbar .fc-button:not(.fc-button-active):hover {
        color: #495057 !important;
        background-color: transparent !important;
    }
</style>

@section Scripts {
    <!-- DataTables Export Libraries (Local) -->
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.min.js"></script>
    <script src="~/lib/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.print.min.js"></script>
    
    <!-- FullCalendar (Local) -->
    <script src="~/lib/fullcalendar/index.global.min.js"></script>

    <!-- SweetAlert2 (for AJAX callback notifications) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Helper function (shared by register config and calendar)
        function formatTime(timeSpan) {
            if (!timeSpan) return "-";
            var parts = timeSpan.split(':');
            if (parts.length >= 2) {
                return parts[0] + ":" + parts[1];
            }
            return timeSpan;
        }

        // TIER 2: Register advanced DataTable config BEFORE $(document).ready()
        window.EnterpriseDataTables.register('scheduleTable', {
            processing: true,
            serverSide: true,
            ajax: {
                url: "/ScheduleBoard/GetData",
                type: "POST",
                datatype: "json",
                data: function (d) {
                    d.locationId = $('#filterLocation').val();
                    d.specialtyId = $('#filterSpecialty').val();
                    d.date = $('#filterDate').val();
                    d.availability = $('#filterAvailability').val();
                }
            },
            columns: [
                { 
                    data: "doctorName", name: "DoctorName",
                    render: function(data, type, row) {
                        var color = row.doctorColor ? row.doctorColor : "#0d6efd";
                        var html = '<div class="d-flex align-items-center">' +
                                    '<div class="rounded-circle me-2" style="width:12px;height:12px;background-color:' + color + '"></div>' +
                                    '<div><span class="fw-bold d-block">' + data + '</span>';
                        if (row.isAppointment && row.patientName) {
                            html += '<span class="small text-muted"><i class="bi bi-person-fill"></i> Patient: ' + row.patientName + '</span>';
                        }
                        html += '</div></div>';
                        return html;
                    }
                },
                { data: "specialty", name: "Specialty" },
                { data: "locationName", name: "LocationName" },
                { data: "chair", name: "Chair" },
                { 
                    data: "dayName", name: "DayName",
                    render: function(data) {
                        return '<span class="badge bg-light text-dark border">' + data + '</span>';
                    }
                },
                { 
                    data: "specificDate", name: "SpecificDate",
                    render: function (data) {
                        if (!data) return "-";
                        var date = new Date(data);
                        return date.toLocaleDateString();
                    }
                },
                { 
                    data: "startTime", name: "StartTime",
                    render: function(data) {
                        return formatTime(data);
                    }
                },
                { 
                    data: "endTime", name: "EndTime",
                    render: function(data) {
                        return formatTime(data);
                    }
                },
                { 
                    data: "status", name: "Status",
                    render: function (data, type, row) {
                        if (row.isAppointment) {
                            if (row.appointmentStatus === 'Completed') {
                                return '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-check2-all me-1"></i> Completed Visit</span>';
                            }
                            return '<span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-calendar-check-fill me-1"></i> Appointment</span>';
                        }
                        if (data === "Available") return '<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i> Available</span>';
                        if (data === "Break") return '<span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-cup-hot-fill me-1"></i> Break</span>';
                        if (data === "Leave") return '<span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-dash-circle-fill me-1"></i> Leave</span>';
                        if (data === "Unavailable") return '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-slash-circle me-1"></i> Unavailable</span>';
                        if (data === "Not Scheduled") return '<span class="badge bg-light text-dark border"><i class="bi bi-calendar-x me-1"></i> Not Scheduled</span>';
                        if (data === "InSession") return '<span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-hospital me-1"></i> In Session</span>';
                        return '<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-x-circle-fill me-1"></i> Inactive</span>';
                    }
                }
            ],
            language: {
                emptyTable: "No schedules found matching the criteria"
            },
            order: [[4, "asc"]],
            dom: '<"d-flex justify-content-between align-items-center mb-3"Bf>rt<"d-flex justify-content-between align-items-center mt-3"ip>',
            buttons: [
                {
                    extend: 'excelHtml5',
                    className: 'btn btn-sm btn-outline-success',
                    text: '<i class="bi bi-file-earmark-excel me-1"></i> Excel',
                    exportOptions: { columns: ':visible' }
                },
                {
                    extend: 'pdfHtml5',
                    className: 'btn btn-sm btn-outline-danger',
                    text: '<i class="bi bi-file-earmark-pdf me-1"></i> PDF',
                    orientation: 'landscape',
                    pageSize: 'A4',
                    exportOptions: { columns: ':visible' },
                    customize: function (doc) {
                        if(doc.content && doc.content.length > 1 && doc.content[1].table) {
                            var colCount = doc.content[1].table.body[0].length;
                            doc.content[1].table.widths = Array(colCount).fill('*');
                        }
                    }
                },
                {
                    extend: 'print',
                    className: 'btn btn-sm btn-outline-primary',
                    text: '<i class="bi bi-printer me-1"></i> Print',
                    exportOptions: { columns: ':visible' },
                    customize: function (win) {
                        var filterText = 'Active Filters: ';
                        if ($('#filterLocation').val()) filterText += 'Location: ' + $('#filterLocation option:selected').text() + ' | ';
                        if ($('#filterSpecialty').val()) filterText += 'Specialty: ' + $('#filterSpecialty option:selected').text() + ' | ';
                        if ($('#filterDate').val()) filterText += 'Date: ' + $('#filterDate').val() + ' | ';
                        if ($('#filterAvailability').val()) filterText += 'Availability: ' + $('#filterAvailability option:selected').text();
                        
                        if (filterText === 'Active Filters: ') filterText = 'Active Filters: None';

                        $(win.document.body).css('font-size', '10pt');
                        $(win.document.body).find('table')
                            .addClass('compact')
                            .css('font-size', 'inherit');
                        
                        $(win.document.body).prepend(
                            '<div style="margin-bottom: 20px;">' +
                            '<h3><i class="bi bi-heart-pulse-fill"></i> iSmartOffice Clinic</h3>' +
                            '<p><strong>Date Printed:</strong> ' + new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString() + '</p>' +
                            '<p>' + filterText + '</p>' +
                            '<hr/></div>'
                        );
                        
                        var css = '@@page { size: landscape; }',
                            head = win.document.head || win.document.getElementsByTagName('head')[0],
                            style = win.document.createElement('style');
                        style.type = 'text/css';
                        style.media = 'print';
                        if (style.styleSheet){
                          style.styleSheet.cssText = css;
                        } else {
                          style.appendChild(win.document.createTextNode(css));
                        }
                        head.appendChild(style);
                    }
                }
            ],
            responsive: true
        });
    </script>

    <script>
        $(document).ready(function () {
            // Retrieve the already-initialized DataTable instance
            var table = $('#scheduleTable').DataTable();

            // Toggle Views
            $('#btnListView').click(function() {
                $(this).addClass('active').removeClass('btn-outline-primary').addClass('btn-primary');
                $('#btnCalendarView').removeClass('active').addClass('btn-outline-primary').removeClass('btn-primary');
                $('#listViewContainer').removeClass('d-none');
                $('#calendarViewContainer').addClass('d-none');
            });
            
            var calendarRendered = false;
            var calendar;

            $('#btnCalendarView').click(function() {
                $(this).addClass('active').removeClass('btn-outline-primary').addClass('btn-primary');
                $('#btnListView').removeClass('active').addClass('btn-outline-primary').removeClass('btn-primary');
                $('#listViewContainer').addClass('d-none');
                $('#calendarViewContainer').removeClass('d-none');
                
                if (!calendarRendered) {
                    var calendarEl = document.getElementById('calendar');
                    calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'dayGridMonth',
                        height: 'auto', // Allow internal height calculation without stretching
                        slotEventOverlap: true, // Allow appointments to overlap doctor schedules
                        allDaySlot: false, // Req 07
                        slotLabelFormat: { hour: '2-digit', minute: '2-digit', hour12: false }, // Req 06
                        eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false }, // Req 06
                        slotMinTime: '08:00:00', // Week View bounds
                        slotMaxTime: '18:00:00',
                        buttonText: {
                            today: 'Today'
                        },
                        headerToolbar: {
                            left: 'prev,next today',
                            center: 'title',
                            right: 'dayGridMonth,timeGridDay'
                        },
                        eventDrop: function(info) {
                            if (!info.event.extendedProps.isAppointment) {
                                info.revert();
                                return;
                            }
                            
                            var d = info.event.start;
                            var dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                            var startStr = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0') + ':00';
                            
                            var d2 = info.event.end;
                            var endStr = String(d2.getHours()).padStart(2, '0') + ':' + String(d2.getMinutes()).padStart(2, '0') + ':00';
                            
                            $.ajax({
                                url: '/Appointment/Reschedule',
                                type: 'POST',
                                data: {
                                    id: info.event.id,
                                    date: dateStr,
                                    startTime: startStr,
                                    endTime: endStr
                                },
                                success: function(res) {
                                    if(res.success) {
                                        Swal.fire({ icon: 'success', title: 'Success', text: 'Appointment rescheduled successfully.', timer: 3000, showConfirmButton: false, toast: true, position: 'top-end' });
                                        if (!$('#listViewContainer').hasClass('d-none')) {
                                            $('#scheduleTable').DataTable().ajax.reload();
                                        }
                                    } else {
                                        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to reschedule: ' + res.message, confirmButtonColor: '#dc3545' });
                                        info.revert();
                                    }
                                },
                                error: function() {
                                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to contact server to reschedule appointment.', confirmButtonColor: '#dc3545' });
                                    info.revert();
                                }
                            });
                        },
                        datesSet: function(info) {
                            if (info.view.type === 'timeGridDay') {
                                $('.fc-view-harness').hide();
                                $('#customDayGrid').show();
                                $('#monthViewFilters').addClass('d-none');
                                renderParallelBoard(info.startStr.split('T')[0]);
                            } else {
                                var wasHidden = $('.fc-view-harness').is(':hidden');
                                $('.fc-view-harness').show();
                                $('#customDayGrid').hide();
                                
                                if (info.view.type === 'dayGridMonth') {
                                    $('#monthViewFilters').removeClass('d-none');
                                    var mode = $('input[name="monthFilter"]:checked').val() || 'appt';
                                    $('#calendar').removeClass('month-mode-appt month-mode-sched').addClass('month-mode-' + mode);
                                } else {
                                    $('#monthViewFilters').addClass('d-none');
                                }
                                
                                if (wasHidden) {
                                    // Fix FullCalendar layout 0-height bug after showing the hidden harness
                                    setTimeout(function() {
                                        if (calendar) calendar.updateSize();
                                    }, 0);
                                }
                            }

                            // Inject icons for view buttons and initialize tooltips (Req 01)
                            $('.fc-dayGridMonth-button').html('<i class="bi bi-calendar-month"></i>').attr('title', 'Month view').attr('data-bs-toggle', 'tooltip');
                            $('.fc-timeGridDay-button').html('<i class="bi bi-calendar-day"></i>').attr('title', 'Day view').attr('data-bs-toggle', 'tooltip');
                            
                            var tooltipTriggerList = [].slice.call(document.querySelectorAll('.fc-toolbar-chunk [data-bs-toggle="tooltip"]'));
                            tooltipTriggerList.map(function (tooltipTriggerEl) {
                                var existing = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
                                if (!existing) return new bootstrap.Tooltip(tooltipTriggerEl);
                            });
                        },
                        events: function(fetchInfo, successCallback, failureCallback) {
                            $.ajax({
                                url: '/ScheduleBoard/GetCalendarData',
                                type: 'GET',
                                cache: false,
                                data: {
                                    start: fetchInfo.startStr,
                                    end: fetchInfo.endStr,
                                    locationId: $('#filterLocation').val(),
                                    specialtyId: $('#filterSpecialty').val(),
                                    availability: $('#filterAvailability').val()
                                },
                                success: function(data) {
                                    var events = [];
                                    var leaves = data.filter(function(d) { return d.status === 'DoctorLeave'; });

                                    data.forEach(function(item) {
                                        // Priority rule: exclude doctor schedule if doctor leave exists for same date
                                        if (!item.isAppointment && item.status !== 'DoctorLeave') {
                                            var dateOnly = item.eventStart.split('T')[0];
                                            var hasLeave = leaves.some(function(l) {
                                                return l.doctorId === item.doctorId && l.eventStart.split('T')[0] === dateOnly;
                                            });
                                            if (hasLeave) return; // Skip base schedule!
                                        }

                                        var title = item.isAppointment 
                                            ? item.patientName 
                                            : item.doctorName;
                                            
                                        events.push({
                                            id: item.id,
                                            title: title,
                                            start: item.eventStart,
                                            end: item.eventEnd,
                                            editable: item.isAppointment,
                                            backgroundColor: 'transparent',
                                            borderColor: 'transparent',
                                            className: 'custom-ui-event ' + (item.status === 'DoctorLeave' ? '' : (item.isAppointment ? 'appointment-event' : 'doctor-schedule-event')),
                                            extendedProps: {
                                                specialty: item.specialty,
                                                location: item.locationName,
                                                chair: item.chair,
                                                status: item.status,
                                                isAppointment: item.isAppointment,
                                                patientName: item.patientName,
                                                doctorName: item.doctorName,
                                                baseColor: item.color,
                                                appointmentStatus: item.appointmentStatus
                                            }
                                        });
                                    });
                                    successCallback(events);
                                },
                                error: function() {
                                    failureCallback();
                                }
                            });
                        },
                        eventContent: function(arg) {
                            var title = arg.event.title || '';
                            var props = arg.event.extendedProps;
                            var baseColor = props.baseColor || '#0d6efd';
                            
                            // Req 06: 24h format
                            var formatOpts = { hour: '2-digit', minute:'2-digit', hour12: false };
                            var sTime = arg.event.start ? arg.event.start.toLocaleTimeString([], formatOpts) : '';
                            var eTime = arg.event.end ? arg.event.end.toLocaleTimeString([], formatOpts) : '';
                            
                            var heightClass = arg.view.type === 'dayGridMonth' ? '' : ' h-100';
                            var html = '';

                            if (props.isAppointment) {
                                // Req 04 & 05
                                var intervalText = (sTime && eTime) ? '[' + sTime + '-' + eTime + ']' : '';
                                var displayTitle = title ? title + ' ' : '';
                                var finalContent = displayTitle + intervalText;
                                
                                if (props.appointmentStatus === 'Completed') {
                                    html = '<div class="w-100' + heightClass + ' rounded px-1 py-1 text-white overflow-hidden" style="background-color: #6c757d; font-size: 0.75rem; line-height: 1.2; border: 1px solid rgba(0,0,0,0.1); cursor: pointer; opacity: 0.85;" title="Completed Visit: ' + finalContent + '">' +
                                           '<i class="bi bi-check2-all me-1"></i>' + finalContent + '</div>';
                                } else {
                                    html = '<div class="w-100' + heightClass + ' rounded px-1 py-1 text-white overflow-hidden" style="background-color: ' + baseColor + '; font-size: 0.75rem; line-height: 1.2; border: 1px solid rgba(0,0,0,0.1); cursor: pointer;" title="' + finalContent + '">' +
                                           finalContent + '</div>';
                                }
                            } else if (props.status === 'DoctorLeave') {
                                // Doctor Leave visualization
                                var displayTitle = title ? title + ' - Leave ' : '';
                                var reason = props.patientName ? '(' + props.patientName + ')' : '';
                                var finalContent = displayTitle + reason;
                                
                                html = '<div class="w-100' + heightClass + ' rounded px-1 py-1 overflow-hidden" style="background-color: #f8d7da; border: 1px solid #f5c2c7; color: #842029; font-size: 0.75rem; font-weight: 600; cursor: pointer; opacity: 0.9;" title="' + finalContent + '">' +
                                       '<i class="bi bi-airplane-fill me-1"></i> ' + finalContent + '</div>';
                            } else {
                                // Req 02 & 03 (Doctor Schedule)
                                var intervalText = (sTime && eTime) ? '[' + sTime + ' - ' + eTime + ']' : '';
                                var displayTitle = title ? title + ' ' : '';
                                var finalContent = displayTitle + intervalText;
                                
                                html = '<div class="w-100' + heightClass + ' px-1 py-1 overflow-hidden" style="background-color: ' + baseColor + '26; border-left: 3px solid ' + baseColor + '; color: #495057; font-size: 0.75rem; font-weight: 600; cursor: pointer;" title="' + finalContent + '">' +
                                       finalContent + '</div>';
                            }
                            
                            return { html: html };
                        },
                        eventClick: function(arg) {
                            var props = arg.event.extendedProps;
                            var isAppt = props.isAppointment;
                            
                            // Format dates nicely in 24-hour (Req 06)
                            var dateOpts = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
                            var timeOpts = { hour: '2-digit', minute:'2-digit', hour12: false };
                            var dateOnlyString = arg.event.start.toLocaleDateString(undefined, dateOpts);
                            var timeString = dateOnlyString + ' ' + arg.event.start.toLocaleTimeString(undefined, timeOpts);
                            
                            if (arg.event.end) {
                                timeString += ' - ' + arg.event.end.toLocaleTimeString(undefined, timeOpts);
                            }
                            
                            if (isAppt) {
                                $('#modalApptPatient').text(props.patientName);
                                $('#modalApptDoctor').text(props.doctorName);
                                $('#modalApptTime').text(timeString);
                                $('#modalApptChair').text(props.chair !== "-" ? props.chair : "Not Assigned");
                                $('#modalApptLocation').text(props.location);
                                $('#appointmentDetailModal .modal-header').removeClass('bg-primary').css('background-color', props.baseColor).addClass('text-white');
                                var modal = new bootstrap.Modal(document.getElementById('appointmentDetailModal'));
                                modal.show();
                            } else if (props.status === 'DoctorLeave') {
                                $('#modalLeaveDoctor').text(props.doctorName);
                                $('#modalLeaveDate').text(dateOnlyString); // Leave is full day conceptually
                                $('#modalLeaveReason').text(props.patientName || "No reason provided"); // Reason is passed in PatientName field
                                $('#leaveDetailModal .modal-header').removeClass('bg-light').css('background-color', '#dc3545'); // Red theme for leave
                                var modal = new bootstrap.Modal(document.getElementById('leaveDetailModal'));
                                modal.show();
                            } else {
                                $('#modalSchedDoctor').text(props.doctorName);
                                $('#modalSchedTime').text(timeString);
                                $('#modalSchedLocation').text(props.location);
                                $('#scheduleDetailModal .modal-header').removeClass('bg-light').css('background-color', props.baseColor + '26').addClass('text-dark');
                                var modal = new bootstrap.Modal(document.getElementById('scheduleDetailModal'));
                                modal.show();
                            }
                        }
                    });
                    calendar.render();
                    calendarRendered = true;
                } else {
                    calendar.refetchEvents();
                }
            });

            function renderParallelBoard(targetDate) {
                var container = $('#parallelBoard');
                container.html('<div class="text-center p-5"><div class="spinner-border text-primary" role="status"></div></div>');
                
                targetDate = targetDate || $('#filterDate').val() || new Date().toISOString().split('T')[0];
                var locationId = $('#filterLocation').val();
                
                // Fetch chairs for the location
                $.ajax({
                    url: '/ScheduleBoard/GetLocationChairs',
                    type: 'GET',
                    cache: false,
                    data: { locationId: locationId },
                    success: function(chairs) {
                        
                        $.ajax({
                            url: '/ScheduleBoard/GetCalendarData',
                            type: 'GET',
                            cache: false,
                            data: {
                                start: targetDate,
                                end: targetDate,
                                locationId: locationId,
                                specialtyId: $('#filterSpecialty').val(),
                                availability: $('#filterAvailability').val()
                            },
                            success: function(events) {
                                container.empty();
                                
                                var appointments = events.filter(d => d.isAppointment);
                                
                                // Group appointments by chair
                                var chairAppts = {};
                                // Group chairs by location
                                var locGroups = {};
                                chairs.forEach(function(c) {
                                    if (!locGroups[c.locationName]) locGroups[c.locationName] = [];
                                    locGroups[c.locationName].push(c);
                                    chairAppts[c.name] = [];
                                });
                                
                                appointments.forEach(function(item) {
                                    var chairName = item.chair && item.chair !== '-' ? item.chair : null;
                                    if (chairName && chairAppts[chairName] !== undefined) {
                                        chairAppts[chairName].push(item);
                                    }
                                });
                                
                                var minMinutes = 8 * 60; // 08:00
                                var maxMinutes = 17 * 60; // 17:00
                                var pixelsPerMinute = 1.2; // Compact time density
                                var gridPaddingTop = 20; // Prevent top label cutoff
                                var gridPaddingBottom = 20; // Sufficient bottom spacing
                                var gridHeightPx = ((maxMinutes - minMinutes) * pixelsPerMinute) + gridPaddingTop + gridPaddingBottom;
                                
                                var docHtml = '<div class="d-flex bg-white shadow-sm rounded border overflow-hidden">';
                                
                                // Time Column (Vertical)
                                docHtml += '<div style="width: 80px; flex-shrink: 0;" class="border-end bg-light">';
                                docHtml += '<div style="height: 50px;" class="border-bottom p-2 text-center text-muted fw-bold d-flex align-items-center justify-content-center bg-white sticky-top z-3">Time</div>';
                                docHtml += '<div class="position-relative" style="height: ' + gridHeightPx + 'px;">';
                                
                                for(var h = 8; h <= 17; h++) {
                                    var topPx = ((h * 60) - minMinutes) * pixelsPerMinute + gridPaddingTop;
                                    docHtml += '<div class="position-absolute w-100 text-center text-muted" style="top: ' + topPx + 'px; margin-top: -10px; font-size: 0.75rem;">' + String(h).padStart(2,'0') + ':00</div>';
                                }
                                docHtml += '</div></div>';
                                
                                // Chairs Container (Horizontal)
                                docHtml += '<div class="d-flex flex-grow-1 overflow-auto">';
                                
                                if (chairs.length === 0) {
                                    docHtml += '<div class="p-5 text-center text-muted w-100">No chairs found for the selected location.</div>';
                                } else {
                                    Object.keys(locGroups).sort().forEach(function(locName) {
                                        var locChairs = locGroups[locName];
                                        
                                        docHtml += '<div class="d-flex flex-column border-end">';
                                        // Location Header
                                        docHtml += '<div class="border-bottom p-1 text-center fw-bold text-white bg-secondary sticky-top z-3 d-flex align-items-center justify-content-center text-truncate" style="height: 25px; font-size: 0.8rem;" title="' + locName + '">' + locName + '</div>';
                                        
                                        docHtml += '<div class="d-flex flex-grow-1">';
                                        locChairs.forEach(function(chair) {
                                            var chairName = chair.name;
                                            docHtml += '<div style="min-width: 250px; flex: 1;" class="border-end position-relative">';
                                            // Chair Header
                                            docHtml += '<div style="height: 25px;" class="border-bottom p-1 text-center fw-bold text-dark bg-light sticky-top z-3 d-flex align-items-center justify-content-center text-truncate" title="' + chairName + '">' + chairName + '</div>';
                                            
                                            // Grid and Appointments
                                            docHtml += '<div class="position-relative" style="height: ' + gridHeightPx + 'px;">';
                                            
                                            // Background lines
                                            for(var h = 8; h <= 17; h++) {
                                                var topPx = ((h * 60) - minMinutes) * pixelsPerMinute + gridPaddingTop;
                                                docHtml += '<div class="position-absolute w-100" style="top: ' + topPx + 'px; border-bottom: 1px solid #f0f0f0;"></div>';
                                            }
                                            
                                            // Events
                                            chairAppts[chairName].forEach(function(item) {
                                                var startDt = new Date(item.eventStart);
                                                var endDt = new Date(item.eventEnd);
                                                var startMins = startDt.getHours() * 60 + startDt.getMinutes();
                                                var endMins = endDt.getHours() * 60 + endDt.getMinutes();
                                                
                                                if (endMins <= startMins) endMins = startMins + 30; // Min visual fallback
                                                
                                                var visualStart = Math.max(startMins, minMinutes);
                                                var visualEnd = Math.min(endMins, maxMinutes);
                                                var duration = visualEnd - visualStart;
                                                
                                                if (duration > 0 && visualEnd > minMinutes && visualStart < maxMinutes) {
                                                    var topPx = (visualStart - minMinutes) * pixelsPerMinute + gridPaddingTop;
                                                    var heightPx = duration * pixelsPerMinute;
                                                    
                                                    var formatOpts = { hour: '2-digit', minute:'2-digit', hour12: false };
                                                    var sTime = startDt.toLocaleTimeString([], formatOpts);
                                                    var eTime = endDt.toLocaleTimeString([], formatOpts);
                                                    
                                                    var bgClass = item.appointmentStatus === 'Completed' ? 'bg-secondary' : 'bg-primary';
                                                    var docColor = item.color || '#0d6efd';
                                                    var apptTypeStr = item.appointmentTypeName || 'Appointment';
                                                    
                                                    docHtml += '<div class="position-absolute w-100 px-1 custom-appt" style="top: ' + topPx + 'px; height: ' + heightPx + 'px; z-index: 2;" ' +
                                                               'data-props=\'' + JSON.stringify(item).replace(/'/g, "&#39;") + '\'>' +
                                                               '<div class="rounded shadow-sm p-1 text-white overflow-hidden h-100" style="background-color: ' + docColor + '; font-size: 0.75rem; line-height: 1.15; border: 1px solid rgba(0,0,0,0.1); cursor: pointer;" ' +
                                                               'title="' + item.patientName + ' (' + sTime + ' - ' + eTime + ')\nType: ' + apptTypeStr + '\nDoctor: ' + item.doctorName + '">' +
                                                               '<div class="fw-bold text-truncate">' + item.patientName + '</div>' +
                                                               '<div class="text-truncate fw-semibold" style="font-size: 0.7rem; opacity: 0.9;">' + apptTypeStr + '</div>' +
                                                               '<div class="opacity-75 text-truncate" style="font-size: 0.65rem;">' + sTime + ' - ' + eTime + '</div>' +
                                                               '</div></div>';
                                                }
                                            });
                                            
                                            docHtml += '</div></div>';
                                        });
                                        docHtml += '</div></div>';
                                    });
                                }
                                
                                docHtml += '</div></div>';
                                container.append(docHtml);
                                
                                // Bind click event
                                $('.custom-appt').click(function() {
                                    var props = JSON.parse($(this).attr('data-props').replace(/&#39;/g, "'"));
                                    var startDt = new Date(props.eventStart);
                                    var endDt = new Date(props.eventEnd);
                                    
                                    var dateOpts = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
                                    var timeOpts = { hour: '2-digit', minute:'2-digit', hour12: false };
                                    var dateOnlyString = startDt.toLocaleDateString(undefined, dateOpts);
                                    var timeString = dateOnlyString + ' ' + startDt.toLocaleTimeString(undefined, timeOpts) + ' - ' + endDt.toLocaleTimeString(undefined, timeOpts);
                                    
                                    $('#modalApptPatient').text(props.patientName);
                                    $('#modalApptDoctor').text(props.doctorName);
                                    $('#modalApptTime').text(timeString);
                                    $('#modalApptChair').text(props.chair !== "-" ? props.chair : "Not Assigned");
                                    $('#modalApptLocation').text(props.locationName || props.location);
                                    $('#appointmentDetailModal .modal-header').removeClass('bg-primary').css('background-color', props.color || '#0d6efd').addClass('text-white');
                                    var modal = new bootstrap.Modal(document.getElementById('appointmentDetailModal'));
                                    modal.show();
                                });
                                
                            },
                            error: function() {
                                container.html('<div class="alert alert-danger border-0 shadow-sm"><i class="bi bi-exclamation-triangle me-2"></i>Failed to load parallel schedule.</div>');
                            }
                        });
                    },
                    error: function() {
                        container.html('<div class="alert alert-danger border-0 shadow-sm"><i class="bi bi-exclamation-triangle me-2"></i>Failed to load chairs for location.</div>');
                    }
                });
            }

            $('#btnSearch').click(function () {
                table.ajax.reload();
                if (calendarRendered) calendar.refetchEvents();
                if (!$('#parallelViewContainer').hasClass('d-none')) renderParallelBoard();
            });

            $('#btnReset').click(function () {
                $('#filterLocation').val('');
                $('#filterSpecialty').val('');
                $('#filterDate').val('');
                $('#filterAvailability').val('');
                table.ajax.reload();
                if (calendarRendered) calendar.refetchEvents();
                if (!$('#parallelViewContainer').hasClass('d-none')) renderParallelBoard();
            });
            
            // Month View Filter Switch logic
            $(document).on('change', '.month-filter', function() {
                var mode = $('input[name="monthFilter"]:checked').val();
                $('#calendar').removeClass('month-mode-appt month-mode-sched month-mode-current').addClass('month-mode-' + mode);
            });
        });
    </script>
}

