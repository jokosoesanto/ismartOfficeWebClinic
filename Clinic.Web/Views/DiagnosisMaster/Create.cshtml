@model Clinic.Application.DTOs.MasterData.DiagnosisMasterCreateDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Create Diagnosis</h2>
            <p class="text-muted mb-0">Add a new clinical diagnosis code to the system.</p>
        </div>
        <div>
            <a href="/DiagnosisMaster" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="DiagnosisCode" class="form-label fw-semibold text-muted">Diagnosis Code <span class="text-danger">*</span></label>
                                <input asp-for="DiagnosisCode" class="form-control shadow-sm" placeholder="e.g. K02.1" />
                                <span asp-validation-for="DiagnosisCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="DiagnosisName" class="form-label fw-semibold text-muted">Diagnosis Name <span class="text-danger">*</span></label>
                                <input asp-for="DiagnosisName" class="form-control shadow-sm" placeholder="e.g. Caries of dentine" />
                                <span asp-validation-for="DiagnosisName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-muted">Description</label>
                            <textarea asp-for="Description" class="form-control shadow-sm" rows="3" placeholder="Additional clinical notes or context..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body">
                                <h6 class="fw-semibold text-muted mb-3">System Information</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-3 mb-md-0">
                                        <div class="form-check form-switch mt-1">
                                            <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch">
                                            <label class="form-check-label ms-2" asp-for="IsActive">Active Record</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a href="/DiagnosisMaster" class="btn btn-light shadow-sm me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-4">Create Diagnosis</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 d-none d-lg-block">
            <div class="card shadow-sm border-0 bg-primary-subtle text-primary">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-square me-2"></i>Diagnosis Setup</h5>
                    <p class="mb-2"><strong>Code:</strong> Should ideally match standard coding systems like ICD-10 (e.g., K02.1).</p>
                    <p class="mb-2"><strong>Name:</strong> The formal medical name of the diagnosis.</p>
                    <p class="mb-0"><strong>Status:</strong> Inactive diagnoses will not appear in the encounter lookup list.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
