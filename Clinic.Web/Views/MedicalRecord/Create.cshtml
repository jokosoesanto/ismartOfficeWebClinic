@model Clinic.Application.DTOs.Operations.AppointmentTreatmentDto

@{
    Layout = "_Layout";
    var metadata = ViewBag.Metadata as Clinic.Application.UI.UIMetadata;
    ViewData["Title"] = metadata?.Title ?? "Add Treatment";
    var treatmentItems = ViewBag.TreatmentItems as IEnumerable<Clinic.Application.DTOs.MasterData.TreatmentCatalogDto>;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0 text-gray-800">@ViewData["Title"]</h2>
                    <p class="text-muted mb-0">Record a new treatment for the appointment.</p>
                </div>
                <a href="@Url.Action("Index", "Appointment")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Appointments
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-images me-2"></i>Interactive Chart</h5>
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm active" id="btnAdultAdult" onclick="odo.setMode(true); this.classList.add('active'); document.getElementById('btnChildChild').classList.remove('active');">Adult</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnChildChild" onclick="odo.setMode(false); this.classList.add('active'); document.getElementById('btnAdultAdult').classList.remove('active');">Child</button>
                    </div>
                </div>
                
                <!-- Odontogram Toolbar -->
                <div class="bg-light border-top border-bottom p-2 mt-3 d-flex justify-content-between align-items-center">
                    <div class="text-muted small px-2">
                        <i class="bi bi-info-circle me-1"></i> Click on a tooth surface to select it.
                    </div>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="odo.clearSelection(); document.getElementById('SiteNumber').value = ''; document.getElementById('SiteDetail').value = '';"><i class="bi bi-x-circle"></i> Clear Selection</button>
                    </div>
                </div>

                <!-- SVG Container -->
                <div class="card-body bg-white m-0 p-3 overflow-auto" style="min-height: 400px;" id="odontogramContainer">
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="mb-0 text-primary"><i class="bi bi-clipboard2-pulse me-2"></i>Treatment Details</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" asp-route-appointmentId="@Model.AppointmentId" method="post">
                        <input type="hidden" asp-for="AppointmentId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="TreatmentItemId" class="form-label fw-semibold">Treatment Catalog <span class="text-danger">*</span></label>
                                <select asp-for="TreatmentItemId" class="form-select form-select-lg" required>
                                    <option value="">-- Select Treatment --</option>
                                    @if (treatmentItems != null)
                                    {
                                        foreach (var item in treatmentItems)
                                        {
                                            <option value="@item.Id">@item.TreatmentCode - @item.TreatmentName (Default Price: @item.DefaultPrice)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="TreatmentItemId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="ActualPrice" class="form-label fw-semibold">Actual Price <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ActualPrice" class="form-control" type="number" step="0.01" min="0" required />
                                </div>
                                <span asp-validation-for="ActualPrice" class="text-danger small"></span>
                                <div class="form-text">The final charged price for this treatment.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SiteNumber" class="form-label fw-semibold text-primary">Selected Tooth</label>
                                <input asp-for="SiteNumber" class="form-control border-primary fw-bold text-primary" placeholder="e.g. 11, 24" readonly />
                                <span asp-validation-for="SiteNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SiteDetail" class="form-label fw-semibold text-primary">Surface / Detail</label>
                                <input asp-for="SiteDetail" class="form-control border-primary fw-bold text-primary" placeholder="e.g. M, B, O" />
                                <span asp-validation-for="SiteDetail" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Remark" class="form-label fw-semibold">Clinical Note / Remarks</label>
                                <textarea asp-for="Remark" class="form-control" rows="4" placeholder="Enter clinical findings..."></textarea>
                                <span asp-validation-for="Remark" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                                <i class="bi bi-save me-2"></i>Save Treatment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Treatment History Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="mb-0 text-primary"><i class="bi bi-clock-history me-2"></i>Treatment History</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.ExistingTreatments != null && ((IEnumerable<Clinic.Application.DTOs.Operations.AppointmentTreatmentDto>)ViewBag.ExistingTreatments).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Treatment</th>
                                        <th>Tooth</th>
                                        <th>Surface</th>
                                        <th>Price</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var t in (IEnumerable<Clinic.Application.DTOs.Operations.AppointmentTreatmentDto>)ViewBag.ExistingTreatments)
                                    {
                                        <tr>
                                            <td>@t.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td class="fw-semibold">@t.TreatmentItemName</td>
                                            <td>@t.SiteNumber</td>
                                            <td>@t.SiteDetail</td>
                                            <td>$@t.ActualPrice.ToString("F2")</td>
                                            <td class="text-muted small">@t.Remark</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">No treatments recorded yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/odontogram.js"></script>
    <script>
        let odo;
        document.addEventListener("DOMContentLoaded", function () {
            odo = new Odontogram("odontogramContainer");
            
            odo.onSelectSurface = function(toothId, surfaceId) {
                document.getElementById('SiteNumber').value = toothId;
                document.getElementById('SiteDetail').value = surfaceId;
            };

            @if (ViewBag.ExistingTreatments != null)
            {
                <text>
                const existingTreatments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExistingTreatments));
                odo.loadState(existingTreatments);
                </text>
            }
        });
    </script>
}
