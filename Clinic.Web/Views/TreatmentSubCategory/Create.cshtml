@model Clinic.Application.DTOs.MasterData.TreatmentSubCategoryCreateDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
    var categories = ViewBag.Categories as IEnumerable<SelectListItem>;
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/TreatmentCategory" class="text-decoration-none">Treatment Categories</a></li>
            <li class="breadcrumb-item"><a href="/TreatmentSubCategory@(Model.CategoryId != Guid.Empty ? "?categoryId=" + Model.CategoryId : "")" class="text-decoration-none">SubCategories</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom border-light">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-plus-circle text-primary me-2"></i>Create Treatment SubCategory</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createForm" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3"></div>

                        <div class="row g-4">
                            <div class="col-md-12">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Treatment Category <span class="text-danger">*</span></label>
                                <select asp-for="CategoryId" asp-items="categories" class="form-select shadow-sm bg-light" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <div class="p-3 bg-light rounded-3 border border-light">
                                    <label class="form-label fw-semibold text-muted mb-0">SubCategory Code</label>
                                    <p class="mb-0 small text-muted"><i class="bi bi-info-circle me-1"></i>The SubCategory Code will be generated automatically upon saving based on the enterprise number sequence (TSC).</p>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="SubCategoryName" class="form-label fw-semibold">SubCategory Name <span class="text-danger">*</span></label>
                                <input asp-for="SubCategoryName" class="form-control shadow-sm bg-light" required />
                                <span asp-validation-for="SubCategoryName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control shadow-sm bg-light" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DisplayOrder" class="form-label fw-semibold">Display Order <span class="text-danger">*</span></label>
                                <input asp-for="DisplayOrder" type="number" class="form-control shadow-sm bg-light" required min="0" />
                                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end pb-1">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsActive" class="form-check-label ms-2 fw-semibold fs-6 mt-1">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-5 pt-3 border-top border-light">
                            <a href="/TreatmentSubCategory@(Model.CategoryId != Guid.Empty ? "?categoryId=" + Model.CategoryId : "")" class="btn btn-light shadow-sm">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-4">
                                <i class="bi bi-check-circle me-1"></i> Create SubCategory
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
