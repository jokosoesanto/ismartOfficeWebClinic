@model IEnumerable<Clinic.Application.DTOs.MasterData.TreatmentSubCategoryDto>
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
    var categoryId = ViewBag.CategoryId as Guid?;
    var categoryName = ViewBag.CategoryName as string;
}

<div class="container-fluid py-4">
    
    

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                Treatment SubCategories
                @if (!string.IsNullOrEmpty(categoryName))
                {
                    <span class="text-muted fs-4"> - @categoryName</span>
                }
            </h2>
            <p class="text-muted mb-0">Manage second-level clinical treatment classifications.</p>
        </div>
        <div>
            @if (categoryId.HasValue)
            {
                <a href="/TreatmentCategory" class="btn btn-outline-secondary shadow-sm me-2">
                    <i class="bi bi-arrow-left me-1"></i>Back to Categories
                </a>
            }
            <a href="/TreatmentSubCategory/Create@(categoryId.HasValue ? "?categoryId=" + categoryId : "")" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Create SubCategory
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-diagram-2 text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-semibold text-dark">No Treatment SubCategories Found</h5>
                    <p class="text-muted">Get started by creating your first enterprise treatment subcategory.</p>
                    <a href="/TreatmentSubCategory/Create@(categoryId.HasValue ? "?categoryId=" + categoryId : "")" class="btn btn-primary mt-2 shadow-sm">
                        <i class="bi bi-plus-lg me-2"></i>Create SubCategory
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex mb-3 align-items-center">
                    <label class="me-2 fw-semibold text-muted">Status Filter:</label>
                    <select id="statusFilter" class="form-select w-auto shadow-sm">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle enterprise-grid" id="subCategoriesTable"
                           data-order='[[ 3, "asc" ]]'
                           data-page-length="10"
                           data-search-placeholder="Search subcategories...">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Display Order</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in Model)
                            {
                                <tr>
                                    <td><span class="fw-bold font-monospace text-primary">@sub.SubCategoryCode</span></td>
                                    <td>
                                        <div class="fw-semibold">@sub.SubCategoryName</div>
                                        @if(!string.IsNullOrEmpty(sub.Description)){
                                            <div class="small text-muted">@sub.Description</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark">@sub.CategoryName</span>
                                    </td>
                                    <td>@sub.DisplayOrder</td>
                                    <td>
                                        @if(sub.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="/TreatmentSubCategory/Edit/@sub.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a href="/TreatmentCatalog?subCategoryId=@sub.Id" class="btn btn-sm btn-outline-info shadow-sm ms-1" title="Manage Treatments">
                                            <i class="bi bi-card-checklist"></i> Manage Treatments
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm ms-1" onclick="deleteSubCategory('@sub.Id', '@sub.SubCategoryName', '@categoryId')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function deleteSubCategory(id, name, returnCategoryId) {
            if (confirm(`Are you sure you want to delete subcategory '${name}'?`)) {
                var form = $('#deleteForm');
                var url = '/TreatmentSubCategory/Delete/' + id;
                if (returnCategoryId) {
                    url += '?returnCategoryId=' + returnCategoryId;
                }
                form.attr('action', url);
                form.submit();
            }
        }

        $(document).ready(function() {
            if (typeof $.fn.DataTable !== 'undefined') {
                while ($.fn.dataTable.ext.search.length > 0) {
                    $.fn.dataTable.ext.search.pop();
                }

                $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                    if (settings.nTable.id !== 'subCategoriesTable') {
                        return true;
                    }
                    var statusFilter = $('#statusFilter').val();
                    if (!statusFilter) return true;
                    
                    var status = data[4] || ""; // 5th column
                    return status.indexOf(statusFilter) !== -1;
                });

                $('#statusFilter').on('change', function() {
                    var table = $('#subCategoriesTable').DataTable();
                    table.draw();
                });
            }
        });
    </script>
}
