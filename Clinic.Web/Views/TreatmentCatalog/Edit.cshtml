@model Clinic.Application.DTOs.MasterData.TreatmentCatalogUpdateDto
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
    var categories = ViewBag.Categories as IEnumerable<SelectListItem>;
    var subCategories = ViewBag.SubCategories as IEnumerable<SelectListItem>;
    var serviceTypes = ViewBag.ServiceTypes as IEnumerable<SelectListItem>;
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/TreatmentCategory" class="text-decoration-none">Treatment Categories</a></li>
            <li class="breadcrumb-item"><a href="/TreatmentSubCategory@(Model.CategoryId != Guid.Empty ? "?categoryId=" + Model.CategoryId : "")" class="text-decoration-none">SubCategories</a></li>
            <li class="breadcrumb-item"><a href="/TreatmentCatalog@(Model.SubCategoryId != Guid.Empty ? "?subCategoryId=" + Model.SubCategoryId : "")" class="text-decoration-none">Treatments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom border-light">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Treatment</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3"></div>

                        <h6 class="fw-bold text-primary mb-3 mt-2 border-bottom pb-2">Classification</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <select asp-for="CategoryId" asp-items="categories" class="form-select shadow-sm bg-light" id="CategoryId" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SubCategoryId" class="form-label fw-semibold">SubCategory <span class="text-danger">*</span></label>
                                <select asp-for="SubCategoryId" asp-items="subCategories" class="form-select shadow-sm bg-light" id="SubCategoryId" required>
                                    <option value="">-- Select SubCategory --</option>
                                </select>
                                <span asp-validation-for="SubCategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ServiceTypeId" class="form-label fw-semibold">Service Type <span class="text-danger">*</span></label>
                                <select asp-for="ServiceTypeId" asp-items="serviceTypes" class="form-select shadow-sm bg-light" required>
                                    <option value="">-- Select Service Type --</option>
                                </select>
                                <span asp-validation-for="ServiceTypeId" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">Treatment Definition</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-12">
                                <label asp-for="TreatmentCode" class="form-label fw-semibold">Treatment Code</label>
                                <input asp-for="TreatmentCode" class="form-control shadow-sm bg-light text-muted" readonly />
                            </div>

                            <div class="col-md-12">
                                <label asp-for="TreatmentName" class="form-label fw-semibold">Treatment Name <span class="text-danger">*</span></label>
                                <input asp-for="TreatmentName" class="form-control shadow-sm bg-light" required />
                                <span asp-validation-for="TreatmentName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control shadow-sm bg-light" rows="2"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">Clinical Rules</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="RequiresTooth" class="form-check-input" type="checkbox" role="switch" id="RequiresTooth">
                                    <label asp-for="RequiresTooth" class="form-check-label ms-2 fw-semibold fs-6 mt-1">Requires Tooth Selection</label>
                                </div>
                            </div>
                            
                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="RequiresSurface" class="form-check-input" type="checkbox" role="switch" id="RequiresSurface">
                                    <label asp-for="RequiresSurface" class="form-check-label ms-2 fw-semibold fs-6 mt-1">Requires Surface Selection</label>
                                </div>
                            </div>
                        </div>

                        <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">Operational</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="DefaultPrice" class="form-label fw-semibold">Default Price <span class="text-danger">*</span></label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-light text-muted border-end-0">@ViewBag.CurrencySymbol</span>
                                    <input asp-for="DefaultPrice" type="number" step="0.01" class="form-control bg-light border-start-0" required min="0" />
                                </div>
                                <span asp-validation-for="DefaultPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DurationInMinutes" class="form-label fw-semibold">Duration (Minutes) <span class="text-danger">*</span></label>
                                <input asp-for="DurationInMinutes" type="number" class="form-control shadow-sm bg-light" required min="1" />
                                <span asp-validation-for="DurationInMinutes" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 d-flex align-items-end pb-1 mt-4">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsActive" class="form-check-label ms-2 fw-semibold fs-6 mt-1">Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-5 pt-3 border-top border-light">
                            <a href="/TreatmentCatalog@(Model.SubCategoryId != Guid.Empty ? "?subCategoryId=" + Model.SubCategoryId : "")" class="btn btn-light shadow-sm">Cancel</a>
                            <button type="submit" class="btn btn-primary shadow-sm px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            // Dynamic dropdown
            $('#CategoryId').change(function () {
                var categoryId = $(this).val();
                var subCategoryDropdown = $('#SubCategoryId');
                
                subCategoryDropdown.empty();
                subCategoryDropdown.append($('<option>').val('').text('-- Select SubCategory --'));
                
                if (categoryId) {
                    $.getJSON('/TreatmentCatalog/GetSubCategories', { categoryId: categoryId }, function (data) {
                        $.each(data, function (index, item) {
                            subCategoryDropdown.append($('<option>').val(item.value).text(item.text));
                        });
                    });
                }
            });

            // Clinical rules logic UI enforcement
            $('#RequiresSurface').change(function () {
                if ($(this).is(':checked')) {
                    $('#RequiresTooth').prop('checked', true);
                }
            });
            
            $('#RequiresTooth').change(function () {
                if (!$(this).is(':checked')) {
                    $('#RequiresSurface').prop('checked', false);
                }
            });
        });
    </script>
}
