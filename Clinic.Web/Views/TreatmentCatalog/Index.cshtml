@model IEnumerable<Clinic.Application.DTOs.MasterData.TreatmentCatalogDto>
@inject Clinic.Application.Interfaces.Configuration.ICurrencyService CurrencyService
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
    var subCategoryId = ViewBag.SubCategoryId as Guid?;
    var subCategoryName = ViewBag.SubCategoryName as string;
    var categoryId = ViewBag.CategoryId as Guid?;
    var categoryName = ViewBag.CategoryName as string;
}

<div class="container-fluid py-4">
    
    

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                Treatment Catalog
                @if (!string.IsNullOrEmpty(subCategoryName))
                {
                    <span class="text-muted fs-4"> - @subCategoryName</span>
                }
            </h2>
            <p class="text-muted mb-0">Manage clinical treatments and procedures.</p>
        </div>
        <div>
            @if (subCategoryId.HasValue)
            {
                <a href="/TreatmentSubCategory?categoryId=@categoryId" class="btn btn-outline-secondary shadow-sm me-2">
                    <i class="bi bi-arrow-left me-1"></i>Back to SubCategories
                </a>
            }
            <a href="/TreatmentCatalog/Create@(subCategoryId.HasValue ? $"?categoryId={categoryId}&subCategoryId={subCategoryId}" : "")" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Create Treatment
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-card-checklist text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-semibold text-dark">No Treatments Found</h5>
                    <p class="text-muted">Get started by creating your first treatment catalog record.</p>
                    <a href="/TreatmentCatalog/Create@(subCategoryId.HasValue ? $"?categoryId={categoryId}&subCategoryId={subCategoryId}" : "")" class="btn btn-primary mt-2 shadow-sm">
                        <i class="bi bi-plus-lg me-2"></i>Create Treatment
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex mb-3 align-items-center">
                    <label class="me-2 fw-semibold text-muted">Status Filter:</label>
                    <select id="statusFilter" class="form-select w-auto shadow-sm">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle enterprise-grid" id="treatmentsTable"
                           data-order='[[ 1, "asc" ]]'
                           data-page-length="10"
                           data-search-placeholder="Search treatments...">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Treatment Name</th>
                                <th>Category</th>
                                <th>SubCategory</th>
                                <th>Service Type</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Duration</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trt in Model)
                            {
                                <tr>
                                    <td><span class="fw-bold font-monospace text-primary">@trt.TreatmentCode</span></td>
                                    <td>
                                        <div class="fw-semibold">@trt.TreatmentName</div>
                                        @if(!string.IsNullOrEmpty(trt.Description)){
                                            <div class="small text-muted text-truncate" style="max-width:200px;" title="@trt.Description">@trt.Description</div>
                                        }
                                    </td>
                                    <td>@trt.CategoryName</td>
                                    <td>@trt.SubCategoryName</td>
                                    <td><span class="badge bg-light text-dark border">@trt.ServiceTypeName</span></td>
                                    <td class="text-end font-monospace">@(await CurrencyService.FormatAmountAsync(trt.DefaultPrice))</td>
                                    <td class="text-end">@trt.DurationInMinutes min</td>
                                    <td>
                                        @if(trt.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="/TreatmentCatalog/Edit/@trt.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger shadow-sm ms-1" onclick="deleteTreatment('@trt.Id', '@trt.TreatmentName', '@subCategoryId')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function deleteTreatment(id, name, returnSubCategoryId) {
            if (confirm(`Are you sure you want to delete treatment '${name}'?`)) {
                var form = $('#deleteForm');
                var url = '/TreatmentCatalog/Delete/' + id;
                if (returnSubCategoryId) {
                    url += '?returnSubCategoryId=' + returnSubCategoryId;
                }
                form.attr('action', url);
                form.submit();
            }
        }

        $(document).ready(function() {
            if (typeof $.fn.DataTable !== 'undefined') {
                while ($.fn.dataTable.ext.search.length > 0) {
                    $.fn.dataTable.ext.search.pop();
                }

                $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                    if (settings.nTable.id !== 'treatmentsTable') {
                        return true;
                    }
                    var statusFilter = $('#statusFilter').val();
                    if (!statusFilter) return true;
                    
                    var status = data[7] || ""; // 8th column
                    return status.indexOf(statusFilter) !== -1;
                });

                $('#statusFilter').on('change', function() {
                    var table = $('#treatmentsTable').DataTable();
                    table.draw();
                });
            }
        });
    </script>
}
