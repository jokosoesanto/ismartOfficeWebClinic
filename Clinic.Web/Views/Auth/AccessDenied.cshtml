@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="text-center">
        <h1 class="display-1 fw-bold text-danger"><i class="bi bi-shield-lock-fill"></i></h1>
        <h2 class="fw-bold mt-3">Access Denied</h2>
        <p class="lead text-muted mt-2">You do not have permission to access this page.</p>
        @if (ViewData["ReturnUrl"] != null)
        {
            <p class="text-muted small">Attempted URL: @ViewData["ReturnUrl"]</p>
        }
        
        <div class="mt-4">
            <a href="/" class="btn btn-primary px-4 me-2">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a href="mailto:support@clinic.local" class="btn btn-outline-secondary px-4">
                <i class="bi bi-envelope me-2"></i>Contact Administrator
            </a>
        </div>
    </div>
</div>
