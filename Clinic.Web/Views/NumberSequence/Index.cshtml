@model IEnumerable<Clinic.Web.Models.NumberSequenceViewModel>
@{
    ViewData["Title"] = "Number Sequences";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">Number Sequences Monitoring</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> This page is read-only. Number Sequences are managed by the system automatically.
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered enterprise-grid" id="sequenceTable"
                   data-order="[[0, &quot;asc&quot;]]">
                <thead class="table-light">
                    <tr>
                        <th>Sequence Code</th>
                        <th>Current Value</th>
                        <th>Reset Policy</th>
                        <th>Prefix</th>
                        <th>Date Pattern</th>
                        <th>Padding</th>
                        <th>Next Preview</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seq in Model)
                    {
                        <tr>
                            <td><span class="badge bg-primary">@seq.Code</span></td>
                            <td class="text-end font-monospace">@seq.CurrentValue</td>
                            <td>@seq.ResetPolicy</td>
                            <td>@seq.Prefix</td>
                            <td>@seq.DatePattern</td>
                            <td class="text-end">@seq.Padding</td>
                            <td><span class="badge bg-success font-monospace">@seq.NextPreview</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

