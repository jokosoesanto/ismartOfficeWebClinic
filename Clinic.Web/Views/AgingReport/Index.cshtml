@model Clinic.Web.Controllers.AgingReportViewModel
@inject Clinic.Application.Interfaces.Configuration.ICurrencyService CurrencyService
@{
    ViewData["Title"] = "Accounts Receivable Aging Report";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Accounts Receivable Aging Report</h3>
            <p class="text-muted">Overview of outstanding patient balances grouped by age (Days Overdue from Invoice Date).</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white mb-3">
                <div class="card-body">
                    <h6 class="card-title text-uppercase fw-bold"><i class="bi bi-cash-stack me-2"></i>Total Outstanding</h6>
                    <h3 class="fw-bold mb-0">@await CurrencyService.FormatAmountAsync(Model.TotalOutstanding)</h3>
                    <small>Across @Model.TotalInvoices Open Invoices</small>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase fw-bold text-muted mb-3"><i class="bi bi-pie-chart me-2"></i>Aging Summary</h6>
                    <div class="d-flex justify-content-between text-center mt-2">
                        <div>
                            <div class="fw-bold text-success mb-1">Current</div>
                            <div class="fs-5 fw-bold">@await CurrencyService.FormatAmountAsync(Model.CurrentTotal)</div>
                        </div>
                        <div class="border-start"></div>
                        <div>
                            <div class="fw-bold text-info mb-1">1-30 Days</div>
                            <div class="fs-5 fw-bold">@await CurrencyService.FormatAmountAsync(Model.Days1To30Total)</div>
                        </div>
                        <div class="border-start"></div>
                        <div>
                            <div class="fw-bold text-warning mb-1">31-60 Days</div>
                            <div class="fs-5 fw-bold">@await CurrencyService.FormatAmountAsync(Model.Days31To60Total)</div>
                        </div>
                        <div class="border-start"></div>
                        <div>
                            <div class="fw-bold text-danger mb-1">61-90 Days</div>
                            <div class="fs-5 fw-bold">@await CurrencyService.FormatAmountAsync(Model.Days61To90Total)</div>
                        </div>
                        <div class="border-start"></div>
                        <div>
                            <div class="fw-bold text-danger mb-1">> 90 Days</div>
                            <div class="fs-5 fw-bold">@await CurrencyService.FormatAmountAsync(Model.Over90DaysTotal)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-uppercase text-secondary mb-0">Outstanding Invoices</h5>
            <div class="input-group" style="width: 250px;">
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search invoice or patient..." />
                <span class="input-group-text"><i class="bi bi-search"></i></span>
            </div>
        </div>
        <div class="card-body">
            @if (Model.AgingDetails.Any())
            {
                <div class="table-responsive mt-3">
                    <table class="table table-hover table-striped align-middle" id="agingTable">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice #</th>
                                <th>Patient</th>
                                <th>Invoice Date</th>
                                <th class="text-center">Days Overdue</th>
                                <th>Aging Bucket</th>
                                <th class="text-end">Outstanding Balance</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AgingDetails)
                            {
                                string badgeClass = item.Bucket switch
                                {
                                    "Current" => "bg-success",
                                    "1-30 Days" => "bg-info text-dark",
                                    "31-60 Days" => "bg-warning text-dark",
                                    "61-90 Days" => "bg-danger",
                                    "Over 90 Days" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="fw-bold">@item.InvoiceNumber</td>
                                    <td>
                                        @if(item.PatientId.HasValue)
                                        {
                                            <a href="/MedicalRecord/Chart/@item.PatientId" class="text-decoration-none">@item.PatientName</a>
                                        }
                                        else
                                        {
                                            @item.PatientName
                                        }
                                    </td>
                                    <td>@item.InvoiceDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        <span class="fw-bold @(item.DaysOverdue > 0 ? "text-danger" : "text-success")">
                                            @item.DaysOverdue
                                        </span>
                                    </td>
                                    <td><span class="badge @badgeClass">@item.Bucket</span></td>
                                    <td class="text-end fw-bold text-danger">@await CurrencyService.FormatAmountAsync(item.OutstandingBalance)</td>
                                    <td class="text-end">
                                        @if(item.PatientId.HasValue)
                                        {
                                            <a href="/MedicalRecord/Chart/@item.PatientId#ledger" class="btn btn-sm btn-outline-primary" title="View Patient Ledger">
                                                <i class="bi bi-piggy-bank"></i> Ledger
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5" class="text-end">Total Outstanding:</td>
                                <td class="text-end text-danger fs-5">@await CurrencyService.FormatAmountAsync(Model.TotalOutstanding)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-success d-flex flex-column align-items-center justify-content-center py-5">
                    <i class="bi bi-check-circle display-4 text-success mb-3"></i>
                    <h5>No Outstanding Receivables</h5>
                    <p class="text-muted mb-0">All finalized invoices have been paid in full.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Basic client-side filtering for the report
        document.getElementById('searchInput').addEventListener('keyup', function() {
            var value = this.value.toLowerCase();
            var rows = document.querySelectorAll('#agingTable tbody tr');
            
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                if (text.includes(value)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}
