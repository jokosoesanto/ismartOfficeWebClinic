@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {
    
    // Auto-select is not needed as Selected values are now driven by the Selected property inside SelectListItem

    // UX Form Validation & Tab Switching
    var form = document.getElementById('patientForm');
    form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
            
            var firstInvalid = form.querySelector(':invalid');
            if (firstInvalid) {
                var tabPane = firstInvalid.closest('.tab-pane');
                if (tabPane) {
                    var tabId = tabPane.id;
                    var tabButton = document.querySelector('button[data-bs-target="#' + tabId + '"]');
                    if (tabButton) {
                        var bsTab = new bootstrap.Tab(tabButton);
                        bsTab.show();
                        setTimeout(function() { firstInvalid.focus(); }, 200);
                    }
                }
            }
        }
        form.classList.add('was-validated');
    }, false);
});

function previewImage(input) {
    if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
            var ph = document.getElementById('photoPlaceholder');
            if(ph) ph.classList.add('d-none');
            
            var img = document.getElementById('photoPreview');
            img.src = e.target.result;
            img.classList.remove('d-none');
        }
        reader.readAsDataURL(input.files[0]);
    }
}

function editInsurance(id, providerId, memberId, groupId, isPrimary) {
    document.getElementById('editInsId').value = id;
    document.getElementById('editInsProviderId').value = providerId;
    document.getElementById('editInsProviderIdHidden').value = providerId;
    document.getElementById('editInsMemberId').value = memberId || '';
    document.getElementById('editInsGroupId').value = groupId || '';
    document.getElementById('editIsPrimary').checked = isPrimary;
    
    var modal = new bootstrap.Modal(document.getElementById('editInsuranceModal'));
    modal.show();
}

function editGuarantor(id, name, relationship, phone, email, address, isPrimary) {
    document.getElementById('editGuarantorId').value = id;
    document.getElementById('editGuarantorName').value = name || '';
    document.getElementById('editGuarantorRelationship').value = relationship || '';
    document.getElementById('editGuarantorPhone').value = phone || '';
    document.getElementById('editGuarantorEmail').value = email || '';
    document.getElementById('editGuarantorAddress').value = address || '';
    document.getElementById('editGuarantorIsPrimary').checked = isPrimary;
    
    var modal = new bootstrap.Modal(document.getElementById('editGuarantorModal'));
    modal.show();
}
</script>
}
