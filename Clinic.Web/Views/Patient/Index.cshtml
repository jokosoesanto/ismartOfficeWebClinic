@model IEnumerable<Clinic.Domain.Entities.MasterData.Patient>
@{
    var meta = ViewBag.Meta as Clinic.Application.UI.UIMetadata;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Patient Management</h2>
            <p class="text-muted mb-0">Manage patient master data for all clinic branches.</p>
        </div>
        <a href="/Patient/Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Register Patient
        </a>
    </div>



    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle enterprise-grid" id="patientsTable"
                       data-order="[]"
                       data-page-length="10"
                       data-search-placeholder="Search patients...">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">Photo</th>
                            <th>MRN</th>
                            <th>Full Name</th>
                            <th>Gender / DOB</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    @if(p.PhotoFileMetadataId.HasValue)
                                    {
                                        <img src="/Patient/Thumbnail/@p.PhotoFileMetadataId" alt="Photo" class="rounded-circle object-fit-cover shadow-sm" width="40" height="40" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-secondary border shadow-sm" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                    }
                                </td>
                                <td><span class="fw-bold font-monospace text-primary">@p.MRN</span></td>
                                <td>
                                    <div class="fw-semibold">@p.FullName</div>
                                    @if(!string.IsNullOrEmpty(p.NationalId))
                                    {
                                        <div class="small text-muted"><i class="bi bi-card-text me-1"></i>@p.NationalId</div>
                                    }
                                </td>
                                <td>
                                    <div>@(p.Gender ?? "-")</div>
                                    <div class="small text-muted">@(p.BirthDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(p.Mobile))
                                    {
                                        <div><i class="bi bi-telephone text-muted me-1"></i> @p.Mobile</div>
                                    }
                                </td>
                                <td>
                                    @if(p.Status == "Active")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">Active</span>
                                    }
                                    else if(p.Status == "Inactive")
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill">Inactive</span>
                                    }
                                    else if(!string.IsNullOrEmpty(p.Status))
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 rounded-pill">@p.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Patient/Edit/@p.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if(p.Status == "Inactive")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success shadow-sm ms-1" onclick="reactivatePatient('@p.Id', '@p.FullName')" title="Reactivate">
                                            <i class="bi bi-toggle-off"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary shadow-sm ms-1" onclick="inactivatePatient('@p.Id', '@p.FullName')" title="Inactivate">
                                            <i class="bi bi-toggle-on"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<form id="statusForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    function inactivatePatient(id, name) {
        if(confirm('Are you sure you want to inactivate patient: ' + name + '?')) {
            var form = document.getElementById('statusForm');
            form.action = '/Patient/Inactivate/' + id;
            form.submit();
        }
    }

    function reactivatePatient(id, name) {
        if(confirm('Are you sure you want to reactivate patient: ' + name + '?')) {
            var form = document.getElementById('statusForm');
            form.action = '/Patient/Reactivate/' + id;
            form.submit();
        }
    }
</script>
}

